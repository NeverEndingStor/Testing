    function chebyshev(x1, y1, x2, y2) {
        return Math.max(Math.abs(x1 - x2), Math.abs(y1 - y2));
    }

    function cleanName(str) {
        if (!str) return '';
        return str.replace(/\[\d+\]/g, '').replace(/\(.*?\)/g, '').trim().toLowerCase();
    }

    function myNick() {
        try { return Engine && Engine.hero ? Engine.hero.d.nick.toLowerCase() : ''; } catch(e) { return ''; }
    }


    let _lastNativeTimerSync = 0;
    let _nativeTimerStorageKey = null;
    let _nativeSyncFeedAt = 0;

    function _findNativeTimerStorage() {
        try {
            if (!Engine || !Engine.serverStorage || typeof Engine.serverStorage.get !== 'function') return null;
            const all = Engine.serverStorage.get();
            if (!all || typeof all !== 'object') return null;

            if (_nativeTimerStorageKey && all[_nativeTimerStorageKey] && Array.isArray(all[_nativeTimerStorageKey].data)) {
                return { key: _nativeTimerStorageKey, storage: all[_nativeTimerStorageKey] };
            }

            for (const [key, value] of Object.entries(all)) {
                if (!value || typeof value !== 'object' || !Array.isArray(value.data)) continue;
                const looksLikeTimer = value.data.some(t => t && typeof t === 'object' &&
                    Number(t.type) === 2 && t.name && Number.isFinite(Number(t.minResp)) && Number.isFinite(Number(t.presp)));
                if (looksLikeTimer) {
                    _nativeTimerStorageKey = key;
                    return { key, storage: value };
                }
            }
        } catch(e) {}
        return null;
    }

    function _nativeTimerToE2Key(timer) {
        const allE2 = window._uiCacheData.e2 || [];
        const timerName = cleanName(timer && timer.name);
        if (!timerName) return null;
        const found = allE2.find(e => cleanName(e.name) === timerName || timerName.includes(cleanName(e.name)) || cleanName(e.name).includes(timerName));
        return found ? found.key : null;
    }

    function syncNativeE2Timers(force = false) {
        const nowMs = Date.now();
        if (!force && nowMs - _lastNativeTimerSync < NATIVE_TIMER_SYNC_MS) return 0;
        _lastNativeTimerSync = nowMs;

        try {
            if (!Engine || !Engine.hero) return 0;
            const found = _findNativeTimerStorage();
            if (!found) return 0;
            const charId = Number(Engine.hero.d.id);
            const now = Math.floor(nowMs / 1000);
            const worldData = getWorldData();
            let changed = 0;

            for (const timer of found.storage.data) {
                if (!timer || Number(timer.type) !== 2) continue;
                if (Number(timer.char) !== charId) continue;
                const minResp = Number(timer.minResp);
                const maxResp = Number(timer.presp);
                if (!Number.isFinite(minResp) || !Number.isFinite(maxResp)) continue;
                if (maxResp < now - 5) continue;
                const key = _nativeTimerToE2Key(timer);
                if (!key) continue;

                const prev = worldData[key];
                if (!prev || prev.minResp !== minResp || prev.maxResp !== maxResp || prev.source !== 'native') {
                    worldData[key] = {
                        killedAt: prev && prev.killedAt ? prev.killedAt : now,
                        minResp,
                        maxResp,
                        source: 'native',
                        nativeId: timer.id,
                        char: Number(timer.char),
                        map: timer.map,
                        x: timer.x,
                        y: timer.y
                    };
                    changed++;
                }
            }

            if (changed) {
                setWorldData(worldData);
                if (nowMs - _nativeSyncFeedAt > 1500) {
                    _nativeSyncFeedAt = nowMs;
                    _pushFeed(`⏱️ Minutnik: zsynchronizowano ${changed} E2`, '#2ecc71');
                }
            }
            return changed;
        } catch(e) { return 0; }
    }

    function getNativeE2TimerByName(name) {
        try {
            const found = _findNativeTimerStorage();
            if (!found || !Engine || !Engine.hero) return null;
            const charId = Number(Engine.hero.d.id);
            const wanted = cleanName(name);
            return found.storage.data.find(t => t && Number(t.type) === 2 && Number(t.char) === charId && cleanName(t.name) === wanted && Number(t.minResp) && Number(t.presp)) || null;
        } catch(e) { return null; }
    }

    async function waitForNativeE2Timer(target, timeoutMs = NATIVE_TIMER_WAIT_MS) {
        const started = Date.now();
        while (Date.now() - started < timeoutMs) {
            syncNativeE2Timers(true);
            const native = getNativeE2TimerByName(target && target.name);
            if (native) return native;
