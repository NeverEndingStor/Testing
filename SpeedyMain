            if (Number.isFinite(n)) return n > 1 ? n / 100 : n;
        }
        return 0.10;
    }
    function observeExpNpcDeletion(cached, respBaseOverride, reason) {
        try {
            if (!cached || !_expWaitCombat || Date.now() - _expWaitCombat.at > EXP_WAIT_COMBAT_TTL_MS) return;
            const gui = window._uiCacheData.gui;
            const config = gui?.getSettings ? gui.getSettings() : null;
            if (!config?.expWaitingRoom) return;
            const st = _expWaitLoad();
            if (!st || st.armed || st.setupName !== config.activeSetup) return;
            if (Number(st.anchorMapId) !== Number(_expWaitCombat.mapId)) return;
            const sameId = String(cached.id) === _expWaitCombat.id;
            const sameGrp = _expWaitCombat.grp && cached.grp != null && String(cached.grp) === _expWaitCombat.grp;
            if (!sameId && !sameGrp) return;

            const base = Number(respBaseOverride || cached.respBaseSeconds || 0);
            if (!Number.isFinite(base) || base <= 0) {
                if (gui?.updateStatus) gui.updateStatus('Poczekalnia EXP: brak natywnego czasu resp – nie wylogowuję', '#e67e22');
                return;
            }
            const rand = Math.max(0, Math.min(0.90, _expWaitRespRand(cached)));
            const now = Math.floor(Date.now() / 1000);
            const minSec = Math.max(1, Math.round(base * (1 - rand)));
            const maxSec = Math.max(minSec, Math.round(base * (1 + rand)));
            st.armed = true;
            st.firstKillAt = now;
            st.firstMobId = String(cached.id || _expWaitCombat.id);
            st.firstGroupId = cached.grp != null ? String(cached.grp) : _expWaitCombat.grp;
            st.firstMobName = cached.nick || _expWaitCombat.nick;
            st.respBaseSeconds = base;
            st.respRand = rand;
            st.minResp = now + minSec;
            st.maxResp = now + maxSec;
            st.wakeAt = st.maxResp + EXP_WAIT_RETURN_PAD_SEC;
            st.visited = [Number(st.anchorMapId)];
            st.cycleLeftAnchor = false;
            st.respSource = reason || 'npc-packet';
            st.updatedAt = Date.now();
            _expWaitSave(st);
            _expWaitCombat = null;
            if (gui?.updateStatus) {
                const mins = Math.ceil(maxSec / 60);
                gui.updateStatus(`Poczekalnia EXP uzbrojona: pewny resp ~${mins} min`, '#9b59b6');
            }
        } catch (_) {}
    }
    function _expWaitAllMapsVisited(st, setupMaps) {
        const visited = new Set((st?.visited || []).map(Number));
