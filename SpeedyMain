                    if (window._uiCacheData.gui) window._uiCacheData.gui.updateStatus('⏳ Wyczerpanie – oczekuję na odnowienie...', '#e67e22');
                    await delay(randDelay(5000));
                }
                return;

            } else if (_exhaustionAfkMode) {
                _exhaustionAfkMode = false;
                _lastClanExhaustionTry = 0;
                if (window._uiCacheData.gui) window._uiCacheData.gui.updateStatus('✅ Wyczerpanie odnowione – wracam na exp!', '#27ae60');
            }
        }

        const setupMaps = (config.activeSetup && config.setups[config.activeSetup]) ? config.setups[config.activeSetup].map(m => parseInt(m.id || m)) : [];
        if (config.expWaitingRoom) {
            _expWaitEnsureAnchor(config, setupMaps, currentMapId);
            _expWaitMarkVisit(config, setupMaps, currentMapId);
        } else if (_expWaitLoad()) {
            _expWaitReset(config, false);
        }
        if (!config.e2Enabled && setupMaps.length > 0 && !setupMaps.includes(currentMapId)) {
            const sellFn   = window._uiCacheData.sell;
            const hasFn    = window._uiCacheData.hasItemsToSell;
            const bagFull  = typeof window._uiCacheData.isBagFull === 'function' && window._uiCacheData.isBagFull();
            const hasJunk  = typeof hasFn === 'function' && hasFn(config);

            if (typeof sellFn === 'function' && (bagFull || hasJunk) && !window._uiCacheData._auctionRunning) {
                const VENDOR_DATA = window._uiCacheData.vendors || {};
                let vendorOnCurrentMap = false;
                if (config.autoVendorSelect) {
                    for (const key in VENDOR_DATA) {
                        const v = VENDOR_DATA[key];
                        if (v.type && v.type.includes("merchant") && parseInt(v.map_id) === currentMapId) { vendorOnCurrentMap = true; break; }
                    }
                } else {
                    const vKey = config.forcedVendorKey || "roan_ithan";
                    const v = VENDOR_DATA[vKey];
                    if (v && parseInt(v.map_id) === currentMapId) vendorOnCurrentMap = true;
                }

                if (vendorOnCurrentMap) {
                    if(window._uiCacheData.gui) window._uiCacheData.gui.updateStatus('Sprzedaż przy okazji (kupiec na mapie)...', '#e67e22');
                    const didSell = await sellFn(config, findPathBFS, walkSmoothly, getNextHopMap, () => false, setMapCooldown, true);
                    if (didSell) { await delay(randDelay(500)); return; }
                } else if (bagFull) {
                    if(window._uiCacheData.gui) window._uiCacheData.gui.updateStatus('Plecak pełny – sprzedaż awaryjna...', '#e74c3c');
                    const didSell = await sellFn(config, findPathBFS, walkSmoothly, getNextHopMap, () => false, setMapCooldown, true);
                    if (didSell) { await delay(randDelay(500)); return; }
                }
            }

            await handleMapTransition(config, setMapCooldown);
            return;
        }

        if (config.e2Enabled) {
            const autoe2   = window._uiCacheData.autoe2;
            const hasQueue = config.e2Queue && config.e2Queue.length > 0;

            if (hasQueue) {
                if (autoe2 && autoe2.getQueueStatus) {
                    const status = autoe2.getQueueStatus();
                    if (window._uiCacheData.gui) window._uiCacheData.gui.updateStatus('E2: ' + status, '#c9a465');
                } else {
                    if (window._uiCacheData.gui) window._uiCacheData.gui.updateStatus('E2 – ładowanie modułu...', '#888');
                }
                await delay(randDelay(1500));
                return;
            }

            const targetE2Data = window._uiCacheData.e2
                ? window._uiCacheData.e2.find(e => e.key === config.elite2Key)
                : null;
            if (!targetE2Data) {
                if(window._uiCacheData.gui) window._uiCacheData.gui.updateStatus('E2 – brak celu (ustaw E2 w trybie klasycznym lub dodaj do kolejki)', '#e06c75');
                await delay(randDelay(2000));
                return;
            }

            const targetMapId = parseInt(targetE2Data.map_id);
            if (currentMapId !== targetMapId) {
                if(window._uiCacheData.gui) window._uiCacheData.gui.updateStatus(`E2 \u2013 Podróż na mapę: ${targetE2Data.map_name}`, "#9b59b6");
                await handleMapTransition(config, setMapCooldown, targetMapId);
                return;
            }

            let foundE2 = null;
            const npcs = typeof Engine.npcs.check === 'function' ? Engine.npcs.check() : Engine.npcs.d;
            const targetName = targetE2Data.name.toLowerCase();
            const fightingMobs = getFightingMobIds();

            for (let k in npcs) {
                let npc = npcs[k].d || npcs[k];
                if (!npc || npc.dead || npc.hp === 0 || npc.st === 1 || npc.st === 2) continue;
                if (fightingMobs.has(npc.id) || fightingMobs.has(String(npc.id))) continue;

                if (npc.type === 2 || npc.type === 3) {
                    if (targetName && (npc.nick || npc.name || '').toLowerCase().includes(targetName)) {
                        foundE2 = npc; break;
                    } else if (!targetName && npc.wt > 19) {
                        foundE2 = npc; break;
                    }
                }
            }

            if (foundE2) {
                if(window._uiCacheData.gui) window._uiCacheData.gui.updateStatus(`E2 \u2013 Bieg do: ${foundE2.nick || foundE2.name}!`, "#e74c3c");

                if (Math.max(Math.abs(Engine.hero.d.x - foundE2.x), Math.abs(Engine.hero.d.y - foundE2.y)) > 1) {
                     // Szukamy ścieżki obok moba (true na końcu)
                     const p = findPathBFS(Engine.hero.d.x, Engine.hero.d.y, foundE2.x, foundE2.y, 400, true);
                     if (p && p.length > 0) {
                         const reached = await walkSmoothly(p, foundE2.id);
                         if (!reached) return;
                     }
                }

                if (Math.max(Math.abs(Engine.hero.d.x - foundE2.x), Math.abs(Engine.hero.d.y - foundE2.y)) <= 1) {
                    attackedAt[foundE2.id] = Date.now();
                    lastAttackedTarget = { id: foundE2.id, grp: foundE2.grp || null, mapId: currentMapId };
                    if (typeof window._uiCacheData._statsWalkiInc === 'function') window._uiCacheData._statsWalkiInc();
                    Engine.hero.heroAtackRequest(foundE2.id, !0);
                    await delay(100);
                }
            } else {
                const heroX = Engine.hero.d.x;
                const heroY = Engine.hero.d.y;
                const dist = Math.sqrt(Math.pow(heroX - targetE2Data.spawn_x, 2) + Math.pow(heroY - targetE2Data.spawn_y, 2));

                if (dist > 5) {
                    if(window._uiCacheData.gui) window._uiCacheData.gui.updateStatus("E2 \u2013 Biegne na miejsce respu...", "#3498db");
                    const path = findPathBFS(heroX, heroY, targetE2Data.spawn_x, targetE2Data.spawn_y, 400);
                    if (path && path.length > 0) await walkSmoothly(path, null, () => false);
                    else await delay(randDelay(1000));
                } else {
                    if(window._uiCacheData.gui) window._uiCacheData.gui.updateStatus("E2 \u2013 Oczekiwanie na spawn...", "#9b59b6");
                    await delay(randDelay(1000));
                }
            }
            return;
        }

        if (config.autoClanBlessing && config.clanBlessingKey && !Engine.hero.d.is_blessed) {
            const now = Date.now();
            if (!window._lastClanBlessingTry || now - window._lastClanBlessingTry > 60000) {
                window._lastClanBlessingTry = now;
                if(window._uiCacheData.gui) window._uiCacheData.gui.updateStatus(`Klan: Aktywacja błogo...`, "#9b59b6");

                window._g(`clan&a=skills_use&name=blessing&opt=${config.clanBlessingKey}&ans=1`);
                await delay(randDelay(800));

                try { if (Engine.clan) Engine.clan.close(); } catch(e){}
                const alertBtns = document.querySelectorAll('.mAlert .button, .mAlert .alert-accept-hotkey, .mAlert .close-button');
                if (alertBtns && alertBtns.length > 0) try { alertBtns[0].click(); } catch(e){}

                await delay(randDelay(1000));
                return;
            }
        }

        if (config.autoBlessing && config.autoBlessing.trim() !== "" && !Engine.hero.d.is_blessed) {
            const items = typeof Engine.heroEquipment.getHItems === 'function' ? Engine.heroEquipment.getHItems() : {};
            const blessLower = config.autoBlessing.toLowerCase().trim();
            let usedBless = false;

            for (const key in items) {
                const item = items[key];
                if (!item) continue;
                const st = item.st !== undefined ? item.st : (item.d && item.d.st);
                if (st > 0 && st < 20) continue;

                const name = (item.name || (item.getName && item.getName()) || (item.d && item.d.name) || '').toLowerCase();
                if (name === blessLower || name.includes(blessLower)) {
                    const stats = item._cachedStats || {};
                    if (stats.expires) {
                        const now = Date.now() / 1000;
                        if (now >= parseInt(stats.expires)) continue;
                    }
                    if(window._uiCacheData.gui) window._uiCacheData.gui.updateStatus(`Aktywacja Błogo...`, "#9b59b6");
                    try {
                        if (typeof Engine.heroEquipment.sendUseRequest === 'function') Engine.heroEquipment.sendUseRequest(item);
                        else if (typeof item.createUseItem === 'function') item.createUseItem();
                        else window._g('moveitem&st=1&id=' + (item.id || item.d.id));
                        usedBless = true;
                    } catch(e) {}
                    break;
                }
            }
            if (usedBless) { await delay(randDelay(800)); return; }
        }

        if(window._uiCacheData.gui) window._uiCacheData.gui.updateStatus(`Skanowanie strefy...`, "#3498db");
        let { target, path } = findAbsoluteBestTarget(config);

        if (target) {
            if (config.expSmartAggro !== false) {
                // Smart aggro działa WYŁĄCZNIE w module EXP.
                // Zawsze kończymy na kratce ortogonalnej (góra/dół/lewo/prawo),
                // więc mob stojący po skosie za kolizjami nie dostaje błędnych requestów ataku.
                await smartAttackExpTarget(target, config, currentMapId);
            } else {
                // Legacy EXP – zachowanie sprzed Smart aggro.
                const distToTarget = Math.max(Math.abs(Engine.hero.d.x - target.x), Math.abs(Engine.hero.d.y - target.y));

                if (distToTarget <= 1) {
                    if(window._uiCacheData.gui) window._uiCacheData.gui.updateStatus(`Atak: ${target.nick}`, "#e74c3c");
                    markExpTargetAttack(target, currentMapId);
                    Engine.hero.heroAtackRequest(target.id, !0);
                    await delay(randDelay(80, 0.90, 1.10));
                } else {
                    if(window._uiCacheData.gui) window._uiCacheData.gui.updateStatus(`Cel: ${target.nick}`, "#1abc9c");

                    const scannerCallback = (remainingSteps) => {
                        let newCheck = findAbsoluteBestTarget(config);
                        if (newCheck.target && newCheck.target.id !== target.id) {
                            if (newCheck.path && newCheck.path.length + 5 < remainingSteps) return true;
                        }
                        if (!newCheck.target && remainingSteps > 3) return true;
                        return false;
                    };

                    const walkedFully = await walkSmoothly(path, target.id, scannerCallback);
                    if (walkedFully) {
                        const finalDist = Math.max(Math.abs(Engine.hero.d.x - target.x), Math.abs(Engine.hero.d.y - target.y));
                        if (finalDist <= 1 && (!Engine.battle || !Engine.battle.getShow())) {
                            markExpTargetAttack(target, currentMapId);
                            Engine.hero.heroAtackRequest(target.id, !0);
                            await delay(randDelay(80, 0.90, 1.10));
                        }
                    }
                }
            }
        } else {
            if (await maybeEnterExpWaitingRoom(config, setupMaps, currentMapId)) return;
            await handleMapTransition(config, setMapCooldown);
        }
    }

    window._uiCacheData.exp = {
        findPathBFS,
        walkSmoothly,
        getNextHopMap,
        getAllMapTransitions,
        processNpcGateway,
        checkGatewayReachability,
        findBestReachableTransitionToward,
        markDynamicEdgeBlocked,
        isDynamicEdgeBlocked,
        isCaptchaActive,
        releaseKey,
        handleAutoExp,
        handleMapTransition,
        syncGameMobAggro,
        invalidateTargetCache: invalidateExpTargetCache,
        observeNpcDeletion: observeExpNpcDeletion,
        waitingRoomState: () => _expWaitLoad(),
        resetWaitingRoom: () => _expWaitReset(window._uiCacheData.gui?.getSettings?.() || {}, false)
    };

})();
