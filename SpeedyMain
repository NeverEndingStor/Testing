        // ── Ulepszanie: drop-zone ────────────────────────────────────────────
        // Przeciągnięcie itemu z plecaka gry na pole oznacza go jako item do ulepszania.
        // Trzy NIEZALEŻNE ścieżki (jeśli jedna zawiedzie, działają pozostałe):
        //   1) jQuery UI droppable (rejestrowane, gdy $.fn.droppable pojawi się na stronie),
        //   2) śledzenie myszy: mousedown na .item -> mouseup nad polem,
        //   3) natywny HTML5 drag&drop (tekst / JSON z ID).
        const self = this;
        let _upgDropJustHappened = false;
        const _upgMarkDrop = () => {
            _upgDropJustHappened = true;
            setTimeout(function () { _upgDropJustHappened = false; }, 2000);
        };

        const _upgAlertObserver = new MutationObserver(function(mutations) {
            if (!_upgDropJustHappened) return;
            for (const mutation of mutations) {
                for (const node of mutation.addedNodes) {
                    if (!node.querySelector) continue;
                    const cancelBtn = node.querySelector('.alert-cancel-hotkey') ||
                                      node.querySelector('.mAlert .button:last-child') ||
                                      Array.from(node.querySelectorAll('.mAlert .button, .button'))
                                           .find(b => b.innerText && (b.innerText.includes('Nic') || b.innerText.includes('Esc')));
                    if (cancelBtn) {
                        _upgDropJustHappened = false;
                        cancelBtn.click();
                        return;
                    }
                    if (node.classList && node.classList.contains('mAlert')) {
                        const btn = node.querySelector('.alert-cancel-hotkey') ||
                                    Array.from(node.querySelectorAll('.button'))
                                         .find(b => b.innerText && (b.innerText.includes('Nic') || b.innerText.includes('Esc')));
                        if (btn) { _upgDropJustHappened = false; btn.click(); return; }
                    }
                }
            }
        });
        _upgAlertObserver.observe(document.body, { childList: true, subtree: true });

        const _upgDz  = document.getElementById('upg-dropzone');
        const _upgJq  = () => window.jQuery || window.$;
        let _upgLastWarn = 0;
        const _upgNotify = (msg, color) => {
            try { if (typeof self.updateStatus === 'function') self.updateStatus(msg, color || '#e5c07b'); } catch (_) {}
        };

        // Znajdź obiekt itemu w silniku gry (po ID).
        const _upgLookupItem = (id) => {
            try {
                if (typeof Engine === 'undefined') return null;
                const n = Number(id);
                const key = Number.isFinite(n) ? n : id;
                if (Engine.items && typeof Engine.items.getItemById === 'function') {
                    const it = Engine.items.getItemById(key);
                    if (it) return it;
                }
                if (Engine.heroEquipment && typeof Engine.heroEquipment.getHItems === 'function') {
                    const all = Engine.heroEquipment.getHItems() || {};
                    if (all[key]) return all[key];
                }
            } catch (_) {}
            return null;
        };

        // ID itemu z samego elementu DOM (klasa item-id-123 / itemid-123, id="item123", data-id).
        const _upgIdFromNode = (node) => {
            const cls = (typeof node.className === 'string') ? node.className : '';
            let m = cls.match(/item[-_]?id[-_]?(\d+)/i);
            if (m) return m[1];
            m = String(node.id || '').match(/^item[-_]?(\d+)$/i);
            if (m) return m[1];
            const ds = node.dataset || {};
            for (const k of ['itemId', 'itemid', 'oid', 'id']) {
                if (ds[k] && /^\d+$/.test(ds[k])) return ds[k];
            }
            return null;
        };

        // Z listy elementów (draggable, helper, źródło) wyłuskaj item: { id, item }.
        const _upgResolveItem = (els) => {
            const $ = _upgJq();
            for (const raw of els) {
                let node = raw && raw.jquery ? raw[0] : raw;
                if (!node || node.nodeType !== 1) continue;
                node = (node.closest && node.closest('.item')) || node;
                if ($) {
                    try {
                        const d = $(node).data('item');
                        if (d && d.id != null) return { id: d.id, item: d };
                    } catch (_) {}
                }
                const id = _upgIdFromNode(node);
                if (id != null) {
                    const it = _upgLookupItem(id);
                    return { id: (it && it.id != null) ? it.id : Number(id), item: it };
                }
            }
            return null;
        };

        const _upgApplyDropped = (res) => {
            if (!res) {
                if (Date.now() - _upgLastWarn > 1500) {
                    _upgLastWarn = Date.now();
                    _upgNotify('Ulepszanie: nie rozpoznano przedmiotu – przeciągnij item z plecaka.', '#e06c75');
                }
                return false;
            }
            const it = res.item;
            if (!it && typeof Engine !== 'undefined' && Engine.items) {
                if (Date.now() - _upgLastWarn > 1500) {
                    _upgLastWarn = Date.now();
                    _upgNotify('Ulepszanie: nie znaleziono tego przedmiotu w grze.', '#e06c75');
                }
                return false;
            }
            let name = 'Nieznany przedmiot', lvl = 0, cl = '';
            if (it) {
                try { name = it.name || (typeof it.getName === 'function' && it.getName()) || (it.d && it.d.name) || name; } catch (_) {}
                try { lvl = (typeof it.getEnhancementUpgradeLvl === 'function' ? it.getEnhancementUpgradeLvl() : 0) || 0; } catch (_) {}
                cl = (it.cl != null ? it.cl : (it.d && it.d.cl != null ? it.d.cl : '')) || '';
            }
            const numId = Number(res.id);
            self.settings.upgradeItemId     = Number.isFinite(numId) ? numId : res.id;
            self.settings.upgradeItemName   = name;
            self.settings.upgradeItemUpgLvl = lvl;
            self.settings.upgradeItemSlot   = cl;
            self.applyUpgradeItemPreview();
            self.saveSettings();
            _upgNotify('Ulepszanie: wybrano „' + name + '"', '#98c379');
            return true;
        };

        // (1) jQuery UI droppable – rejestrujemy, gdy tylko plugin jest dostępny
        const _upgRegisterDroppable = () => {
            const $ = _upgJq();
            if (!_upgDz || !$ || !$.fn || typeof $.fn.droppable !== 'function') return false;
            if (_upgDz.getAttribute('data-upg-droppable') === '1') return true;
            try {
                $(_upgDz).droppable({
                    tolerance: 'pointer',
                    accept: function () { return true; },
                    over: function () { _upgDz.classList.add('drag-over'); },
                    out:  function () { _upgDz.classList.remove('drag-over'); },
                    drop: function (event, ui) {
                        _upgDz.classList.remove('drag-over');
                        _upgMarkDrop();
                        _upgApplyDropped(_upgResolveItem([ui && ui.draggable, ui && ui.helper]));
                    }
                });
                _upgDz.setAttribute('data-upg-droppable', '1');
                return true;
            } catch (e) {
                console.warn('[Speedy] droppable init failed:', e);
                return false;
            }
        };
        if (_upgDz && !_upgRegisterDroppable()) {
            let _n = 0;
            const _iv = setInterval(() => { if (_upgRegisterDroppable() || ++_n > 120) clearInterval(_iv); }, 500);
        }

        // (2) śledzenie myszy – działa nawet gdy droppable nie zadziała (np. brak jQuery UI)
        let _upgDragSrc = null, _upgDragStart = null;
        document.addEventListener('mousedown', function (e) {
            if (e.button !== 0) return;
            _upgDragSrc   = (e.target && e.target.closest) ? e.target.closest('.item') : null;
            _upgDragStart = { x: e.clientX, y: e.clientY };
        }, true);
        // Wspólne zakończenie przeciągania (mouseup – jQuery UI / ręczne; dragend – natywne HTML5 bez danych)
        const _upgFinishDrag = (x, y) => {
            const src = _upgDragSrc, st = _upgDragStart;
            _upgDragSrc = null; _upgDragStart = null;
            if (!src || !st || !_upgDz) return;
            if (self.container && self.container.classList.contains('minimized')) return;
            if (Math.abs(x - st.x) + Math.abs(y - st.y) < 12) return;                    // to było kliknięcie, nie przeciąganie
            const r = _upgDz.getBoundingClientRect();
            if (r.width === 0 || r.height === 0) return;                                  // zakładka ukryta
            if (x < r.left || x > r.right || y < r.top || y > r.bottom) return;
            _upgMarkDrop();
            _upgApplyDropped(_upgResolveItem([src, document.querySelector('.ui-draggable-dragging')]));
        };
        document.addEventListener('mouseup', function (e) { _upgFinishDrag(e.clientX, e.clientY); }, true);
        document.addEventListener('dragend', function (e) { _upgFinishDrag(e.clientX, e.clientY); }, true);

        // (3) natywny HTML5 drag&drop
        if (_upgDz) {
            _upgDz.addEventListener('dragover',  (e) => { e.preventDefault(); _upgDz.classList.add('drag-over'); });
            _upgDz.addEventListener('dragleave', ()  => { _upgDz.classList.remove('drag-over'); });
            _upgDz.addEventListener('drop', (e) => {
                e.preventDefault(); _upgDz.classList.remove('drag-over');
                _upgMarkDrop();
                const raw = (e.dataTransfer && (e.dataTransfer.getData('text/plain') || e.dataTransfer.getData('text'))) || '';
                let id = null;
                if (raw) {
                    try {
                        const p = JSON.parse(raw);
                        id = p.id || p.item_id || p.oid || null;
                    } catch (_) { id = String(raw).trim(); }
                }
                // Przy natywnym drag&drop mouseup nie powstaje – źródło pamiętamy z mousedown
                const src = _upgDragSrc;
                _upgDragSrc = null; _upgDragStart = null;
                if (id != null && /^\d+$/.test(String(id))) _upgApplyDropped({ id: id, item: _upgLookupItem(id) });
                else _upgApplyDropped(_upgResolveItem([src]));
            });
        }

        const upgClearBtn = document.getElementById('upg-clear-btn');
        if (upgClearBtn) {
            upgClearBtn.addEventListener('click', () => {
                this.settings.upgradeItemId     = null;
                this.settings.upgradeItemName   = '';
                this.settings.upgradeItemUpgLvl = 0;
                this.settings.upgradeItemSlot   = '';
                this.applyUpgradeItemPreview();
                this.saveSettings();
            });
        }

        // ── Aukcje – toggle'e i inputy ───────────────────────────────────────
        const auctToggle = (id, key) => {
            const el = document.getElementById(id); if (!el) return;
            el.addEventListener('click', () => {
                this.settings[key] = !this.settings[key];
                el.className = `toggle-button-small ${this.settings[key] ? 'on' : 'off'}`;
                el.innerText  = this.settings[key] ? 'ON' : 'OFF';
                this.saveSettings();
            });
        };
        const auctNum = (id, key) => {
            const el = document.getElementById(id); if (!el) return;
            el.addEventListener('change', (e) => {
                this.settings[key] = parseFloat(e.target.value) || 0;
                this.saveSettings();
            });
        };
        const auctText = (id, key) => {
            const el = document.getElementById(id); if (!el) return;
            el.addEventListener('input', (e) => { this.settings[key] = e.target.value; this.saveSettings(); });
        };

        auctToggle('set-auctionAutoList',     'auctionAutoList');
        auctToggle('set-auctionFilterNormal', 'auctionFilterNormal');
        auctToggle('set-auctionFilterUnique', 'auctionFilterUnique');
        auctToggle('set-auctionFilterHero',   'auctionFilterHero');
        auctNum('set-auctionDuration',    'auctionDuration');
        auctNum('set-auctionMinNormal',   'auctionMinNormal');
        auctNum('set-auctionMaxNormal',   'auctionMaxNormal');
        auctNum('set-auctionMinUnique',   'auctionMinUnique');
        auctNum('set-auctionMaxUnique',   'auctionMaxUnique');
        auctNum('set-auctionMinHero',     'auctionMinHero');
        auctNum('set-auctionMaxHero',     'auctionMaxHero');
        auctText('set-auctionBlacklist',  'auctionBlacklist');

        // ── Aukcje – toggle'e akcji ──────────────────────────────────────────
        auctToggle('set-auctionCollectMail', 'auctionCollectMail');
        auctToggle('set-auctionCall',        'auctionCall');
        auctToggle('set-auctionRenew',       'auctionRenew');

        // ── Zakładka Blokady Map – events (DODAJ) ────────────────────────────
        const dmAddBtn = document.getElementById('dm-add-btn');
        if (dmAddBtn) {
            dmAddBtn.addEventListener('click', () => {
                const mapEl  = document.getElementById('dm-new-map');
                const lvlEl  = document.getElementById('dm-new-lvl');
                const descEl = document.getElementById('dm-new-desc');
                const mapId  = parseInt(mapEl  ? mapEl.value  : '');
                const minLvl = parseInt(lvlEl  ? lvlEl.value  : '');
                const desc   = descEl ? descEl.value.trim() : '';

                if (!mapId || mapId < 1 || !minLvl || minLvl < 1 || minLvl > 500) {
                    if (mapEl)  { mapEl.style.borderColor  = 'var(--accent-red)'; setTimeout(() => { mapEl.style.borderColor  = ''; }, 1500); }
                    if (lvlEl)  { lvlEl.style.borderColor  = 'var(--accent-red)'; setTimeout(() => { lvlEl.style.borderColor  = ''; }, 1500); }
                    return;
                }

                if (!this.settings.dangerMaps) this.settings.dangerMaps = [];

                // Nie dodawaj duplikatów
                const exists = this.settings.dangerMaps.some(r => parseInt(r.mapId) === mapId);
                if (exists) {
                    if (mapEl) { mapEl.style.borderColor = '#e8a83c'; setTimeout(() => { mapEl.style.borderColor = ''; }, 1500); }
                    return;
                }

                this.settings.dangerMaps.push({ mapId, minLevel: minLvl, desc: desc || `Mapa ${mapId}`, enabled: true });
                this.saveSettings();
                this.renderDangerTable();

                // Wyczyść pola
                if (mapEl)  mapEl.value  = '';
                if (lvlEl)  lvlEl.value  = '';
                if (descEl) descEl.value = '';
            });
        }
    };

    // ══════════════════════════════════════════════════════════════
    //  renderDangerTable – rysuje wiersze tabeli blokad map
    // ══════════════════════════════════════════════════════════════
    proto.renderDangerTable = function () {
        const tbody = document.getElementById('dm-table-body');
        if (!tbody) return;

        const rules = this.settings.dangerMaps || [];

        if (rules.length === 0) {
            tbody.innerHTML = `<tr class="dm-empty-row"><td colspan="5">Brak reguł. Dodaj mapę poniżej.</td></tr>`;
            return;
        }

        // Pobierz aktualny poziom postaci do podglądu stanu
        const playerLevel = (typeof Engine !== 'undefined' && Engine.hero && Engine.hero.d)
            ? (Engine.hero.d.lvl || 0)
            : (window._uiCacheData.playerLevel || 0);

        tbody.innerHTML = rules.map((rule, idx) => {
            const isBlocked = rule.enabled && playerLevel > 0 && playerLevel < rule.minLevel;
            const dotClass  = rule.enabled ? 'on' : 'off';
            const dotTitle  = rule.enabled ? 'Reguła aktywna – kliknij aby wyłączyć' : 'Reguła wyłączona – kliknij aby włączyć';
            const rowStyle  = isBlocked ? ' style="background:rgba(231,76,60,0.05);"' : '';
            const lvlStyle  = isBlocked ? ' style="color:var(--accent-red);"' : '';

            return `<tr${rowStyle}>
                <td><span class="dm-map-id">${rule.mapId}</span></td>
                <td><span class="dm-lvl-badge"${lvlStyle}>${rule.minLevel}</span></td>
                <td><span class="dm-desc-text">${this._escHtml(rule.desc || '')}</span></td>
                <td class="dm-stan-cell">
                    <span class="dm-stan-dot ${dotClass}" title="${dotTitle}" data-dm-idx="${idx}"></span>
                </td>
                <td class="dm-col-akcje">
                    <button class="dm-btn-del" data-dm-del="${idx}">USUŃ</button>
                </td>
            </tr>`;
        }).join('');

        // Bind: toggle Stan
        tbody.querySelectorAll('.dm-stan-dot').forEach(dot => {
            dot.addEventListener('click', (e) => {
                const i = parseInt(e.target.getAttribute('data-dm-idx'));
                if (isNaN(i) || !this.settings.dangerMaps[i]) return;
                this.settings.dangerMaps[i].enabled = !this.settings.dangerMaps[i].enabled;
                this.saveSettings();
                this.renderDangerTable();
            });
        });

        // Bind: usuń regułę
        tbody.querySelectorAll('.dm-btn-del').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const i = parseInt(e.target.getAttribute('data-dm-del'));
                if (isNaN(i)) return;
                this.settings.dangerMaps.splice(i, 1);
                this.saveSettings();
                this.renderDangerTable();
            });
        });
    };

    // Helper: escape HTML w opisach
    proto._escHtml = function(str) {
        return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    };

    // ══════════════════════════════════════════════════════════════
    //  renderHeroQueue – rysuje listę kolejki herosów
    // ══════════════════════════════════════════════════════════════
    proto.renderHeroQueue = function () {
        const list = document.getElementById('hero-queue-list');
        if (!list) return;

        const queue  = this.settings.heroQueue || [];
        const heroes = window._uiCacheData.heroes || [];
        const getHeroName = (key) => {
            const h = heroes.find(h => (h.key || h.id || h.name) === key);
            return h ? h.name : key;
        };

        if (queue.length === 0) {
            list.innerHTML = `<div style="color: var(--text-muted); font-size: 11px; text-align: center; padding: 6px 0;">
                Kolejka pusta – dodaj herosów powyżej
            </div>`;
            return;
        }

        list.innerHTML = '';
        queue.forEach((heroKey, idx) => {
            const row = document.createElement('div');
            row.style.cssText = `
                display: flex; align-items: center; gap: 5px;
                background: rgba(255,255,255,0.04); border-radius: 4px;
                padding: 4px 7px; font-size: 12px;
            `;

            // Numer
            const num = document.createElement('span');
            num.style.cssText = 'color: var(--text-muted); min-width: 16px; font-size: 11px;';
            num.textContent = (idx + 1) + '.';
            row.appendChild(num);

            // Nazwa
            const label = document.createElement('span');
            label.style.cssText = 'flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;';
            label.textContent = getHeroName(heroKey);
            row.appendChild(label);

            // Przesuń w górę
            if (idx > 0) {
                const upBtn = document.createElement('button');
                upBtn.textContent = '▲';
                upBtn.title = 'Przesuń wyżej';
                upBtn.style.cssText = `
                    background: none; border: none; color: var(--text-muted);
                    cursor: pointer; font-size: 11px; padding: 0 2px; line-height: 1;`;
                upBtn.addEventListener('click', () => {
                    [this.settings.heroQueue[idx - 1], this.settings.heroQueue[idx]] =
                    [this.settings.heroQueue[idx], this.settings.heroQueue[idx - 1]];
                    this.saveSettings();
                    this.renderHeroQueue();
                });
                row.appendChild(upBtn);
            }

            // Przesuń w dół
            if (idx < queue.length - 1) {
                const downBtn = document.createElement('button');
                downBtn.textContent = '▼';
                downBtn.title = 'Przesuń niżej';
                downBtn.style.cssText = `
                    background: none; border: none; color: var(--text-muted);
                    cursor: pointer; font-size: 11px; padding: 0 2px; line-height: 1;`;
                downBtn.addEventListener('click', () => {
                    [this.settings.heroQueue[idx], this.settings.heroQueue[idx + 1]] =
                    [this.settings.heroQueue[idx + 1], this.settings.heroQueue[idx]];
                    this.saveSettings();
                    this.renderHeroQueue();
                });
                row.appendChild(downBtn);
            }

            // Usuń
            const delBtn = document.createElement('button');
            delBtn.textContent = '✖';
            delBtn.title = 'Usuń z kolejki';
            delBtn.style.cssText = `
                background: none; border: none; color: var(--accent-red, #e74c3c);
                cursor: pointer; font-size: 11px; padding: 0 2px; line-height: 1;`;
            delBtn.addEventListener('click', () => {
                this.settings.heroQueue.splice(idx, 1);
                // Jeśli usunięty był przed aktywnym indeksem – skoryguj indeks
                if ((this.settings.heroQueueIndex || 0) > idx) {
                    this.settings.heroQueueIndex = Math.max(0, (this.settings.heroQueueIndex || 0) - 1);
                }
                this.saveSettings();
                this.renderHeroQueue();
            });
            row.appendChild(delBtn);

            list.appendChild(row);
        });
    };

    // ══════════════════════════════════════════════════════════════
    //  populateE2QueueSelect – wypełnia <select> w sekcji Kolejka E2
    // ══════════════════════════════════════════════════════════════
    proto.populateE2QueueSelect = function () {
        const sel = document.getElementById('queue-e2-select');
        if (!sel) return;
        const current = sel.value;
        sel.innerHTML = '<option value="">Wybierz E2...</option>';
        for (const elite of (window._uiCacheData.e2 || [])) {
            const opt = document.createElement('option');
            opt.value = elite.key;
            opt.innerText = `[${elite.level}] ${elite.name} (${elite.map_name})`;
            if (current === elite.key) opt.selected = true;
            sel.appendChild(opt);
        }
    };

    // ══════════════════════════════════════════════════════════════
    //  renderE2Queue – rysuje listę kolejki E2
    // ══════════════════════════════════════════════════════════════
    proto.renderE2Queue = function () {
        const list = document.getElementById('e2-queue-list');
        if (!list) return;

        const queue  = this.settings.e2Queue || [];
        const e2Data = window._uiCacheData.e2 || [];
        const getE2Name = (key) => {
            const e = e2Data.find(x => x.key === key);
            return e ? `[${e.level}] ${e.name} (${e.map_name})` : key;
        };

        if (queue.length === 0) {
            list.innerHTML = `<div style="color: var(--text-muted); font-size: 11px; text-align: center; padding: 6px 0;">
                Kolejka pusta – dodaj Elite II powyżej
            </div>`;
            return;
        }

        list.innerHTML = '';
        const activeIdx = this.settings.e2QueueIndex || 0;

        queue.forEach((entry, idx) => {
            const row = document.createElement('div');
            const isActive = idx === activeIdx;
            row.style.cssText = `
                display: flex; align-items: center; gap: 5px;
                background: ${isActive ? 'rgba(201,164,101,0.12)' : 'rgba(255,255,255,0.04)'};
                border: 1px solid ${isActive ? 'rgba(201,164,101,0.35)' : 'transparent'};
                border-radius: 4px; padding: 4px 7px; font-size: 12px;
            `;

            // Numer / aktywny wskaźnik
            const num = document.createElement('span');
            num.style.cssText = `color: ${isActive ? '#c9a465' : 'var(--text-muted)'}; min-width: 16px; font-size: 11px;`;
            num.textContent = isActive ? '▶' : (idx + 1) + '.';
            row.appendChild(num);

            // Nazwa E2
            const label = document.createElement('span');
            label.style.cssText = 'flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;';
            label.textContent = getE2Name(entry.e2Key);
            row.appendChild(label);

            // Nick (jeśli podany)
            if (entry.nick) {
                const nickEl = document.createElement('span');
                nickEl.style.cssText = 'color: #7ec8e3; font-size: 11px; white-space: nowrap; max-width: 90px; overflow: hidden; text-overflow: ellipsis;';
                nickEl.title = 'Nick: ' + entry.nick;
                nickEl.textContent = '👤 ' + entry.nick;
                row.appendChild(nickEl);
            }

            // Przesuń w górę
            if (idx > 0) {
                const upBtn = document.createElement('button');
                upBtn.textContent = '▲';
                upBtn.title = 'Przesuń wyżej';
                upBtn.style.cssText = 'background:none;border:none;color:var(--text-muted);cursor:pointer;font-size:11px;padding:0 2px;line-height:1;';
                upBtn.addEventListener('click', () => {
                    [this.settings.e2Queue[idx - 1], this.settings.e2Queue[idx]] =
                    [this.settings.e2Queue[idx], this.settings.e2Queue[idx - 1]];
                    if (this.settings.e2QueueIndex === idx) this.settings.e2QueueIndex = idx - 1;
                    else if (this.settings.e2QueueIndex === idx - 1) this.settings.e2QueueIndex = idx;
                    this.saveSettings();
                    this.renderE2Queue();
                });
                row.appendChild(upBtn);
            }

            // Przesuń w dół
            if (idx < queue.length - 1) {
                const downBtn = document.createElement('button');
                downBtn.textContent = '▼';
                downBtn.title = 'Przesuń niżej';
                downBtn.style.cssText = 'background:none;border:none;color:var(--text-muted);cursor:pointer;font-size:11px;padding:0 2px;line-height:1;';
                downBtn.addEventListener('click', () => {
                    [this.settings.e2Queue[idx], this.settings.e2Queue[idx + 1]] =
                    [this.settings.e2Queue[idx + 1], this.settings.e2Queue[idx]];
                    if (this.settings.e2QueueIndex === idx) this.settings.e2QueueIndex = idx + 1;
                    else if (this.settings.e2QueueIndex === idx + 1) this.settings.e2QueueIndex = idx;
                    this.saveSettings();
                    this.renderE2Queue();
                });
                row.appendChild(downBtn);
            }

            // Aktywuj ręcznie (ustaw jako bieżący)
            const setBtn = document.createElement('button');
            setBtn.textContent = '✦';
            setBtn.title = 'Ustaw jako aktualny w kolejce';
            setBtn.style.cssText = `background:none;border:none;color:${isActive ? '#c9a465' : 'var(--text-muted)'};cursor:pointer;font-size:12px;padding:0 2px;line-height:1;`;
            setBtn.addEventListener('click', () => {
                this.settings.e2QueueIndex = idx;
                this.saveSettings();
                this.renderE2Queue();
            });
            row.appendChild(setBtn);

            // Usuń
            const delBtn = document.createElement('button');
            delBtn.textContent = '✖';
            delBtn.title = 'Usuń z kolejki';
            delBtn.style.cssText = 'background:none;border:none;color:var(--accent-red,#e74c3c);cursor:pointer;font-size:11px;padding:0 2px;line-height:1;';
            delBtn.addEventListener('click', () => {
                this.settings.e2Queue.splice(idx, 1);
                if ((this.settings.e2QueueIndex || 0) >= this.settings.e2Queue.length) {
                    this.settings.e2QueueIndex = Math.max(0, this.settings.e2Queue.length - 1);
                }
                this.saveSettings();
                this.renderE2Queue();
            });
            row.appendChild(delBtn);

            list.appendChild(row);
        });
    };

    // ══════════════════════════════════════════════════════════════
    //  attachE2QueueEvents – eventy przycisku dodaj do kolejki E2
    // ══════════════════════════════════════════════════════════════
    proto.attachE2QueueEvents = function () {
        const addBtn = document.getElementById('btn-add-e2-queue');
        if (!addBtn) return;
        addBtn.addEventListener('click', () => {
            const sel  = document.getElementById('queue-e2-select');
            const nick = document.getElementById('queue-e2-nick');
            if (!sel || !sel.value) return;

            if (!this.settings.e2Queue) this.settings.e2Queue = [];

            // Nie duplikuj tego samego e2Key + nick combo
            const nickVal = nick ? nick.value.trim() : '';
            const duplicate = this.settings.e2Queue.some(
                e => e.e2Key === sel.value && (e.nick || '') === nickVal
            );
            if (duplicate) return;

            this.settings.e2Queue.push({ e2Key: sel.value, nick: nickVal });
            if (nick) nick.value = '';
            this.saveSettings();
            this.renderE2Queue();
        });

    };

    // ══════════════════════════════════════════════════════════════
    //  Publiczne API dla logiki Speedya (do użycia z zewnątrz)
    // ══════════════════════════════════════════════════════════════

    // Zwraca aktualny wpis z kolejki E2: { e2Key, nick } lub null
    proto.getCurrentE2QueueEntry = function () {
        const q = this.settings.e2Queue || [];
        if (q.length === 0) return null;
        const idx = Math.min(this.settings.e2QueueIndex || 0, q.length - 1);
        return q[idx] || null;
    };

    // Przesuwa kolejkę do przodu (pętla). Zwraca nowy wpis.
    proto.advanceE2Queue = function () {
        const q = this.settings.e2Queue || [];
        if (q.length === 0) return null;
        const next = ((this.settings.e2QueueIndex || 0) + 1) % q.length;
        this.settings.e2QueueIndex = next;
        this.saveSettings();
        this.renderE2Queue();
        return q[next];
    };

    // Ręczna aktualizacja wskaźnika kolejki (np. po relogu)
    proto.updateE2QueueCurrent = function (idx) {
        if (typeof idx !== 'number') return;
        this.settings.e2QueueIndex = idx;
        this.saveSettings();
        this.renderE2Queue();
    };

    // Aktualizuje etykietę „aktualnie szukany" w zakładce Herosi
    proto.updateHeroQueueCurrent = function (heroKey) {
        const el = document.getElementById('hero-queue-current');
        if (!el) return;
        if (!heroKey) { el.textContent = ''; return; }
        const heroes = window._uiCacheData.heroes || [];
        const h = heroes.find(h => (h.key || h.id || h.name) === heroKey);
        const name = h ? h.name : heroKey;
        el.textContent = `🔍 Szuka: ${name}`;
    };

})();

// ====== gui/gui_addons.js (bundled) ======
// ═══════════════════════════════════════════════════════════════
//  gui_addons.js – Rozszerzenia jakości życia
//  Ładuj PO gui_events.js, PRZED gui_init.js
//  Dodaje:
//    • Toast notifications      (gui.toast / window._speedyToast)
//    • Sidebar search           (Ctrl+K)
//    • Skrót klawiszowy         (Ctrl+Shift+R – pokaż/ukryj)
//    • Pamiętanie ostatniej zakładki per-postać
//    • Eksport / import / reset ustawień
//    • Aktywacja "Aktywny" statusu z odliczaniem czasu działania
// ═══════════════════════════════════════════════════════════════
(function () {
    const proto = window._SpeedyGUI && window._SpeedyGUI.prototype;
    if (!proto) {
        return;
    }

    // ── Toast notifications ──────────────────────────────────────────────────
    function ensureToastStack() {
        let stack = document.getElementById('ext-toast-stack');
        if (!stack) {
            stack = document.createElement('div');
            stack.id = 'ext-toast-stack';
            document.body.appendChild(stack);
        }
        return stack;
    }

    proto.toast = function (message, type, durationMs) {
        type = type || 'info';
        durationMs = durationMs || 3500;
        const stack = ensureToastStack();
        const el = document.createElement('div');
        el.className = 'ext-toast ' + (['success', 'error', 'info'].includes(type) ? type : 'info');
        el.textContent = message;
        stack.appendChild(el);
        setTimeout(() => { if (el.parentNode) el.parentNode.removeChild(el); }, durationMs);
        return el;
    };

    // Globalny alias – ułatwia użycie z innych modułów
    window._speedyToast = function (message, type, durationMs) {
        const gui = window._uiCacheData && window._uiCacheData.gui;
        if (gui && typeof gui.toast === 'function') return gui.toast(message, type, durationMs);
        // Fallback – pokaż nawet bez instancji GUI
        const stack = ensureToastStack();
        const el = document.createElement('div');
        el.className = 'ext-toast ' + (type || 'info');
        el.textContent = message;
        stack.appendChild(el);
        setTimeout(() => { if (el.parentNode) el.parentNode.removeChild(el); }, durationMs || 3500);
    };

    // ── Pamiętanie ostatnio otwartej zakładki ───────────────────────────────
    proto.restoreLastActiveTab = function () {
        const tabId = this.settings && this.settings.lastActiveTab;
        if (!tabId) return;
        const btn = document.querySelector('.nav-button[data-tab="' + tabId + '"]');
        if (!btn) return;
        // Czy zakładka jest już aktywna? Jeśli tak – nic nie rób.
        if (btn.classList.contains('active')) return;
        btn.click();
    };

    // ── Modal pomocniczy do eksportu/importu ─────────────────────────────────
    function showJsonModal(opts) {
        // opts: { title, value, readonly, onSave }
        const existing = document.getElementById('ext-json-modal');
        if (existing) existing.remove();

        const overlay = document.createElement('div');
        overlay.id = 'ext-json-modal';
        overlay.style.cssText = `
            position: fixed; inset: 0; background: rgba(0,0,0,0.6);
            display: flex; align-items: center; justify-content: center;
            z-index: 99999999; backdrop-filter: blur(3px);
            font-family: 'Inter', sans-serif;`;

        const box = document.createElement('div');
        box.style.cssText = `
            background: rgba(18,16,14,0.98); border: 1px solid rgba(232,168,60,0.25);
            border-radius: 8px; padding: 16px; width: 540px; max-width: 90vw;
            max-height: 80vh; display: flex; flex-direction: column; gap: 10px;
            box-shadow: 0 20px 50px -10px rgba(0,0,0,0.8);`;

        const title = document.createElement('div');
        title.textContent = opts.title || 'JSON';
        title.style.cssText = 'font-size: 13px; font-weight: 700; color: #f0d090; letter-spacing: 0.5px;';
        box.appendChild(title);

        const hint = document.createElement('div');
        hint.textContent = opts.readonly
            ? 'Skopiuj poniższą zawartość i zapisz w pliku .json. Możesz też kliknąć "Kopiuj".'
            : 'Wklej zawartość pliku .json poniżej, a następnie kliknij "Importuj".';
        hint.style.cssText = 'font-size: 10px; color: #7a7068; line-height: 1.4;';
        box.appendChild(hint);

        const ta = document.createElement('textarea');
        ta.value = opts.value || '';
        ta.readOnly = !!opts.readonly;
        ta.spellcheck = false;
        ta.style.cssText = `
            flex: 1; min-height: 280px; resize: vertical;
            background: rgba(0,0,0,0.4); border: 1px solid rgba(232,168,60,0.15);
            color: #d8cfc4; padding: 8px 10px; border-radius: 5px;
            font-family: 'Consolas','Monaco',monospace; font-size: 11px;
            outline: none; box-sizing: border-box;`;
        box.appendChild(ta);

        const btnRow = document.createElement('div');
        btnRow.style.cssText = 'display: flex; gap: 8px; justify-content: flex-end;';

        const mkBtn = (label, bg, color, border) => {
            const b = document.createElement('button');
            b.textContent = label;
            b.style.cssText = `
                padding: 7px 14px; border-radius: 5px; cursor: pointer;
                font-size: 11px; font-weight: 600; font-family: inherit;
                background: ${bg}; color: ${color}; border: 1px solid ${border};
                transition: 0.2s;`;
            return b;
        };

        if (opts.readonly) {
            const copyBtn = mkBtn('📋 Kopiuj', 'rgba(86,165,232,0.12)', '#56a5e8', 'rgba(86,165,232,0.3)');
            copyBtn.addEventListener('click', () => {
                ta.select();
                let ok = false;
                try { ok = document.execCommand('copy'); } catch (e) {}
                if (!ok && navigator.clipboard) {
                    navigator.clipboard.writeText(ta.value).then(
                        () => window._speedyToast && window._speedyToast('📋 Skopiowano do schowka', 'success'),
                        () => window._speedyToast && window._speedyToast('❌ Nie udało się skopiować', 'error')
                    );
                } else if (ok) {
                    window._speedyToast && window._speedyToast('📋 Skopiowano do schowka', 'success');
                }
            });
            btnRow.appendChild(copyBtn);
        } else {
            const saveBtn = mkBtn('✓ Importuj', 'rgba(126,200,122,0.12)', '#7ec87a', 'rgba(126,200,122,0.35)');
            saveBtn.addEventListener('click', () => {
                if (typeof opts.onSave === 'function') {
                    const ok = opts.onSave(ta.value);
                    if (ok !== false) overlay.remove();
                }
            });
            btnRow.appendChild(saveBtn);
        }

        const closeBtn = mkBtn('Zamknij', 'rgba(255,255,255,0.05)', '#7a7068', 'rgba(255,255,255,0.08)');
        closeBtn.addEventListener('click', () => overlay.remove());
        btnRow.appendChild(closeBtn);

        box.appendChild(btnRow);
        overlay.appendChild(box);
        overlay.addEventListener('click', (e) => { if (e.target === overlay) overlay.remove(); });
        document.body.appendChild(overlay);

        if (opts.readonly) {
            setTimeout(() => { ta.focus(); ta.select(); }, 50);
        } else {
            setTimeout(() => ta.focus(), 50);
        }
    }

    // ── Eksport / Import / Reset ustawień ────────────────────────────────────
    proto._exportSettings = function () {
        try {
            const payload = {
                _meta: {
                    type: 'speedy-settings',
                    heroId: this.currentHeroId || null,
                    exportedAt: new Date().toISOString(),
                    version: 2
                },
                settings: this.settings
            };
            const json = JSON.stringify(payload, null, 2);
            showJsonModal({
                title: '⬇ Eksport ustawień (postać ' + (this.currentHeroId || '?') + ')',
                value: json,
                readonly: true
            });
        } catch (e) {
            this.toast('❌ Błąd eksportu: ' + e.message, 'error', 5000);
        }
    };

    proto._importSettings = function () {
        showJsonModal({
            title: '⬆ Import ustawień',
            value: '',
            readonly: false,
            onSave: (raw) => {
                try {
                    if (!raw || !raw.trim()) {
                        this.toast('⚠ Wklej najpierw zawartość JSON', 'error');
                        return false;
                    }
                    const parsed = JSON.parse(raw);
                    const incoming = (parsed && parsed.settings && typeof parsed.settings === 'object')
                        ? parsed.settings
                        : parsed;
                    if (!incoming || typeof incoming !== 'object') throw new Error('Nieprawidłowa struktura');

                    if (!confirm('Zaimportować ustawienia i nadpisać bieżące?\n\nDotyczy postaci: ' + (this.currentHeroId || '?'))) {
                        return false;
                    }

                    const wasRunning = !!this.settings.isRunning;
                    this.settings = { ...this.defaultSettings, ...incoming };
                    const defaultSetups = this.getPredefinedSetups();
                    this.settings.setups = { ...defaultSetups, ...(incoming.setups || {}) };
                    this.settings.isRunning = wasRunning;

                    this.saveSettings();
                    if (typeof this.applySettingsToUI === 'function') this.applySettingsToUI();
                    this.updateSetupDropdown && this.updateSetupDropdown();
                    this.updateSetupUI && this.updateSetupUI();
                    this.toast('✅ Ustawienia zaimportowane', 'success');
                    return true;
                } catch (e) {
                    this.toast('❌ Błąd importu: ' + e.message, 'error', 5000);
                    return false;
                }
            }
        });
    };

    proto._resetSettings = function () {
        if (!this.currentHeroId) {
            this.toast('⚠ Brak aktywnej postaci', 'error');
            return;
        }
        if (!confirm('Zresetować WSZYSTKIE ustawienia bieżącej postaci do domyślnych?\n\nTej operacji nie można cofnąć (poza importem z kopii).')) return;

        // Eksport awaryjny do localStorage (last-resort undo)
        try {
            localStorage.setItem('_ext_ui_prefs_v2_' + this.currentHeroId + '_backup', JSON.stringify(this.settings));
        } catch (e) {}

        const defaultSetups = this.getPredefinedSetups();
        this.settings = JSON.parse(JSON.stringify(this.defaultSettings));
        this.settings.setups = defaultSetups;
        const firstKey = Object.keys(defaultSetups)[0];
        if (firstKey) this.settings.activeSetup = firstKey;
        if (window._uiCacheData.defaultDangerMaps) {
            this.settings.dangerMaps = JSON.parse(JSON.stringify(window._uiCacheData.defaultDangerMaps));
        }

        this.saveSettings();
        if (typeof this.applySettingsToUI === 'function') this.applySettingsToUI();
        this.updateSetupDropdown && this.updateSetupDropdown();
        this.updateSetupUI && this.updateSetupUI();
        this.toast('↺ Ustawienia zresetowane (backup w localStorage)', 'info', 5000);
    };

    proto._initSettingsIO = function () {
        const exportBtn = document.getElementById('btn-settings-export');
        const importBtn = document.getElementById('btn-settings-import');
        const resetBtn  = document.getElementById('btn-settings-reset');

        if (exportBtn && !exportBtn.dataset.bound) {
            exportBtn.dataset.bound = '1';
            exportBtn.addEventListener('click', () => this._exportSettings());
        }
        if (importBtn && !importBtn.dataset.bound) {
            importBtn.dataset.bound = '1';
            importBtn.addEventListener('click', () => this._importSettings());
        }
        if (resetBtn && !resetBtn.dataset.bound) {
            resetBtn.dataset.bound = '1';
            resetBtn.addEventListener('click', () => this._resetSettings());
        }
    };

    // ── Skróty klawiszowe (globalne) ─────────────────────────────────────────
    proto._initKeyboardShortcuts = function () {
        if (window._uiCacheData._kbBound) return;
        window._uiCacheData._kbBound = true;

        const inTextField = (target) => {
            if (!target) return false;
            const tag = (target.tagName || '').toLowerCase();
            if (tag === 'input' || tag === 'textarea' || tag === 'select') return true;
            if (target.isContentEditable) return true;
            return false;
        };

        document.addEventListener('keydown', (e) => {
            // Alt+R – pokaż/ukryj okno GUI
            if (e.altKey && !e.ctrlKey && !e.shiftKey && (e.key === 'r' || e.key === 'R')) {
                if (inTextField(e.target)) return;
                const wrapper = document.getElementById('ext-layout-wrapper');
                if (!wrapper) return;
                e.preventDefault();
                e.stopPropagation();
                wrapper.classList.toggle('minimized');
            }
        }, true);
    };

    // ── Inicjalizacja po zbudowaniu DOM ─────────────────────────────────────
    proto._initAddons = function () {
        try { this._initSettingsIO(); }   catch (e) {}
        try { this._initKeyboardShortcuts(); } catch (e) {}
    };

    // Spróbuj zainicjalizować raz teraz (jeśli instancja już istnieje), a także
    // hookujemy się w applySettingsToUI by ponownie podpiąć kontrolki w razie odbudowy DOM
    const origApply = proto.applySettingsToUI;
    proto.applySettingsToUI = function () {
        if (typeof origApply === 'function') origApply.call(this);
        try { this._initAddons(); } catch (e) {}
    };

    // Rejestrujemy hook zmiany ustawień (np. po imporcie / zmianie postaci)
    if (!window._uiCacheData) window._uiCacheData = {};
    if (!window._uiCacheData._onSettingsChange) window._uiCacheData._onSettingsChange = [];

    // ── Auto-init gdy gui zostanie utworzony, ale applySettingsToUI nie zostało jeszcze wywołane
    const tryBoot = () => {
        const gui = window._uiCacheData && window._uiCacheData.gui;
        if (gui && typeof gui._initAddons === 'function') {
            gui._initAddons();
        }
    };
    setTimeout(tryBoot, 0);
    setTimeout(tryBoot, 500);
    setTimeout(tryBoot, 2000);
})();

// ====== gui/gui_init.js (bundled) ======
// ═══════════════════════════════════════════════════════════════
//  gui_init.js – Tworzy instancję SpeedyGUI i zapisuje w cache.
//  Musi być ładowany jako OSTATNI spośród plików gui/*.js.
//  Ulepszona wersja: czeka na _SpeedyGUI gdyby moduły ładowały się
//  w nieprzewidzianej kolejności i woła _initAddons po starcie.
// ═══════════════════════════════════════════════════════════════
(function () {
    if (!window._uiCacheData) window._uiCacheData = {};
    if (window._uiCacheData.gui) return;                      // guard przed podwójnym init

    let _lastBootErr = '';
    const boot = () => {
        if (window._uiCacheData.gui) return true;
        if (!window._SpeedyGUI) return false;
        try {
            window._uiCacheData.gui = new window._SpeedyGUI();
            const gui = window._uiCacheData.gui;
            // Wywołaj inicjalizację rozszerzeń (toast, skróty, I/O)
            if (gui && typeof gui._initAddons === 'function') {
                try { gui._initAddons(); } catch (e) { console.warn('[Speedy] _initAddons:', e); }
            }
            return true;
        } catch (e) {
            window._uiCacheData.gui = null;
            // Sprzątanie po nieudanej próbie – inaczej każda próba dokłada kolejne okno do DOM
            try {
                document.querySelectorAll('#ext-layout-wrapper').forEach(n => n.remove());
            } catch (_) {}
            const msg = (e && e.stack) || String(e);
            if (msg !== _lastBootErr) {            // loguj tylko gdy błąd się zmienił
                _lastBootErr = msg;
                console.error('[Speedy] GUI boot failed (ponawiam):', msg);
            }
            return false;
        }
    };

    if (boot()) return;

    // Retry – moduł/Engine nie był jeszcze gotowy (do ~5 min, co 500 ms)
    let tries = 0;
    const iv = setInterval(() => {
        if (boot() || ++tries > 600) clearInterval(iv);
    }, 500);
})();

// ====== injected.js (bundled, telemetry-disabled) ======
// --- START OF FILE injected.js ---

(function() {
    if (!window._uiCacheData) window._uiCacheData = {};
    if (window._uiCacheData.eng) return;

    let isActionRunning = false;
    let mapChangeCooldown = false;
    let _wasCombatOrLooting = false;
    const delay = ms => new Promise(res => setTimeout(res, ms));

    // ── STATYSTYKI: WYŁĄCZONE W WERSJI STANDALONE TAMpermonkey ──
    // Oryginał wysyłał cykliczne statystyki do zewnętrznego backendu.
    // W standalone zachowujemy hook licznika, ale nie wykonujemy żadnych requestów.
    let _statsWalki = 0;
    let _statsZgony = 0;
    async function _sendStatsPing() { return false; }
    window._uiCacheData._statsWalkiInc = () => { _statsWalki++; };
    // ── KONIEC STUBA STATYSTYK ────────────────────────────────────

    async function botLoop() {
        while (true) {
            await delay(100);

            const cache = window._uiCacheData;

            if (typeof Engine === 'undefined' || !cache.gui || !cache.exp) continue;
            if (mapChangeCooldown) continue;

            let config = cache.gui.getSettings();

            // v26: NIE wysyłamy settings id=34 podczas boot/F5/zmiany postaci.
            // Agresywność gry synchronizujemy wyłącznie po ręcznym kliknięciu Smart Aggro w GUI,
            // żeby nie wejść w konflikt z inicjalizacją ServerStorage/M_CLIENT_DATA klienta.

            // ── AUTO F5 (synchronizuj timer przy każdej zmianie ustawień) ─
            if (cache.options) cache.options.syncAutoF5(config);

            // ── ANTY DUSZEK (synchronizuj niezależnie od isRunning) ───────
            if (cache.options) cache.options.syncAntyDuszek(config);

            // ── HARMONOGRAM (Musi być PO Anty-Duszek i F5, aby bot nie usnął czekając) ─
            if (cache.options && cache.options.checkSchedule(config)) {
                await delay(10000);
                continue;
            }

            if (!config.isRunning || isActionRunning) continue;

            if (cache.actionManager && cache.actionManager.isBusy('botLoop')) {
                continue;
            }

            if (!config.isRunning && cache.hero) cache.hero.abortScan();

            isActionRunning = true;
            let mainActionToken = null;
            if (cache.actionManager) {
                mainActionToken = cache.actionManager.acquire('botLoop', 'MAIN_LOOP', 10, 45000);
                if (!mainActionToken) {
                    isActionRunning = false;
                    continue;
                }
            }

            try {
                if (cache.exp.isCaptchaActive()) {
                    if(cache.gui) cache.gui.updateStatus("Oczekiwanie...", "#f39c12");
                    isActionRunning = false;
                    await delay(2000);
                    continue;
                }

                // =========================================================
                // LOGIKA ŚMIERCI: Nabicie licznika na stronę + oczekiwanie
                // =========================================================
                if (Engine.dead) {
                    _statsZgony++; // Zwiększenie licznika zgonów dla strony

                    if (config.shortenOnDeath && cache.options) {
                        const isShortening = await cache.options.handleShortenOnDeath(config);
                        if (isShortening) {
                            isActionRunning = false;
                            await delay(1000);
                            continue;
                        }
                    }

                    _sendStatsPing(); // Wysyłka pingu do backendu od razu po śmierci

                    if (cache.gui) {
                        cache.gui.updateStatus("💀 Zgon! Czekam na respawn...", "#e74c3c");
                    }

                    isActionRunning = false;
                    await delay(2000);
                    continue;
                }

                if (!config.isRunning) { isActionRunning = false; continue; }

                // ── UCIECZKA PRZED GRACZAMI ──────────────────────────────────
                if (cache.flee) {
                    const fleeing = await cache.flee.handlePlayersLogic(config);
                    if (fleeing) { await delay(200); isActionRunning = false; continue; }
                }

                // ── BŁOGOSŁAWIEŃSTWO KLANU ───────────────────────────────────
                if (cache.options) {
                    const blessing = await cache.options.handleClanBlessing(config);
                    if (blessing) { isActionRunning = false; continue; }
                }

                // === Logika "poza walką" ===
                const inCombatOrLooting = (Engine.battle && Engine.battle.getShow()) ||
                    (Engine.loots && Engine.loots.window && Engine.loots.window.length > 0);
                const justReturnedToExp = _wasCombatOrLooting && !inCombatOrLooting;
                _wasCombatOrLooting = !!inCombatOrLooting;

                // v24 FAST RESUME: pierwszy tick po walce/łupach wraca prosto do EXP.
                // Nadal wcześniej wykonujemy captcha/death/flee, ale nie obchodzimy w tym ticku
                // sklepu, aukcji itd. Te moduły dostaną normalny tick zaraz potem.
                if (justReturnedToExp && !config.heroOnlyMode) {
                    if (cache.exp && typeof cache.exp.invalidateTargetCache === 'function') cache.exp.invalidateTargetCache();
                    await cache.exp.handleAutoExp(config, (v) => mapChangeCooldown = v);
                    continue;
                }

                if (!inCombatOrLooting) {
                    // 1. SPRZEDAŻ (śmieci i EQ)
                    if (cache.sell) {
                        const selling = await cache.sell(
                            config, cache.exp.findPathBFS, cache.exp.walkSmoothly,
                            cache.exp.getNextHopMap, () => mapChangeCooldown, (v) => mapChangeCooldown = v
                        );
                        if (selling) {
                            if (cache.options) { await cache.options.handleClanGold(config); }
                            await delay(200); isActionRunning = false; continue;
                        }
                    }
                    if (!config.isRunning) { isActionRunning = false; continue; }

                    // 2. KUPNO POTEK/ZWOJÓW
                    if (cache.buy) {
                        const buying = await cache.buy(
                            config, cache.exp.findPathBFS, cache.exp.walkSmoothly,
                            cache.exp.getNextHopMap, () => mapChangeCooldown, (v) => mapChangeCooldown = v
                        );
                        if (buying) { await delay(200); isActionRunning = false; continue; }
                    }
                    if (!config.isRunning) { isActionRunning = false; continue; }

                    // 3. AUTO-AUKCJE / POCZTA
                    if (cache.auction) {
                        const auctioning = await cache.auction.handleAutoAuctions(
                            config,
                            cache.exp.findPathBFS, cache.exp.walkSmoothly,
                            cache.exp.getNextHopMap,
                            () => mapChangeCooldown, (v) => mapChangeCooldown = v
                        );
                        if (auctioning) { await delay(200); isActionRunning = false; continue; }
                    }
                    if (!config.isRunning) { isActionRunning = false; continue; }

                    // === MODUŁY URUCHAMIANE PO "MIEŚCIE", PRZED WALKA ===

                    // ── AUTOMAT 1-300 (zmiana expowiska wg poziomu) ──────────────
                    if (cache.automat) {
                        cache.automat.checkAndSwitch();
                    }

                    // ── AUTO-ULEPSZANIE (kowadło) ─────────────────────────────────
                    if (cache.upgrade) {
                        const upgrading = cache.upgrade.handleAutoUpgrade(config);
                        if (upgrading) { await delay(2000); isActionRunning = false; continue; }
                    }

                    // ── AUTO-PARTY ───────────────────────────────────────────
                    if (cache.party) {
                        await cache.party.handlePartyLogic(config);
                    }
                }

                if (!config.isRunning) { isActionRunning = false; continue; }

                // ── TRYB: Tylko Heros ────────────────────────────────────────
                if (config.heroOnlyMode) {

                    if (Engine.battle && Engine.battle.getShow()) {
                        if(cache.gui) cache.gui.updateStatus("⚔️ Walka z herosem...", "#e74c3c");
                        isActionRunning = false; await delay(200); continue;
                    }

                    if (Engine.loots && Engine.loots.window && Engine.loots.window.length > 0) {
                        if(cache.gui) cache.gui.updateStatus("🎁 Zbieranie łupów...", "#27ae60");
                        Engine.loots.acceptLoot();
                        isActionRunning = false; await delay(150); continue;
                    }

                    if (!cache.hero) {
                        if(cache.gui) cache.gui.updateStatus("❌ Brak autohero.js!", "#e74c3c");
                        isActionRunning = false; await delay(2000); continue;
                    }

                    if ((!config.heroSelect || config.heroSelect.trim() === '') &&
                        (!config.heroQueue || config.heroQueue.length === 0)) {
                        if(cache.gui) cache.gui.updateStatus("⚠️ Dodaj herosów do kolejki", "#e67e22");
                        isActionRunning = false; await delay(1000); continue;
                    }

                    await cache.hero.handleHeroHunting(config, (v) => mapChangeCooldown = v);
                    isActionRunning = false;
                    continue;
                }

                // ── Wyszukiwanie herosów przy okazji expa ──
                if (!inCombatOrLooting && cache.hero && config.heroBicie) {
                    const quickFind = cache.hero.detectHero(config);
                    if (quickFind) {
                        if(cache.gui) cache.gui.updateStatus(`⚔️ Atakuję herosa: ${quickFind.nick}`, '#e74c3c');
                        try { Engine.hero.heroAtackRequest(quickFind.id, true); } catch {}
                        await delay(200); isActionRunning = false; continue;
                    }
                }

                if (!config.isRunning) { isActionRunning = false; continue; }

                // ── TRYB: Normalny exp (główna funkcja polowania) ──
                await cache.exp.handleAutoExp(config, (v) => mapChangeCooldown = v);

            } catch (e) {
                console.error('[M-Helper] botLoop error:', e);
                if (cache.errors) {
                    const count = cache.errors.record('BOT_LOOP_EXCEPTION', {
                        message: e && e.message ? e.message : String(e),
                        stack: e && e.stack ? String(e.stack).slice(0, 1200) : null
                    });
                    if (count >= 5 && cache.gui && typeof cache.gui.forceStop === 'function') {
                        cache.gui.forceStop('Powtarzający się błąd głównej pętli');
                    }
                }
                try { cache.exp.releaseKey(); } catch {}
                await delay(1000);
            } finally {
                if (cache.actionManager && mainActionToken) {
                    cache.actionManager.release(mainActionToken);
                }
                isActionRunning = false;
            }
        }
    }

    botLoop().catch(() => {
        if (window._uiCacheData.gui) window._uiCacheData.gui.forceStop("Błąd!");
    });

    window._uiCacheData.eng = true;
