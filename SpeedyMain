    async function handleAutoAuctions(config, findPathBFS, walkSmoothly, getNextHopMap, getMapChangeCooldown, setMapChangeCooldown) {

        if (!config.auctionAutoList && !config.auctionCollectMail) return false;
        if (auctionInProgress || mailInProgress) return true;

        const uniqueCount   = countItemsByTier('unique');
        const heroicCount   = countItemsByTier('heroic');
        const inCity        = isInCity();
        const bagFull       = isBagFull();

        const itemsToListNow  = config.auctionAutoList ? collectItemsToList(config) : [];
        const hasAuctionItems = itemsToListNow.length > 0;

        const forceByCount = (uniqueCount >= FORCE_THRESHOLD_UNIQUE || heroicCount >= FORCE_THRESHOLD_HEROIC);
        const forcedByBag  = bagFull && hasAuctionItems;
        const shouldForce  = forceByCount || forcedByBag;

        if (!hasAuctionItems && !config.auctionCollectMail) return false;

        // Aukcja przez przedmiot (w terenie)
        if (config.auctionAutoList && config.auctionCall && shouldForce && !inCity) {
            const caller = findAuctionCallerItem();
            if (caller) {
                auctionInProgress = true;
                window._uiCacheData._auctionRunning = true;
                if (window._uiCacheData.gui) window._uiCacheData.gui.updateStatus('📦 Wywołuję aukcję (item)...', '#f39c12');
                try {
                    try {
                        if (typeof Engine.heroEquipment.sendUseRequest === 'function') Engine.heroEquipment.sendUseRequest(caller);
                        else window._g('moveitem&st=1&id=' + (caller.id || caller.d.id));
                    } catch (e) {}
                    await delay(800);

                    if (Engine.auctions) {
                        if (itemsToListNow.length > 0) {
                            const listed = await listItemsOnAuction(itemsToListNow, config);
                            if (window._uiCacheData.gui)
                                window._uiCacheData.gui.updateStatus(`✅ Wystawiono ${listed} itemów`, '#27ae60');
                        }
                        await delay(300);
                        closeAuctionWindow();
                        lastAuctionTime = Date.now();
                    }
                } catch (e) {
                } finally {
                    auctionInProgress = false;
                    window._uiCacheData._auctionRunning = false;
                }
                return true;
            }
        }

        // Aukcja przez aukcjonera
        const auctionCooldownOk = Date.now() - lastAuctionTime > SHOP_COOLDOWN_MS;
        const shouldGoToAuctioneer = hasAuctionItems && (inCity || (shouldForce && auctionCooldownOk));

        if (config.auctionAutoList && shouldGoToAuctioneer) {
            const auctioneer = findBestAuctioneer();
            if (auctioneer) {
                auctionInProgress = true;
                window._uiCacheData._auctionRunning = true;
                if (window._uiCacheData.gui) window._uiCacheData.gui.updateStatus('🏛️ Idę do aukcjonera...', '#9b59b6');
                try {
                    const reached = await _navigateToMap(auctioneer.map_id, findPathBFS, walkSmoothly, getNextHopMap, setMapChangeCooldown);
                    if (!reached) { return false; }
                    await delay(1000);

                    const opened = await _openNpcWindow(auctioneer, findPathBFS, walkSmoothly);
                    if (opened && Engine.auctions) {
                        const freshItems = collectItemsToList(config);
                        const listed = await listItemsOnAuction(freshItems, config);
                        if (window._uiCacheData.gui)
                            window._uiCacheData.gui.updateStatus(`✅ Aukcja: ${listed} itemów`, '#27ae60');
                        await delay(300);
                        closeAuctionWindow();
                        lastAuctionTime = Date.now();
                    }
                } catch (e) {
                } finally {
                    auctionInProgress = false;
                    window._uiCacheData._auctionRunning = false;
                }
                return true;
            }
        }

        // Poczta
        const mailCooldownOk = Date.now() - lastMailTime > MAIL_COOLDOWN_MS;
        const hasMailNotification = !!(Engine.hero && Engine.hero.d && Engine.hero.d.new_mail);

        if (config.auctionCollectMail && inCity && !mailInProgress && mailCooldownOk && hasMailNotification) {
            const mailbox = findBestMailbox();
            if (!mailbox) return false;

            mailInProgress = true;
            window._uiCacheData._auctionRunning = true;
            if (window._uiCacheData.gui) window._uiCacheData.gui.updateStatus('📬 Odbieram pocztę...', '#3498db');
            try {
                const reached = await _navigateToMap(mailbox.map_id, findPathBFS, walkSmoothly, getNextHopMap, setMapChangeCooldown);
                if (!reached) { return false; }
                await delay(800);

                const opened = await openMailbox(mailbox, findPathBFS, walkSmoothly);
                if (!opened) { return false; }

                let maxRounds = 20;
                let totalReceived = 0;
                while (maxRounds-- > 0) {
                    const received = await collectMailBatch();
                    if (received === 0) break;
                    totalReceived += received;

                    if (window._uiCacheData.gui)
                        window._uiCacheData.gui.updateStatus(`📬 Odebrano ${totalReceived} liter(y)...`, '#27ae60');
                    await delay(500);

                    if (isBagAlmostFull(2) && config.auctionAutoList) {
                        closeMailWindow();
                        await delay(300);

                        const itemsToList = collectItemsToList(config);
                        if (itemsToList.length > 0) {
                            let listedCount = 0;

                            if (config.auctionCall) {
                                const caller = findAuctionCallerItem();
                                if (caller) {
                                    try {
                                        if (typeof Engine.heroEquipment.sendUseRequest === 'function') Engine.heroEquipment.sendUseRequest(caller);
                                        else window._g('moveitem&st=1&id=' + (caller.id || caller.d.id));
                                    } catch (e) {}
                                    await delay(800);
                                    if (Engine.auctions) {
                                        listedCount = await listItemsOnAuction(itemsToList, config);
                                        await delay(300);
                                        closeAuctionWindow();
                                    }
                                }
                            }

                            if (listedCount === 0) {
                                const auctioneer = findBestAuctioneer();
                                if (auctioneer) {
                                    const reached2 = await _navigateToMap(auctioneer.map_id, findPathBFS, walkSmoothly, getNextHopMap, setMapChangeCooldown);
                                    if (reached2) {
                                        const opened2 = await _openNpcWindow(auctioneer, findPathBFS, walkSmoothly);
                                        if (opened2 && Engine.auctions) {
                                            listedCount = await listItemsOnAuction(itemsToList, config);
                                            await delay(300);
                                            closeAuctionWindow();
                                            lastAuctionTime = Date.now();
                                        }
                                    }
                                }
                            }

                            if (window._uiCacheData.gui && listedCount > 0)
                                window._uiCacheData.gui.updateStatus(`✅ Aukcja: ${listedCount} itemów, wracam do poczty...`, '#27ae60');
                            await delay(500);
                        }

                        const backToMailbox = await _navigateToMap(mailbox.map_id, findPathBFS, walkSmoothly, getNextHopMap, setMapChangeCooldown);
                        if (!backToMailbox) break;
                        await delay(600);
                        const reopened = await openMailbox(mailbox, findPathBFS, walkSmoothly);
                        if (!reopened) break;
                    }
                }

                closeMailWindow();
                lastMailTime = Date.now();
                if (window._uiCacheData.gui) window._uiCacheData.gui.updateStatus('📬 Poczta odebrana!', '#27ae60');

            } catch (e) {
            } finally {
                mailInProgress = false;
                window._uiCacheData._auctionRunning = false;
            }
            return true;
        }

        return false;
    }

    window._uiCacheData.auction = {
        handleAutoAuctions,
        collectItemsToList,
        countItemsByTier,
        isInCity,
        findAuctionCallerItem
    };

})();

