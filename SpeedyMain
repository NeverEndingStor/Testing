    function _expWaitMarkAttack(target, currentMapId, config) {
        if (!config?.expWaitingRoom || !target) return;
        const setupMaps = (config.activeSetup && config.setups?.[config.activeSetup])
            ? config.setups[config.activeSetup].map(m => parseInt(m.id || m)) : [];
        const st = _expWaitEnsureAnchor(config, setupMaps, Number(currentMapId));
        if (!st || Number(st.anchorMapId) !== Number(currentMapId) || st.armed) return;
        _expWaitCombat = {
            at: Date.now(), mapId: Number(currentMapId), id: String(target.id),
