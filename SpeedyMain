    async function maybeEnterExpWaitingRoom(config, setupMaps, currentMapId) {
        if (!config?.expWaitingRoom || !setupMaps.length) return false;
        const st = _expWaitLoad();
        if (!st || !st.armed || st.setupName !== config.activeSetup) return false;
        if (Number(currentMapId) !== Number(st.anchorMapId)) return false;
        if (setupMaps.length > 1 && !st.cycleLeftAnchor) return false;
        if (!_expWaitAllMapsVisited(st, setupMaps)) return false;

        const now = Math.floor(Date.now() / 1000);
        const wakeAt = Number(st.wakeAt || 0);
        if (!wakeAt || now >= wakeAt) {
            // Resp powinien już istnieć. Nie wychodź; pozwól zwykłemu skanerowi go znaleźć.
