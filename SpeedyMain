// --- START OF FILE gui_tab_e2.js ---
// Uproszczony moduł E2 v28: jedna kolejka przypisań postać -> E2.
// "Roster" zostaje wyłącznie jako wewnętrzny format danych, nie jako pojęcie w GUI.
(function () {
    const ROSTER_KEY = 'mg_e2_roster';
    const GLOBAL_ENABLED_KEY = 'mg_e2_enabled_global';
    const GLOBAL_AUTOLOGIN_KEY = 'mg_e2_autologin_global';

    function loadQueue() {
        try { return JSON.parse(localStorage.getItem(ROSTER_KEY) || '[]') || []; }
        catch (_) { return []; }
    }
    function saveQueue(q) {
        try { localStorage.setItem(ROSTER_KEY, JSON.stringify(q || [])); } catch (_) {}
    }
    function currentHero() {
        try {
            if (!Engine || !Engine.hero || !Engine.hero.d) return null;
            const d = Engine.hero.d;
            return {
                nick: String(d.nick || ''),
                charId: Number(d.id || 0),
                world: (Engine.worldConfig && typeof Engine.worldConfig.getWorldName === 'function')
                    ? Engine.worldConfig.getWorldName()
                    : (location.hostname.split('.')[0] || '')
            };
        } catch (_) { return null; }
    }
    function findEntryIndexForHero(q, hero) {
        if (!hero) return -1;
        let idx = q.findIndex(x => Number(x.charId || 0) && Number(x.charId) === Number(hero.charId));
        if (idx >= 0) return idx;
        const n = hero.nick.toLowerCase();
        return q.findIndex(x => {
            const en = String(x.nick || '').toLowerCase();
            return en && (en === n || en.startsWith(n) || n.startsWith(en));
        });
    }
    function ensureHeroEntry(q, hero) {
        let idx = findEntryIndexForHero(q, hero);
        if (idx >= 0) {
            q[idx].nick = hero.nick || q[idx].nick;
            q[idx].charId = hero.charId || q[idx].charId || null;
            q[idx].world = hero.world || q[idx].world || null;
            q[idx].e2Keys = Array.isArray(q[idx].e2Keys) ? q[idx].e2Keys : [];
            q[idx].coords = q[idx].coords && typeof q[idx].coords === 'object' ? q[idx].coords : {};
            return idx;
        }
        q.push({ nick: hero.nick, charId: hero.charId || null, world: hero.world || null, e2Keys: [], coords: {} });
        return q.length - 1;
    }
    function fmt(sec) {
        sec = Math.max(0, Number(sec) || 0);
        const m = Math.floor(sec / 60), s = sec % 60;
        return `${m}:${String(s).padStart(2, '0')}`;
    }

    window._guiTabHTML_e2 = function () {
        return `
        <div id="tab-e2" class="tab-panel">
            <div class="settings-card">
                <div class="card-body">
                    <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;">
                        <div>
                            <div style="font-size:13px;font-weight:700;color:var(--text-main);">Elity II</div>
                            <div id="e2-simple-status" style="font-size:10px;color:var(--text-muted);margin-top:2px;">Wyłączone</div>
                        </div>
                        <div id="set-e2Enabled" class="toggle-button-e2 off">OFF</div>
                    </div>
                </div>
            </div>

            <div class="settings-card">
                <div class="card-body">
                    <div style="font-size:11px;font-weight:700;color:#c9a465;margin-bottom:7px;">DLA AKTUALNEJ POSTACI</div>
                    <div id="e2-current-char" style="font-size:11px;color:#ddd;margin-bottom:7px;">Postać: —</div>
                    <div style="display:flex;gap:6px;align-items:center;">
                        <select id="e2-simple-select" style="flex:1;min-width:0;padding:6px;background:rgba(0,0,0,.3);border:1px solid rgba(255,255,255,.1);color:var(--text-main);border-radius:3px;font-size:11px;">
                            <option value="">Wybierz E2...</option>
                        </select>
                        <button id="e2-simple-add" style="padding:6px 10px;background:rgba(46,204,113,.12);border:1px solid rgba(46,204,113,.3);color:#5fd97a;border-radius:3px;cursor:pointer;font-size:11px;font-weight:700;">+ Dodaj</button>
                    </div>
                    <div style="display:flex;gap:6px;margin-top:7px;">
                        <button id="e2-simple-coords" style="flex:1;padding:5px 8px;background:rgba(52,152,219,.09);border:1px solid rgba(52,152,219,.25);color:#7ec8e3;border-radius:3px;cursor:pointer;font-size:10px;">📍 Zapisz koordy wybranej E2</button>
                    </div>
                    <div id="e2-simple-msg" style="min-height:14px;font-size:10px;color:var(--text-muted);margin-top:5px;"></div>
                </div>
            </div>

            <div class="settings-card">
                <div class="card-body">
                    <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;">
                        <div>
                            <div style="font-size:11px;font-weight:700;color:var(--text-main);">Auto logowanie</div>
                            <div style="font-size:10px;color:var(--text-muted);margin-top:2px;line-height:1.35;">OFF = Speedy nie zmieni postaci ani nie wyjdzie offline. Możesz spokojnie przełączać postacie i dodawać kolejne E2.</div>
                        </div>
                        <div id="set-e2AutoLoginSimple" class="toggle-button-small off">OFF</div>
                    </div>
                </div>
            </div>

            <div class="settings-card">
                <div class="card-body">
                    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
                        <div style="font-size:11px;font-weight:700;color:#c9a465;">PODGLĄD KOLEJKI</div>
                        <button id="e2-simple-refresh" style="background:none;border:1px solid rgba(255,255,255,.1);color:#777;border-radius:3px;cursor:pointer;font-size:11px;padding:2px 7px;">↺</button>
                    </div>
                    <div id="e2-simple-list" style="display:flex;flex-direction:column;gap:5px;"></div>
                </div>
            </div>
        </div>`;
    };

    function fillSelect() {
        const sel = document.getElementById('e2-simple-select');
        if (!sel) return;
        const cur = sel.value;
        sel.innerHTML = '<option value="">Wybierz E2...</option>';
        for (const e of (window._uiCacheData?.e2 || [])) {
            const o = document.createElement('option');
            o.value = e.key;
            o.textContent = `[${e.level}] ${e.name} — ${e.map_name}`;
            if (cur === e.key) o.selected = true;
            sel.appendChild(o);
        }
    }

    function refresh(gui) {
        const hero = currentHero();
        const q = loadQueue();
        const all = window._uiCacheData?.e2 || [];
        const autoe2 = window._uiCacheData?.autoe2;
        const charEl = document.getElementById('e2-current-char');
        if (charEl) charEl.textContent = hero ? `Postać: ${hero.nick}  •  ${hero.charId}` : 'Postać: —';

        const enabled = localStorage.getItem(GLOBAL_ENABLED_KEY) === '1';
        const autoLogin = localStorage.getItem(GLOBAL_AUTOLOGIN_KEY) === '1';
        if (gui?.settings) {
            gui.settings.e2Enabled = enabled;
            gui.settings.e2AutoLogin = autoLogin;
        }
        const en = document.getElementById('set-e2Enabled');
        if (en) { en.className = `toggle-button-e2 ${enabled ? 'on' : 'off'}`; en.textContent = enabled ? 'ON' : 'OFF'; }
        const al = document.getElementById('set-e2AutoLoginSimple');
        if (al) { al.className = `toggle-button-small ${autoLogin ? 'on' : 'off'}`; al.textContent = autoLogin ? 'ON' : 'OFF'; }

        const status = document.getElementById('e2-simple-status');
        if (status) {
            const myIdx = findEntryIndexForHero(q, hero);
            if (!enabled) { status.textContent = 'Wyłączone'; status.style.color = 'var(--text-muted)'; }
            else if (myIdx < 0 || !(q[myIdx].e2Keys || []).length) { status.textContent = 'Aktualna postać nie jest jeszcze w kolejce'; status.style.color = '#e8a020'; }
            else if (!autoLogin) { status.textContent = 'Aktywne • bez automatycznego logowania'; status.style.color = '#7ec8e3'; }
            else { status.textContent = 'Aktywne • auto logowanie ON'; status.style.color = '#5fd97a'; }
        }

        const list = document.getElementById('e2-simple-list');
        if (!list) return;
        list.innerHTML = '';
        const rows = [];
        q.forEach((entry, charIdx) => (entry.e2Keys || []).forEach((key, e2Idx) => rows.push({entry,charIdx,key,e2Idx})));
        if (!rows.length) {
            list.innerHTML = '<div style="color:var(--text-muted);font-size:11px;text-align:center;padding:10px;border:1px dashed rgba(255,255,255,.08);border-radius:4px;">Kolejka pusta</div>';
            return;
        }
        rows.forEach(({entry,charIdx,key,e2Idx}) => {
            const e = all.find(x => x.key === key);
            const isMe = hero && findEntryIndexForHero([entry], hero) === 0;
            let timer = '';
            try {
                const sec = autoe2?.secondsToMinResp?.(key) || 0;
                timer = sec > 0 ? `⏱ ${fmt(sec)}` : '✓';
            } catch (_) {}
            const c = entry.coords?.[key];
            const row = document.createElement('div');
            row.style.cssText = `display:flex;align-items:center;gap:6px;padding:6px 7px;border-radius:4px;background:${isMe?'rgba(201,164,101,.07)':'rgba(255,255,255,.025)'};border:1px solid ${isMe?'rgba(201,164,101,.25)':'rgba(255,255,255,.06)'};font-size:10px;`;
            const who = document.createElement('span');
            who.style.cssText = 'width:95px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#7ec8e3;';
            who.textContent = `${isMe?'▶ ':''}${entry.nick || '?'}`;
            row.appendChild(who);
            const name = document.createElement('span');
            name.style.cssText = 'flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#ddd;';
            name.textContent = e ? e.name : key;
            name.title = e ? e.map_name : key;
            row.appendChild(name);
            if (c) {
                const cc = document.createElement('span'); cc.style.color='#7ec8e3'; cc.textContent=`📍${c.x},${c.y}`; cc.title=`Mapa ${c.mapId}`; row.appendChild(cc);
            }
            if (timer) { const t=document.createElement('span'); t.style.color='#888'; t.textContent=timer; row.appendChild(t); }
            const del=document.createElement('button'); del.textContent='✖'; del.title='Usuń z kolejki'; del.style.cssText='background:none;border:none;color:#c0392b;cursor:pointer;font-size:11px;padding:0 2px;';
            del.onclick=()=>{ const qq=loadQueue(); if(!qq[charIdx]) return; qq[charIdx].e2Keys.splice(e2Idx,1); if(qq[charIdx].coords) delete qq[charIdx].coords[key]; if(!qq[charIdx].e2Keys.length) qq.splice(charIdx,1); saveQueue(qq); refresh(gui); };
            row.appendChild(del);
            list.appendChild(row);
        });
    }

    function bind(gui) {
        fillSelect();
        refresh(gui);
        const al = document.getElementById('set-e2AutoLoginSimple');
        if (al && !al.__simpleE2Bound) {
            al.__simpleE2Bound = true;
            al.addEventListener('click', () => {
                const next = localStorage.getItem(GLOBAL_AUTOLOGIN_KEY) !== '1';
                localStorage.setItem(GLOBAL_AUTOLOGIN_KEY, next ? '1' : '0');
                if (!next) { try { window.__speedyE2SchedulerStore?.clear?.(); } catch (_) {} }
                if (gui?.settings) { gui.settings.e2AutoLogin = next; gui.saveSettings?.(); }
                refresh(gui);
            });
        }
        const add = document.getElementById('e2-simple-add');
        if (add && !add.__simpleE2Bound) {
            add.__simpleE2Bound = true;
            add.addEventListener('click', () => {
                const hero = currentHero();
                const sel = document.getElementById('e2-simple-select');
                const msg = document.getElementById('e2-simple-msg');
                if (!hero || !sel?.value) { if(msg) msg.textContent='Wybierz E2.'; return; }
                const q = loadQueue();
                const idx = ensureHeroEntry(q, hero);
                if (!q[idx].e2Keys.includes(sel.value)) q[idx].e2Keys.push(sel.value);
                saveQueue(q);
                if (msg) { msg.style.color='#5fd97a'; msg.textContent=`Dodano ${sel.options[sel.selectedIndex]?.textContent || sel.value} dla ${hero.nick}.`; }
                refresh(gui);
            });
        }
        const coords = document.getElementById('e2-simple-coords');
        if (coords && !coords.__simpleE2Bound) {
            coords.__simpleE2Bound = true;
            coords.addEventListener('click', () => {
                const hero = currentHero();
                const sel = document.getElementById('e2-simple-select');
                const msg = document.getElementById('e2-simple-msg');
                const e = (window._uiCacheData?.e2 || []).find(x => x.key === sel?.value);
                if (!hero || !e) { if(msg) msg.textContent='Najpierw wybierz E2.'; return; }
                const mapId = Number(Engine?.map?.d?.id || 0);
                if (mapId !== Number(e.map_id)) {
                    if (msg) { msg.style.color='#e8a020'; msg.textContent=`Koordy można zapisać tylko na mapie ${e.name}: ${e.map_name}.`; }
                    return;
                }
                const q = loadQueue();
                const idx = ensureHeroEntry(q, hero);
                if (!q[idx].e2Keys.includes(e.key)) q[idx].e2Keys.push(e.key);
                q[idx].coords = q[idx].coords || {};
                q[idx].coords[e.key] = { mapId, x:Number(Engine.hero.d.x), y:Number(Engine.hero.d.y), savedAt:Date.now() };
                saveQueue(q);
                if (msg) { msg.style.color='#7ec8e3'; msg.textContent=`Zapisano ${e.name}: ${Engine.hero.d.x}, ${Engine.hero.d.y}.`; }
                refresh(gui);
            });
        }
        const rf = document.getElementById('e2-simple-refresh');
        if (rf && !rf.__simpleE2Bound) { rf.__simpleE2Bound=true; rf.onclick=()=>{ fillSelect(); refresh(gui); }; }
    }

    function wait() {
        const gui = window._uiCacheData?.gui;
        const tab = document.getElementById('tab-e2');
        if (gui && tab) bind(gui);
        setTimeout(wait, 1000);
    }
    setTimeout(wait, 1000);

    // API wykorzystywane także przez starsze miejsca GUI; teraz tylko odświeża prostą kolejkę.
    window._e2RosterRefresh = () => refresh(window._uiCacheData?.gui);
    window._e2DashboardRefresh = window._e2RosterRefresh;
    window._rosterAdd = function(nick, charId, world) {
        const q=loadQueue();
        const fake={nick:String(nick||''),charId:Number(charId||0),world:world||null};
        if(!fake.nick) return false;
        ensureHeroEntry(q,fake); saveQueue(q); refresh(window._uiCacheData?.gui); return true;
    };
})();
