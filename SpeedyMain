    let _cachedBestTarget = null;
    let _cachedBestPath   = null;
    let _lastBestTargetAt = 0;
    const BEST_TARGET_CACHE_MS = 450;

    let _exhaustionAfkMode = false;
    let _lastClanExhaustionTry = 0;
    const EXHAUSTION_AFK_MAPS = [2517, 23, 24, 215, 216, 74];

    function _getGraphDistance(fromMapId, toMapId) {
        if (fromMapId == toMapId) return 0;
        const MAP_GRAPH = window._uiCacheData.graph || {};
        const from = String(fromMapId);
        const to   = String(toMapId);
        const queue   = [[from, 0]];
        const visited = new Set([from]);
        while (queue.length > 0) {
            const [curr, dist] = queue.shift();
            for (const n of (MAP_GRAPH[curr] || [])) {
                const nStr = String(n);
                if (nStr === to) return dist + 1;
                if (!visited.has(nStr)) { visited.add(nStr); queue.push([nStr, dist + 1]); }
            }
        }
        return Infinity;
    }

    function findAbsoluteBestTarget(config) {
        if (!Engine || !Engine.map || !Engine.hero) return { target: null, path: null };
        const now = Date.now();

        if (_cachedBestTarget && !isMobAliveAndFree(_cachedBestTarget.id)) {
            _cachedBestTarget = null;
            _lastBestTargetAt = 0;
        }

        if (_cachedBestTarget && (now - _lastBestTargetAt) < BEST_TARGET_CACHE_MS) {
            return { target: _cachedBestTarget, path: _cachedBestPath };
        }

        for (let k in blacklistedMobs) {
            if (now - blacklistedMobs[k] > 60000) delete blacklistedMobs[k];
        }
        for (let k in recentlyDeadMobs) {
            if (now - recentlyDeadMobs[k] > DEAD_MOB_GRACE_MS) delete recentlyDeadMobs[k];
        }

        updateMobMemory(config);

        const mapId = Engine.map.d.id;
        ensureMapMemory(mapId);

        for (let gId in contaminatedGroupsMemory[mapId]) {
            if (now - contaminatedGroupsMemory[mapId][gId] > MOB_MEMORY_AGE_MS) {
                delete contaminatedGroupsMemory[mapId][gId];
            }
        }

        if (Engine && Engine.npcs) {
            const liveNpcs = typeof Engine.npcs.check === 'function' ? Engine.npcs.check() : Engine.npcs.d;
            for (let k in liveNpcs) {
                let n = liveNpcs[k].d || liveNpcs[k];
                if (!n || !n.grp) continue;
                if (n.dead || n.hp === 0 || n.st === 1 || n.st === 2 || n.st === 3) continue;
                if (n.type !== 2 && n.type !== 3 && n.type !== 9) continue;
                if (recentlyDeadMobs[n.id] && now - recentlyDeadMobs[n.id] < DEAD_MOB_GRACE_MS) continue;

                if (!isMobAllowed({ lvl: n.lvl, wt: n.wt }, config)) {
                    contaminatedGroupsMemory[mapId][String(n.grp)] = now;
                }
            }
        }

        const heroX = Engine.hero.d.x;
        const heroY = Engine.hero.d.y;
        const maxDist = (config.maxDistance || 50) * 2;

        if (Math.random() < 0.05) {
            for (let k in unreachableMobs) {
                if (now - unreachableMobs[k] > 10000) delete unreachableMobs[k];
            }
        }

        let allCandidates = [];
        if (mobMemory[mapId]) {
            for (let id in mobMemory[mapId]) allCandidates.push(mobMemory[mapId][id]);
        }

        let groups = {};
        let soloMobs = [];
        for (let mob of allCandidates) {
            if (mob.grp) {
                if (!groups[mob.grp]) groups[mob.grp] = [];
                groups[mob.grp].push(mob);
            } else { soloMobs.push(mob); }
        }

        let validTargets = [];

        for (let mob of soloMobs) {
            if (isMobAllowed(mob, config)) validTargets.push(mob);
        }

        for (let grpId in groups) {
            if (contaminatedGroupsMemory[mapId][String(grpId)]) {
                continue;
            }

            let grpArr = groups[grpId];
            if (grpArr.every(m => isMobAllowed(m, config))) {
                validTargets.push(...grpArr);
            }
        }

        // v24: wybór po REALNYM koszcie BFS + lekki look-ahead na następny cel.
        // Nie robimy pełnego TSP. Najpierw liczymy realny koszt dojścia do każdego moba,
        // a potem tylko dla kilku najlepszych kandydatów sprawdzamy, czy po walce nie
        // zostaniemy na "ślepym końcu" mapy.
        const reachable = [];

        for (let target of validTargets) {
            if (unreachableMobs[target.id] && now - unreachableMobs[target.id] < 10000) continue;
            if (Math.max(Math.abs(heroX - target.x), Math.abs(heroY - target.y)) > maxDist) continue;

            const path = findPathBFS(heroX, heroY, target.x, target.y, maxDist, true);
            if (path !== null) {
                reachable.push({ target, path, pathLen: path.length });
            } else {
                unreachableMobs[target.id] = now;
            }
        }

        reachable.sort((a,b) => a.pathLen - b.pathLen);
        let best = reachable[0] || null;

        if (reachable.length > 1 && best) {
            const shortest = best.pathLen;
            const shortlist = reachable.filter(c => c.pathLen <= shortest + 7).slice(0, 6);
            let bestScore = Infinity;

            for (const cand of shortlist) {
                const end = cand.path.length ? cand.path[cand.path.length - 1] : {x:heroX,y:heroY};
                let nextCost = Infinity;

                for (const other of shortlist) {
                    if (other.target.id === cand.target.id) continue;
                    // Grupa zwykle znika w jednej walce, więc nie premiujemy kolejnego moba z tej samej grupy.
                    if (cand.target.grp && other.target.grp && String(cand.target.grp) === String(other.target.grp)) continue;
                    const p2 = findPathBFS(end.x, end.y, other.target.x, other.target.y, Math.min(maxDist, 80), true);
                    if (p2 !== null && p2.length < nextCost) nextCost = p2.length;
                }

                const follow = Number.isFinite(nextCost) ? Math.min(nextCost, 18) : 12;
                // Pierwszy cel nadal ma największą wagę; look-ahead może uzasadnić tylko niewielki objazd.
                const score = cand.pathLen + follow * 0.32;
                if (score < bestScore) { bestScore = score; best = cand; }
            }
        }

        const bestTarget = best ? best.target : null;
        const shortestPath = best ? best.path : null;
        _cachedBestTarget = bestTarget;
        _cachedBestPath   = shortestPath;
        _lastBestTargetAt = now;

        return { target: bestTarget, path: shortestPath };
    }

