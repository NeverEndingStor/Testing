    // ─── ZWÓJ DO SPRZEDAŻY (zwój otwierający sklep / kupca / handlarza) ───────
    // Logika oparta o dokument: szukamy przedmiotu, którego nazwa zawiera
    // "sklep"/"kupiec"/"handlarz" LUB którego stat zawiera "action=shop".
   function findShopScrollItem() {
        if (!Engine || !Engine.heroEquipment || typeof Engine.heroEquipment.getHItems !== 'function') return null;
        const items = Engine.heroEquipment.getHItems();

        for (const id in items) {
            const item = items[id];
            if (!item || !isItemInInventory(item)) continue;
            // USUNIĘTO BŁĄD: if (isProtectedSupplyItem(item, config)) continue;

            const nameLower = (item.name || (item.getName && item.getName()) || (item.d && item.d.name) || '').toLowerCase();
            const rawStat = (item.stat || (item.d && item.d.stat) || '').toLowerCase();
            const cachedAction = item._cachedStats && item._cachedStats.action;

            if (
                nameLower.includes('sklep') ||
                nameLower.includes('kupiec') ||
                nameLower.includes('handlarz') ||
                rawStat.includes('action=shop') ||
                cachedAction === 'shop'
            ) {
                return item;
            }
        }
        return null;
    }

    function hasShopScroll() {
        return findShopScrollItem() !== null;
    }

    async function useShopScroll() {
        const scrollItem = findShopScrollItem();
        if (!scrollItem) return false;
        try {
            if (typeof Engine.heroEquipment.sendUseRequest === 'function') Engine.heroEquipment.sendUseRequest(scrollItem);
            else if (typeof scrollItem.createUseItem === 'function') scrollItem.createUseItem();
            else window._g('moveitem&st=1&id=' + (scrollItem.id || (scrollItem.d && scrollItem.d.id)));
            return true;
        } catch (e) {
            return false;
        }
    }

    // Sprzedaje wszystkie kwalifikujące się itemy (logika identyczna jak w handleAutoSell).
    // Zwraca liczbę sprzedanych itemów (lub 0 jeśli nic nie sprzedano).
    async function sellAllQualifyingItems(config) {
        const items = typeof Engine.heroEquipment.getHItems === 'function' ? Engine.heroEquipment.getHItems() : {};
        let itemsToSellIds = [];

        for (const key in items) {
            const item = items[key];
            if (!isItemInInventory(item)) continue;
            if (isProtectedSupplyItem(item, config)) continue;
            const name = (item.name || (item.getName && item.getName()) || (item.d && item.d.name) || '').toLowerCase();
            const cl = item.cl !== undefined ? item.cl : (item.d && item.d.cl);

            if (!allowedClasses.includes(cl)) continue;

            try {
                if (typeof item.issetQuestStat === 'function' && item.issetQuestStat()) continue;
                if (typeof item.issetSoulboundStat === 'function' && item.issetSoulboundStat()) continue;
                if (typeof item.issetPermboundStat === 'function' && item.issetPermboundStat()) continue;
            } catch(e) {}

            if (name.includes('zwój') || name.includes('zwoj') || name.includes('teleport')) continue;
            if (name.includes('sklep') || name.includes('kupiec') || name.includes('handlarz')) continue;
            if (name.includes('remedium') || name.includes('eliksir') || name.includes('ampułka') || name.includes('wyciąg') || name.includes('mikstura') || name.includes('napar') || name.includes('odtrutka')) continue;

            const statString = (item.stat || (item.d && item.d.stat) || '');
            // dodatkowe bezpieczeństwo: jeśli stat ma action=shop – pomiń (to zwój)
            if (statString.toLowerCase().includes('action=shop')) continue;

            const { isHeroic, isLegend, isUnique } = getItemTier(statString);

            if (isHeroic || isLegend) continue;
            if (isUnique && !config.sellUniques) continue;
            if (!isUnique && config.auctionAutoList && config.auctionFilterNormal) continue;

            itemsToSellIds.push(item.id || item.d.id);
        }

        if (itemsToSellIds.length > 0) {
            const MAX_ITEMS_PER_REQUEST = 20;
            for (let i = 0; i < itemsToSellIds.length; i += MAX_ITEMS_PER_REQUEST) {
                const chunk = itemsToSellIds.slice(i, i + MAX_ITEMS_PER_REQUEST);
                window._g('shop&buy=&sell=' + chunk.join(','));
                await delay(1000);
            }
        }

        return itemsToSellIds.length;
    }

    // ─────────────────────────────────────────────────────────────────────────
    //  handleScrollSell – sprzedaż przez zwój handlowy BEZ ruszania się z mapy
    //  Używana tylko gdy: ekwipunek pełny + opcja useSellScroll = ON + jest zwój
    //  Po sprzedaży bot natychmiast wraca do expienia (ta sama mapa).
    // ─────────────────────────────────────────────────────────────────────────
    async function handleScrollSell(config) {
        if (!config || !config.autoSell || !config.useSellScroll) return false;
        if (sellInProgress) return true;
        if (window._uiCacheData._auctionRunning) return true;
        if (!Engine || !Engine.heroEquipment) return false;

        // Tylko gdy plecak jest faktycznie pełny.
        if (!isBagFull()) return false;

        // Czy w ogóle mamy co sprzedać?
        if (!hasItemsToSell(config)) {
            if (window._uiCacheData.gui) window._uiCacheData.gui.updateStatus('Plecak pełny (brak śmieci do sprzedaży)!', '#e74c3c');
            return false;
        }

        // Zwój musi być w torbie.
        const scrollItem = findShopScrollItem();
        if (!scrollItem) return false;

        // Nie używaj zwoju gdy jest aktywna walka – poczekaj.
        if (Engine.battle && Engine.battle.getShow && Engine.battle.getShow()) return false;

        sellInProgress = true;
        try {
            if (window._uiCacheData.gui) window._uiCacheData.gui.updateStatus('Używam zwoju kupca...', '#f39c12');

            // Zapamiętaj mapę – musimy zostać tu po sprzedaży.
            const startMapId = Engine.map.d.id;

            // Użyj zwoju.
            const used = await useShopScroll();
            if (!used) {
                sellInProgress = false;
                return false;
            }

            // Czekamy aż otworzy się okno sklepu (zwój NIE zmienia mapy).
            let shopOpened = false;
            for (let i = 0; i < 50; i++) {
                await delay(100);
                try {
                    if (document.querySelector('.shop-background') || (Engine.shop && typeof Engine.shop.getItems === 'function' && Engine.shop.getItems && Object.keys(Engine.shop.getItems() || {}).length > 0)) {
                        shopOpened = true;
                        break;
                    }
                } catch(e) {}
            }

            if (!shopOpened) {
                if (window._uiCacheData.gui) window._uiCacheData.gui.updateStatus('Zwój: sklep nie otworzył się.', '#e74c3c');
                sellInProgress = false;
                return false;
            }
            await delay(400);

            // Sprzedaj.
            if (window._uiCacheData.gui) window._uiCacheData.gui.updateStatus('Sprzedaż przez zwój...', '#e67e22');
            const sold = await sellAllQualifyingItems(config);

            if (sold > 0) {
                if (window._uiCacheData.gui) window._uiCacheData.gui.updateStatus(`Sprzedano ${sold} itemów (zwój)!`, '#98c379');
            }

            // UWAGA: NIE kupujemy potek ani innych rzeczy – wymóg użytkownika.

            // Zamknij okno alertu, jeżeli jest.
            const alertOkBtn = document.querySelector('.mAlert .button, .mAlert .alert-accept-hotkey');
            if (alertOkBtn) {
                try { alertOkBtn.click(); } catch(e) {}
                await delay(200);
            }

            // Zamknij sklep.
            try { if (Engine.shop && typeof Engine.shop.close === 'function') Engine.shop.close(); } catch(e) {}
            await delay(600);

            // Bezpiecznik: jeśli mapa się zmieniła (nie powinno się zdarzyć dla zwoju shop),
            // zaloguj i pozwól reszcie logiki bota wrócić na mapę expu.
            if (parseInt(Engine.map.d.id) !== parseInt(startMapId)) {
                if (window._uiCacheData.gui) window._uiCacheData.gui.updateStatus('Zwój zmienił mapę – wracam...', '#e67e22');
            } else {
                if (window._uiCacheData.gui) window._uiCacheData.gui.updateStatus('Sprzedaż zakończona – wracam do expu.', '#27ae60');
            }
        } catch (e) {
            // ignoruj
        } finally {
            sellInProgress = false;
            lastShopVisitTime = Date.now();
        }
        return true;
    }

    async function navigateToMap(targetMapId, findPathBFS, walkSmoothly, getNextHopMap, setMapChangeCooldown) {
        let safety = 30;
        let config = window._uiCacheData.gui ? window._uiCacheData.gui.getSettings() : {};

        const resolveTransition = (nextHopMapId) => {
            const exp = window._uiCacheData.exp;
            if (exp && typeof exp.getAllMapTransitions === 'function' && typeof exp.checkGatewayReachability === 'function') {
                const transitions = exp.getAllMapTransitions() || [];
                const exact = transitions.filter(t => Number(t.affected) === Number(nextHopMapId));
                const hidden = transitions.filter(t => t.type === 'npc' && !t.affected);
                for (const t of [...exact, ...hidden]) {
                    const reach = exp.checkGatewayReachability(t.x, t.y, t.type);
                    if (reach) return { coords: reach.coords, path: reach.path, data: t };
                }
            }

            // Fallback kompatybilności dla bardzo starego Engine.
            try {
                const g = Engine.map.gateways;
                const gwList = typeof g?.getList === 'function' ? g.getList() : (g?.list || g || []);
                for (const id in gwList) {
                    const d = gwList[id].d || gwList[id];
                    const aff = d.affectedId || (d.target && d.target.map) || d.id;
                    if (Number(aff) === Number(nextHopMapId)) {
                        const path = findPathBFS(Engine.hero.d.x, Engine.hero.d.y, d.x, d.y, 2000);
                        if (path !== null) return { coords: {x:d.x,y:d.y}, path, data:{type:'physical',x:d.x,y:d.y,affected:Number(aff),id:d.id} };
                    }
                }
            } catch(e) {}
            return null;
        };

        while (parseInt(Engine.map.d.id) !== parseInt(targetMapId) && safety-- > 0) {
            await waitForBattleEnd();
            let currentTarget = targetMapId;

            if (window._uiCacheData.tp) {
                let astralResult = await window._uiCacheData.tp.processAstralTeleport(targetMapId, config, setMapChangeCooldown);
                if (astralResult) {
                    if (astralResult.action === 'HANDLED') {
                        if (parseInt(Engine.map.d.id) === parseInt(targetMapId)) return true;
                        continue;
                    }
                    if (astralResult.action === 'WALK_TO') currentTarget = astralResult.targetMapId;
                }
            }

            const nextHopMapId = getNextHopMap(Engine.map.d.id, currentTarget);
            if (!nextHopMapId) return false;
            const tr = resolveTransition(nextHopMapId);
            if (!tr) return false;

            let reachedGateway = false;
            for (let walkAttempt = 0; walkAttempt < 5; walkAttempt++) {
                await waitForBattleEnd();
                const curDist = Math.max(Math.abs(Engine.hero.d.x - tr.coords.x), Math.abs(Engine.hero.d.y - tr.coords.y));
                if (curDist <= 1) { reachedGateway = true; break; }
                const path = findPathBFS(Engine.hero.d.x, Engine.hero.d.y, tr.coords.x, tr.coords.y, 2000);
                if (!path || path.length === 0) { await delay(250); continue; }
                await walkSmoothly(path);
            }
            if (!reachedGateway) return false;

            if (typeof setMapChangeCooldown === 'function') setMapChangeCooldown(true);
            const oldMapId = Number(Engine.map.d.id);

            if (tr.data && tr.data.type === 'npc' && window._uiCacheData.exp?.processNpcGateway) {
                await window._uiCacheData.exp.processNpcGateway(tr.data, delay);
            } else {
                let naturalWait = 0;
                while (Number(Engine.map.d.id) === oldMapId && naturalWait < 8) { await delay(75); naturalWait++; }
                if (Number(Engine.map.d.id) === oldMapId && typeof Engine.hero.getTroughGateway === 'function') {
                    try { Engine.hero.getTroughGateway(); } catch(e) {}
                }
            }

            let timeout = 0;
            while (Number(Engine.map.d.id) === oldMapId && timeout < 60) { await delay(75); timeout++; }
            await delay(180);
            if (typeof setMapChangeCooldown === 'function') setMapChangeCooldown(false);
            if (Number(Engine.map.d.id) === oldMapId) return false;
        }
        return parseInt(Engine.map.d.id) === parseInt(targetMapId);
    }

    function findBestVendor(targetType, config, startMapId, heroLevel) {
        const validVendors = [];
        const VENDOR_DATA = window._uiCacheData.vendors || {};
        for (const key in VENDOR_DATA) {
            const v = VENDOR_DATA[key];
            if (v.type && v.type.includes(targetType) && (!v.min_level || heroLevel >= v.min_level)) {
                validVendors.push(v);
            }
        }
        if (config.useTownScroll) {
            for (const v of validVendors) {
                if (v.teleport_scroll_name && countItemInBag(v.teleport_scroll_name) > 0) {
                    return v;
                }
            }
        }
        let queue = [ {id: parseInt(startMapId), dist: 0} ];
        let visited = new Set([parseInt(startMapId)]);
        while(queue.length > 0) {
            let curr = queue.shift();
            for (const v of validVendors) {
                if (parseInt(v.map_id) === curr.id) return v;
            }
            let neighbors = (window._uiCacheData.graph && window._uiCacheData.graph[curr.id]) || [];
            for(let n of neighbors) {
                if(!visited.has(n)) {
                    visited.add(n);
                    queue.push({id: n, dist: curr.dist + 1});
                }
            }
        }
        return validVendors[0] || null;
    }

