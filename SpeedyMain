        }

        for (let k in npcs) {
            let npc = npcs[k].d || npcs[k];
            if (!npc || npc.dead || npc.hp === 0 || npc.st === 1 || npc.st === 2) continue;
            if (fightingMobs.has(npc.id) || fightingMobs.has(String(npc.id))) continue;
            const npcNick = cleanName(npc.nick || npc.name || '');
            if (npcNick === cleanTargetName || npcNick.includes(cleanTargetName) || cleanTargetName.includes(npcNick)) {
                return npc;
            }
        }
        return null;
    }

    function findLiveE2GroupMembers(e2Npc) {
        const members = [e2Npc];
        if (!Engine || !Engine.npcs || !e2Npc) return members;

        const e2Grp = e2Npc.grp !== undefined && e2Npc.grp !== null ? String(e2Npc.grp) : '';
        if (!e2Grp || e2Grp === '0') return members;

        const npcs = typeof Engine.npcs.check === 'function' ? Engine.npcs.check() : Engine.npcs.d;

        let fightingMobs = new Set();
        if (window._uiCacheData.exp && typeof window._uiCacheData.exp.getFightingMobIds === 'function') {
            fightingMobs = window._uiCacheData.exp.getFightingMobIds();
        }

        const seen = new Set([String(e2Npc.id)]);
        for (let k in npcs) {
            let npc = npcs[k].d || npcs[k];
            if (!npc || !npc.id) continue;
            if (seen.has(String(npc.id))) continue;
            if (npc.dead || npc.hp === 0 || npc.st === 1 || npc.st === 2) continue;
            if (fightingMobs.has(npc.id) || fightingMobs.has(String(npc.id))) continue;
            if (npc.type !== undefined && parseInt(npc.type) === 4) continue;

            const npcGrp = npc.grp !== undefined && npc.grp !== null ? String(npc.grp) : '';
            if (npcGrp !== e2Grp) continue;

            const dist = chebyshev(npc.x, npc.y, e2Npc.x, e2Npc.y);
            if (dist > E2_GROUP_RADIUS) continue;

            members.push(npc);
            seen.add(String(npc.id));
        }
        return members;
    }

    function pickClosestGroupMember(e2Npc) {
        const members = findLiveE2GroupMembers(e2Npc);
        const pos = heroPos();
        let best = e2Npc;
        let bestDist = chebyshev(pos.x, pos.y, e2Npc.x, e2Npc.y);
        for (const m of members) {
            const d = chebyshev(pos.x, pos.y, m.x, m.y);
            if (d < bestDist || (d === bestDist && m.id === e2Npc.id)) {
                bestDist = d;
                best = m;
            }
        }
        return {
            attackTarget: best,
            e2Npc,
            groupIds: members.map(m => String(m.id)),
            grp: e2Npc.grp || null
        };
    }

