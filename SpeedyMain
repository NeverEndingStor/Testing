        let standSpot = null;
        for (const d of [{x:0,y:-1},{x:0,y:1},{x:-1,y:0},{x:1,y:0}]) {
            try {
                if (!Engine.map.col.check(gatewayNpc.x + d.x, gatewayNpc.y + d.y)) {
