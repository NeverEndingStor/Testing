// --- START OF FILE autoislands.js ---

(function () {
    if (!window._uiCacheData) window._uiCacheData = {};

    // ─────────────────────────────────────────────────────────────
    //  STAŁE
    // ─────────────────────────────────────────────────────────────
    const GATEWAY_MAP_ID          = 630;    // Mapa z NPC przeprawy (Port Tuzmer)
    const GATEWAY_NPC_TPL         = 38389;  // npc38389
    const FLYING_DUTCHMAN_MAP_ID  = 4391;   // Latający Holender
    const FLYING_DUTCHMAN_NPC_TPL = 178096; // npc178096 – kapitan statku
    const RESPAWN_MAP_ID          = 1737;   // Mapa respawnu po śmierci na wyspie
    const RESPAWN_NPC_ID          = 323846; // NPC na mapie respawnu (id, nie tpl)

    /**
     * Mapy docelowe przeprawy i indeks opcji dialogowej (0-based).
     * Kolejność opcji NPC:
     *   0 → Archipelag Bremus An (1739)
     *   1 → Wyspa Ingotia        (1740)
     *   2 → Wyspa Rem            (1741)
     *   3 → Wyspa Caneum         (1742)
     *   4 → Wyspa Magradit       (1743)
     *   5 → Wyspa Wraków         (1744)
     *   6 → Agia Triada          (1738)
     */
    const ISLAND_ENTRANCES = {
        1739: { name: 'Archipelag Bremus An', dialogIndex: 0 },
        1740: { name: 'Wyspa Ingotia',        dialogIndex: 1 },
        1741: { name: 'Wyspa Rem',            dialogIndex: 2 },
        1742: { name: 'Wyspa Caneum',         dialogIndex: 3 }, // Stworzyciel
        1743: { name: 'Wyspa Magradit',       dialogIndex: 4 },
        1744: { name: 'Wyspa Wraków',         dialogIndex: 5 },
        1738: { name: 'Agia Triada',          dialogIndex: 6 }
    };

    /**
     * Pod-mapy wysp – mapy dostępne tylko poprzez wejście na wyspę.
     */
    const ISLAND_SUB_MAPS = {
        1739: [7353, 7354, 7355, 7356, 7357],
        1740: [7358, 7359, 7360, 7361, 7362, 7363, 7364, 7365, 7366, 7367, 7368],
        1741: [7369, 7370],
        1742: [7371, 7372, 7373, 7374, 7375], // 7375 to Grota Stworzyciela
        1743: [7055, 7056, 7057, 7058, 7059, 7060, 7061],
        1744: [4361, 4362, 7070, 7071],
        1738: []
    };

    // Odwrotny słownik: pod-mapa → mapa-wejście
    const SUB_MAP_TO_ENTRANCE = {};
    for (let entrance in ISLAND_SUB_MAPS) {
        ISLAND_SUB_MAPS[entrance].forEach(sub => {
            SUB_MAP_TO_ENTRANCE[sub] = parseInt(entrance);
        });
    }

    const delay = ms => new Promise(res => setTimeout(res, ms));

    // ─────────────────────────────────────────────────────────────
    //  HELPERS
    // ─────────────────────────────────────────────────────────────

    function isIslandMap(mapId) {
        mapId = parseInt(mapId);
        return (mapId in ISLAND_ENTRANCES) || (mapId in SUB_MAP_TO_ENTRANCE);
    }

    function getEntranceForMap(mapId) {
        mapId = parseInt(mapId);
        if (mapId in ISLAND_ENTRANCES) return mapId;
        if (mapId in SUB_MAP_TO_ENTRANCE) return SUB_MAP_TO_ENTRANCE[mapId];
        return null;
    }

    function isAlreadyOnIsland(targetEntranceId) {
        const currentMapId = parseInt(Engine.map.d.id);
        return getEntranceForMap(currentMapId) === targetEntranceId;
    }

    function findNpcByTpl(tpl) {
        if (!Engine || !Engine.npcs) return null;
        const npcs = Engine.npcs.check ? Engine.npcs.check() : Engine.npcs.d;
        for (let k in npcs) {
            let n = npcs[k].d || npcs[k];
            if (!n) continue;
            if (parseInt(n.tpl) === tpl || parseInt(n.id) === tpl) return n;
        }
        return null;
    }

    async function walkToNpc(npc) {
        const exp = window._uiCacheData.exp;
        if (!exp) return false;

        let standSpot = null;
        for (const d of [{ x: 0, y: -1 }, { x: 0, y: 1 }, { x: -1, y: 0 }, { x: 1, y: 0 }]) {
            try {
                if (!Engine.map.col.check(npc.x + d.x, npc.y + d.y)) {
                    standSpot = { x: npc.x + d.x, y: npc.y + d.y };
                    break;
                }
            } catch (e) {}
        }
        if (!standSpot) standSpot = { x: npc.x, y: npc.y };

        const path = exp.findPathBFS(Engine.hero.d.x, Engine.hero.d.y, standSpot.x, standSpot.y, 400);
        if (path && path.length > 0) {
            await exp.walkSmoothly(path);
            await delay(400);
        }
        return true;
    }

    function hasAliveMobs() {
        if (!Engine || !Engine.npcs) return false;
        const npcs = Engine.npcs.check ? Engine.npcs.check() : Engine.npcs.d;
        for (let k in npcs) {
            let n = npcs[k].d || npcs[k];
            if (!n) continue;
            if (n.dead || n.hp === 0 || n.st === 1 || n.st === 2) continue;
            if (n.type === 2 || n.type === 3) return true;
        }
        return false;
    }

    function getNearestAliveMob() {
        if (!Engine || !Engine.npcs || !Engine.hero) return null;
        const npcs = Engine.npcs.check ? Engine.npcs.check() : Engine.npcs.d;
        const hx = Engine.hero.d.x;
        const hy = Engine.hero.d.y;
        let best = null, bestDist = Infinity;

        for (let k in npcs) {
            let n = npcs[k].d || npcs[k];
            if (!n) continue;
            if (n.dead || n.hp === 0 || n.st === 1 || n.st === 2) continue;
            if (n.type !== 2 && n.type !== 3) continue;
            const dist = Math.max(Math.abs(hx - n.x), Math.abs(hy - n.y));
            if (dist < bestDist) { bestDist = dist; best = n; }
        }
        return best;
    }

    // ─────────────────────────────────────────────────────────────
    //  LATAJĄCY HOLENDER
    // ─────────────────────────────────────────────────────────────

    async function handleFlyingDutchman(setMapCooldown) {
        const gui = window._uiCacheData.gui;
        const exp = window._uiCacheData.exp;
        if (!exp) return false;

        if (gui) gui.updateStatus('⚓ Latający Holender! Wybieram potwory...', '#e74c3c');

        const TIMEOUT_TICKS = 1200;
        let ticks = 0;

        while (ticks < TIMEOUT_TICKS) {
            await delay(100);
            ticks++;

            if (parseInt(Engine.map.d.id) !== FLYING_DUTCHMAN_MAP_ID) return true;

            if (Engine.battle && Engine.battle.getShow()) continue;

            if (Engine.loots && Engine.loots.window && Engine.loots.window.length > 0) {
                Engine.loots.acceptLoot();
                await delay(200);
                continue;
            }

            if (!hasAliveMobs()) break;

            const mob = getNearestAliveMob();
            if (!mob) continue;

            const hx = Engine.hero.d.x;
            const hy = Engine.hero.d.y;
            const distToMob = Math.max(Math.abs(hx - mob.x), Math.abs(hy - mob.y));

            if (distToMob <= 1) {
                // Jesteśmy obok – od razu atakuj
                Engine.hero.heroAtackRequest(mob.id, true);
                await delay(300);
            } else {
                const path = exp.findPathBFS(hx, hy, mob.x, mob.y, 400, true);
                if (path && path.length > 0) {
                    await exp.walkSmoothly(path, mob.id, () => Engine.battle && Engine.battle.getShow());
                }
                // Po dojściu sprawdź odległość i zaatakuj
                const newDist = Math.max(Math.abs(Engine.hero.d.x - mob.x), Math.abs(Engine.hero.d.y - mob.y));
                if (newDist <= 1 && !(Engine.battle && Engine.battle.getShow())) {
                    Engine.hero.heroAtackRequest(mob.id, true);
                }
                await delay(300);
            }
        }

        if (hasAliveMobs()) {
            if (gui) gui.updateStatus('⚓ Holender: timeout walki!', '#e74c3c');
            return false;
        }

        if (gui) gui.updateStatus('⚓ Holender: szukam kapitana...', '#9b59b6');

        let npcWait = 0;
        let exitNpc = null;
        while (!exitNpc && npcWait < 40) {
            exitNpc = findNpcByTpl(FLYING_DUTCHMAN_NPC_TPL);
            if (!exitNpc) { await delay(500); npcWait++; }
        }

        if (!exitNpc) {
            if (gui) gui.updateStatus('⚓ Holender: nie znalazłem kapitana!', '#e74c3c');
            return false;
        }

        await walkToNpc(exitNpc);
        if (gui) gui.updateStatus('⚓ Holender: opuszczam statek...', '#27ae60');

        window._g('talk&id=' + (exitNpc.id || exitNpc.tpl));
        await delay(700);

        for (let step = 0; step < 4; step++) {
            await delay(500);
            const answers = document.querySelectorAll('.dialogue-window-answer');
            if (answers.length === 0) break;
            answers[0].click();
            await delay(300);
        }
        try { Engine.dialog && Engine.dialog.close && Engine.dialog.close(); } catch (e) {}

        if (typeof setMapCooldown === 'function') setMapCooldown(true);
        const oldMap = Engine.map.d.id;
        let waitMap = 0;
        while (parseInt(Engine.map.d.id) === parseInt(oldMap) && waitMap < 60) {
            await delay(100); waitMap++;
        }
        await delay(1500);
        if (typeof setMapCooldown === 'function') setMapCooldown(false);

        return parseInt(Engine.map.d.id) !== parseInt(oldMap);
    }

    // ─────────────────────────────────────────────────────────────
    //  OBSŁUGA RESPAWNU PO ŚMIERCI NA WYSPIE (mapa 1737)
    // ─────────────────────────────────────────────────────────────

    /**
     * Bot umarł na wyspie i respawnował na mapie 1737.
     * NPC 323846 oferuje:
     *   opcja 1 → teleport do Port Tuzmer (630)
     *   opcja 2 → podmenu wyboru wyspy (te same indeksy co ISLAND_ENTRANCES.dialogIndex)
     *             → po wyborze wyspy jeszcze jedno potwierdzenie (opcja 1)
     *
     * Jeśli targetEntranceId jest znany → płyniemy z powrotem na wyspę (opcja 2 + wyspa + potwierdź).
     * Jeśli nie → uciekamy do portu (opcja 1).
     */
    async function handleRespawnMap(targetEntranceId, setMapCooldown) {
        const gui = window._uiCacheData.gui;
        const exp = window._uiCacheData.exp;
        if (!exp) return false;

        if (gui) gui.updateStatus('💀 Respawn – szukam NPC powrotu...', '#e74c3c');

        // Znajdź NPC po id
        let respawnNpc = null;
        let npcWait = 0;
        while (!respawnNpc && npcWait < 40) {
            const npcs = Engine.npcs.check ? Engine.npcs.check() : Engine.npcs.d;
            for (let k in npcs) {
                const n = npcs[k].d || npcs[k];
                if (!n) continue;
                if (parseInt(n.id) === RESPAWN_NPC_ID || parseInt(n.tpl) === RESPAWN_NPC_ID) {
                    respawnNpc = n;
                    break;
                }
            }
            if (!respawnNpc) { await delay(500); npcWait++; }
        }

        if (!respawnNpc) {
            if (gui) gui.updateStatus('💀 Respawn: nie znalazłem NPC!', '#e74c3c');
            return false;
        }

        await walkToNpc(respawnNpc);
        window._g('talk&id=' + respawnNpc.id);
        await delay(700);

        const islandInfo = targetEntranceId ? ISLAND_ENTRANCES[targetEntranceId] : null;

        if (islandInfo) {
            // Opcja 2 → wracam na wyspę
            if (gui) gui.updateStatus('💀 Respawn – wracam na: ' + islandInfo.name, '#3498db');

            let answers = document.querySelectorAll('.dialogue-window-answer');
            if (answers.length < 2) {
                try { Engine.dialog && Engine.dialog.close && Engine.dialog.close(); } catch (e) {}
                return false;
            }
            answers[1].click(); // opcja 2
            await delay(600);

            // Podmenu z wyspami – wybierz właściwą
            answers = document.querySelectorAll('.dialogue-window-answer');
            if (answers.length <= islandInfo.dialogIndex) {
                try { Engine.dialog && Engine.dialog.close && Engine.dialog.close(); } catch (e) {}
                return false;
            }
            answers[islandInfo.dialogIndex].click();
            await delay(600);

            // Potwierdzenie (opcja 1)
            answers = document.querySelectorAll('.dialogue-window-answer');
            if (answers.length > 0) { answers[0].click(); await delay(600); }

        } else {
            // Opcja 1 → uciekam do portu
            if (gui) gui.updateStatus('💀 Respawn – wracam do portu...', '#f39c12');

            let answers = document.querySelectorAll('.dialogue-window-answer');
            if (answers.length === 0) {
                try { Engine.dialog && Engine.dialog.close && Engine.dialog.close(); } catch (e) {}
                return false;
            }
            answers[0].click(); // opcja 1
            await delay(600);

            // Drugie potwierdzenie (opcja 1)
            answers = document.querySelectorAll('.dialogue-window-answer');
            if (answers.length > 0) { answers[0].click(); await delay(600); }
        }

        try { Engine.dialog && Engine.dialog.close && Engine.dialog.close(); } catch (e) {}

        if (typeof setMapCooldown === 'function') setMapCooldown(true);
        const oldMap = RESPAWN_MAP_ID;
        let waitMap = 0;
        while (parseInt(Engine.map.d.id) === oldMap && waitMap < 80) {
            await delay(100); waitMap++;
        }
        await delay(1500);
        if (typeof setMapCooldown === 'function') setMapCooldown(false);

        return parseInt(Engine.map.d.id) !== oldMap;
    }

    // ─────────────────────────────────────────────────────────────
    //  GŁÓWNA FUNKCJA: PRZEPRAWA NA WYSPĘ
    // ─────────────────────────────────────────────────────────────

    async function processIslandTeleport(targetMapId, config, setMapCooldown) {
        if (!Engine || !Engine.map || !Engine.hero) return false;

        targetMapId = parseInt(targetMapId);
        const gui = window._uiCacheData.gui;

        const currentMapId = parseInt(Engine.map.d.id);

        // Respawn po śmierci na wyspie – mapa 1737
        if (currentMapId === RESPAWN_MAP_ID) {
            const entranceForTarget = getEntranceForMap(targetMapId);
            let result = await handleRespawnMap(entranceForTarget || null, setMapCooldown);
            return result ? { action: "HANDLED" } : false;
        }

        const entranceMapId = getEntranceForMap(targetMapId);
        if (!entranceMapId) return false;

        // Jeśli bot jest JUŻ NA WYSPIE, uwalniamy logikę aby AutoExp i AutoE2
        // odpaliły pathfindera i doszły z buta pod samą Elitę!
        if (isAlreadyOnIsland(entranceMapId)) return false;

        // Moduł NPC uruchamia się tylko z mapy 630. Dojście do 630 zrobi autoexp
        if (currentMapId !== GATEWAY_MAP_ID) return false;

        const ferryNpc = findNpcByTpl(GATEWAY_NPC_TPL);
        if (!ferryNpc) {
            if (gui) gui.updateStatus('⚓ Brak NPC przeprawy (tpl=' + GATEWAY_NPC_TPL + ')', '#e74c3c');
            return false;
        }

        const islandInfo = ISLAND_ENTRANCES[entranceMapId];
        if (gui) gui.updateStatus('⚓ Podchodzę do przeprawy → ' + islandInfo.name, '#9b59b6');

        await walkToNpc(ferryNpc);

        if (gui) gui.updateStatus('⚓ Płynę na: ' + islandInfo.name + '...', '#3498db');

        window._g('talk&id=' + (ferryNpc.id || ferryNpc.tpl));
        await delay(700);

        let answers = document.querySelectorAll('.dialogue-window-answer');
        if (answers.length === 0) return false;
        answers[0].click();
        await delay(600);

        answers = document.querySelectorAll('.dialogue-window-answer');
        if (answers.length <= islandInfo.dialogIndex) {
            try { Engine.dialog && Engine.dialog.close && Engine.dialog.close(); } catch (e) {}
            return false;
        }
        answers[islandInfo.dialogIndex].click();
        await delay(600);

        answers = document.querySelectorAll('.dialogue-window-answer');
        if (answers.length > 0) { answers[0].click(); await delay(600); }

        answers = document.querySelectorAll('.dialogue-window-answer');
        if (answers.length > 0) { answers[0].click(); await delay(600); }

        try { Engine.dialog && Engine.dialog.close && Engine.dialog.close(); } catch (e) {}

        if (typeof setMapCooldown === 'function') setMapCooldown(true);
        const oldMap = currentMapId;
        let waitMap = 0;
        while (parseInt(Engine.map.d.id) === oldMap && waitMap < 80) {
            await delay(100); waitMap++;
        }
        await delay(1500);
        if (typeof setMapCooldown === 'function') setMapCooldown(false);

        const newMapId = parseInt(Engine.map.d.id);

        if (newMapId === oldMap) {
            if (gui) gui.updateStatus('⚓ Przeprawa nie zadziałała!', '#e74c3c');
            return false;
        }

        if (newMapId === FLYING_DUTCHMAN_MAP_ID) {
            if (gui) gui.updateStatus('⚓ Latający Holender! Walczę...', '#e74c3c');
            let survived = await handleFlyingDutchman(setMapCooldown);
            return survived ? { action: "HANDLED" } : false; // POPRAWKA #2
        }

        if (gui) gui.updateStatus('⚓ Dotarłem na: ' + islandInfo.name + '!', '#27ae60');
        return { action: "HANDLED" }; // POPRAWKA #2
    }

    // ─────────────────────────────────────────────────────────────
    //  EKSPORT I INIEKCJA ŁATKI GRAFU
    // ─────────────────────────────────────────────────────────────
    window._uiCacheData.islands = {
        processIslandTeleport,
        isIslandMap,
        getEntranceForMap,
        handleFlyingDutchman,
        handleRespawnMap,
        GATEWAY_MAP_ID,
        FLYING_DUTCHMAN_MAP_ID,
        RESPAWN_MAP_ID,
        ISLAND_ENTRANCES
    };

    // POPRAWKA #3 (NAJWAŻNIEJSZA) - Zszycie Grafu Połączeń.
    // Bot domyślnie myślał, że wyspy "wiszą w próżni". Tworzymy sztuczne drogi w pamięci bota,
    // łącząc Port Tuzmer z wejściami na wyspy, co uwolni potęgę algorytmu wyznaczania ścieżek!
    (function patchIslandGraph() {
        const graph = window._uiCacheData.graph;
        if (!graph) return;
        for (let ent in ISLAND_ENTRANCES) {
            let entId = parseInt(ent);

            // Dodaj drogę z wyspy do portu (powrót)
            if (!graph[entId]) graph[entId] = [];
            if (!graph[entId].includes(GATEWAY_MAP_ID)) {
                graph[entId].push(GATEWAY_MAP_ID);
            }

            // Dodaj drogę z portu na wyspę (podróż z kontynentu)
            if (!graph[GATEWAY_MAP_ID]) graph[GATEWAY_MAP_ID] = [];
            if (!graph[GATEWAY_MAP_ID].includes(entId)) {
                graph[GATEWAY_MAP_ID].push(entId);
            }
        }

        // Mapa respawnu 1737 – przez NPC wraca do portu lub wyspy.
        // W grafie tylko wyjście: 1737 → 630 (port) i 1737 → każda wyspa.
        // Wejście na 1737 nie istnieje fizycznie – tylko przez śmierć.
        if (!graph[RESPAWN_MAP_ID]) graph[RESPAWN_MAP_ID] = [];
        if (!graph[RESPAWN_MAP_ID].includes(GATEWAY_MAP_ID)) {
            graph[RESPAWN_MAP_ID].push(GATEWAY_MAP_ID);
        }
        for (let ent in ISLAND_ENTRANCES) {
            let entId = parseInt(ent);
            if (!graph[RESPAWN_MAP_ID].includes(entId)) {
                graph[RESPAWN_MAP_ID].push(entId);
            }
        }
    })();

})();

