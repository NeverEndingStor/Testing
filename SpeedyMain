        // ── Status / Setup helpers ───────────────────────────────────────────
        updateStatus(text, color = "var(--text-muted)") {
            if (this.statusText) { this.statusText.innerText = text; this.statusText.style.color = color; }
        }

        updateUpgradeCounter(current, threshold) {
            const countEl = document.getElementById('upg-count');
            const textEl  = document.getElementById('upg-status-text');
            if (countEl) {
                countEl.textContent = `${current} / ${threshold}`;
                countEl.style.color = current >= threshold ? '#e5c07b' : '#00ff00';
            }
            if (textEl) {
                textEl.textContent = current >= threshold
                    ? 'Wysyłam pył do kowadła...'
                    : 'Zbieram śmieci...';
            }
        }

        updateUpgradeDailyLimit(usageValue) {
            const limitEl = document.getElementById('upg-daily-limit');
            if (limitEl) {
                limitEl.textContent = usageValue;
                if (usageValue >= 2000) {
                    limitEl.style.color = 'var(--accent-red)';
                } else if (usageValue >= 1900) {
                    limitEl.style.color = '#e5c07b'; // pomarańczowy, blisko końca
                } else {
                    limitEl.style.color = 'var(--accent-blue)';
                }
            }
        }

        updateSetupDropdown() {
            const sel = document.getElementById('set-activeSetup');
            if (!sel) return;
            sel.innerHTML = '';

            const filterByLevel = !!this.settings.filterSetupsByLevel;
            const playerLevel = (typeof Engine !== 'undefined' && Engine.hero && Engine.hero.d && Engine.hero.d.lvl)
                ? Engine.hero.d.lvl
                : (window._uiCacheData.playerLevel || 0);
            const allSetupData = window._uiCacheData.setups || {};

            const setupsKeys = Object.keys(this.settings.setups).filter(key => {
                if (!filterByLevel || playerLevel === 0) return true;
                const data = allSetupData[key];
                if (!data) return true;
                const min = data.minLevel || 0;
                const max = data.maxLevel || 9999;
                if (playerLevel >= 249) return max >= 249 || min >= 249;
                return max >= playerLevel - 20 && min <= playerLevel + 20;
            });

            setupsKeys.forEach(key => {
                const opt = document.createElement('option');
                opt.value = key; opt.innerText = key;
                if (this.settings.activeSetup === key) opt.selected = true;
                sel.appendChild(opt);
            });
            if (setupsKeys.length === 0) {
                const opt = document.createElement('option');
                opt.value = ""; opt.innerText = filterByLevel ? "-- Brak tras w Twoim zakresie lvl --" : "-- Brak układów --";
                opt.disabled = true; opt.selected = true;
                sel.appendChild(opt);
            }
        }

        updateSetupUI() {
            const tagsContainer = document.getElementById('setupMapsTags');
            if (!tagsContainer) return;
            const activeName = this.settings.activeSetup;
            const activeMaps = this.settings.setups[activeName];
            tagsContainer.innerHTML = '';
            if (!activeMaps || activeMaps.length === 0) {
                tagsContainer.innerHTML = `<span style="color: var(--text-muted); font-size: 11px; padding: 5px;">Pusty obszar. Wejdź na mapę i kliknij Dodaj.</span>`;
            } else {
                activeMaps.forEach((map, index) => {
                    const tag = document.createElement('div');
                    tag.className = 'map-tag';
                    tag.title = map.name || "Nieznana nazwa";
                    tag.innerHTML = `${map.id} <span class="remove-tag" data-index="${index}">✖</span>`;
                    tagsContainer.appendChild(tag);
                });
                tagsContainer.querySelectorAll('.remove-tag').forEach(btn => {
                    btn.addEventListener('click', (e) => {
                        const idx = parseInt(e.target.getAttribute('data-index'));
                        this.settings.setups[activeName].splice(idx, 1);
                        this.saveSettings();
                        this.updateSetupUI();
                    });
                });
            }
        }

        startMapScanner() {
            setInterval(() => {
                // SPRAWDZANIE POSTACI I ŁADOWANIE USTAWIEŃ
                if (typeof Engine !== 'undefined' && Engine.hero && Engine.hero.d && Engine.hero.d.id) {
                    const currentHeroId = Engine.hero.d.id;
                    if (this.currentHeroId !== currentHeroId) {
                        this.currentHeroId = currentHeroId;
                        this.loadSettingsForHero(currentHeroId);

                        // Zaktualizuj kontrolki UI nowymi wartościami
                        if (typeof this.applySettingsToUI === 'function') this.applySettingsToUI();

                        this.updateSetupDropdown();
                        this.updateSetupUI();

                        // Przywróć ostatnio otwartą zakładkę dla tej postaci
                        if (typeof this.restoreLastActiveTab === 'function') {
                            this.restoreLastActiveTab();
                        }

                        if (this.settings.isRunning) {
                            this.updateStatus("Gotowy (Wznowiono)", "var(--accent-green)");
                        } else {
                            this.updateStatus("Gotowy", "var(--text-muted)");
                        }

                    }
                }

                if (typeof Engine !== 'undefined' && Engine.map && Engine.map.d) {
                    this.currentMap = { id: Engine.map.d.id, name: Engine.map.d.name };
                    const badge = document.getElementById('currentMapIdBadge');
                    if (badge) badge.innerText = this.currentMap.id || '—';
                }
                if (typeof Engine !== 'undefined' && Engine.hero && Engine.hero.d && Engine.hero.d.lvl) {
                    const lvl = Engine.hero.d.lvl;
                    const prev = window._uiCacheData.playerLevel;
                    window._uiCacheData.playerLevel = lvl;
                    // Odśwież dropdown tylko gdy filtr jest ON i poziom faktycznie się zmienił (wbito lvl)
                    if (this.settings.filterSetupsByLevel && lvl !== prev) {
                        this.updateSetupDropdown();
                    }
                }
            }, 500);
        }

        getSettings() { return this.settings; }

        forceStop(reason) {
            if (!this.settings.isRunning) return;
            this.settings.isRunning = false;
            try {
                this.btnStartToggle.className = 'main-toggle off';
                this.btnStartToggle.querySelector('.toggle-text').innerText = 'Wyłączony';
                this.btnStartToggle.querySelector('.toggle-icon').innerText = '';
            } catch(e) {}
            this.updateStatus(`Wstrzymany: ${reason}`, "var(--accent-red)");
            this.saveSettings();
        }

        forceStart(reason) {
            if (this.settings.isRunning) return;
            this.settings.isRunning = true;
            try {
                this.btnStartToggle.className = 'main-toggle on';
                this.btnStartToggle.querySelector('.toggle-text').innerText = 'Włączony';
                this.btnStartToggle.querySelector('.toggle-icon').innerText = '';
            } catch(e) {}
            this.updateStatus(`Aktywny: ${reason}`, "var(--accent-green)");
            this.saveSettings();
        }
    }

    // Eksportuj klasę, żeby gui_events.js mógł ją rozszerzyć przed instancją
    window._SpeedyGUI = SpeedyGUI;

})();

