    async function _navigateToMap(targetMapId, findPathBFS, walkSmoothly, getNextHopMap, setMapChangeCooldown) {
        let safety = 30;
        const config = window._uiCacheData.gui ? window._uiCacheData.gui.getSettings() : {};

        while (parseInt(Engine.map.d.id) !== parseInt(targetMapId) && safety-- > 0) {
            await _waitForBattleEnd();

            let currentTarget = targetMapId;
            if (window._uiCacheData.tp) {
                const astralResult = await window._uiCacheData.tp.processAstralTeleport(targetMapId, config, setMapChangeCooldown);
                if (astralResult) {
                    if (astralResult.action === 'HANDLED') {
                        if (parseInt(Engine.map.d.id) === parseInt(targetMapId)) return true;
                        continue;
                    }
                    if (astralResult.action === 'WALK_TO') currentTarget = astralResult.targetMapId;
                }
            }

            const nextHopMapId = getNextHopMap(Engine.map.d.id, currentTarget);
            if (!nextHopMapId) return false;

            let gw = null;
            if (Engine.map.gateways) {
                const gwList = typeof Engine.map.gateways.getList === 'function'
                    ? Engine.map.gateways.getList()
                    : (Engine.map.gateways.list || Engine.map.gateways);
                for (const id in gwList) {
                    const d = gwList[id].d || gwList[id];
                    const aff = d.affectedId || (d.target && d.target.map);
                    if (parseInt(aff) === parseInt(nextHopMapId)) { gw = { x: d.x, y: d.y }; break; }
                }
            }
            if (!gw) return false;

            const path = findPathBFS(Engine.hero.d.x, Engine.hero.d.y, gw.x, gw.y, 300);
            if (path && path.length > 0) await walkSmoothly(path);
            await _waitForBattleEnd();

            const dist = Math.max(Math.abs(Engine.hero.d.x - gw.x), Math.abs(Engine.hero.d.y - gw.y));
            if (dist > 1) return false;

            if (typeof setMapChangeCooldown === 'function') setMapChangeCooldown(true);
            const oldMapId = Engine.map.d.id;
            let naturalWait = 0;
            while (Engine.map.d.id === oldMapId && naturalWait < 15) { await delay(100); naturalWait++; }
            if (Engine.map.d.id === oldMapId && typeof Engine.hero.getTroughGateway === 'function') Engine.hero.getTroughGateway();
            let timeout = 0;
            while (Engine.map.d.id === oldMapId && timeout < 50) { await delay(100); timeout++; }
            await delay(1500);
            if (typeof setMapChangeCooldown === 'function') setMapChangeCooldown(false);
        }
        return parseInt(Engine.map.d.id) === parseInt(targetMapId);
    }

