                await waitForBattleEnd();
                const curDist = Math.max(Math.abs(Engine.hero.d.x - gw.x), Math.abs(Engine.hero.d.y - gw.y));
                if (curDist <= 1) { reachedGateway = true; break; }

                const path = findPathBFS(Engine.hero.d.x, Engine.hero.d.y, gw.x, gw.y, 300);
