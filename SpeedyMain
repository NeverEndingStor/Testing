            if (parseInt(vendor.npc_id) === 16366) {
                shopOpened = await openTuniaShopFast(npc.id);
            } else {
                _g('talk&id=' + npc.id);

                let dialogOpened = false;
                for (let i = 0; i < 40; i++) {
                    await delay(100);
                    if (document.querySelector('.dialogue-window.is-open')) { dialogOpened = true; break; }
                }
                if (!dialogOpened) { buyInProgress = false; return false; }

                await delay(80);

                const shopIdx = vendor.shop_dialog_option_index || 0;
                const answers = document.querySelectorAll('.dialogue-window-answer');
                if (answers[shopIdx]) answers[shopIdx].click();
                else {
                    const shopOpt = document.querySelector('.dialogue-window-answer.line_shop');
                    if (shopOpt) shopOpt.click();
                }

                for (let i = 0; i < 30; i++) {
                    await delay(100);
                    try {
                        if (document.querySelector('.shop-wrapper, .shop-background')) {
                            shopOpened = true;
                            break;
                        }
                        if (Engine.shop && typeof Engine.shop.getItems === 'function') {
                            const si = Engine.shop.getItems();
                            if (si && Object.keys(si).length > 0) {
                                shopOpened = true;
                                break;
                            }
                        }
                    } catch(e) {}
                }
            }

            if (!shopOpened) { buyInProgress = false; return false; }

            try {
                const sellInOpenShop = window._uiCacheData.sellAllQualifyingItems;
                if (config.autoSell && typeof sellInOpenShop === 'function') {
                    const sold = await sellInOpenShop(config);
                    if (sold > 0 && window._uiCacheData.gui) {
                        window._uiCacheData.gui.updateStatus(`Sprzedano ${sold} itemów – uzupełniam zaopatrzenie...`, '#98c379');
                    }
                }
            } catch (e) {}

            let boughtSomething = false;

            try {
                const shopItems = Engine.shop.getItems();
                if (shopItems) {

                    if (needPotions) {
                        for (const k in shopItems) {
                            const si = shopItems[k];
                            if (!si) continue;
                            const siName = si.name || (si.getName && si.getName()) || '';
                            if (siName === config.potionToBuy) {
                                let perPack = 3;
                                if (si.amount) perPack = parseInt(si.amount);
                                else if (si.d && si.d.amount) perPack = parseInt(si.d.amount);
                                else {
                                    const m = (si.stat || (si.d && si.d.stat) || '').match(/amount=(\d+)/);
                                    if (m) perPack = parseInt(m[1], 10);
                                }
                                if (!perPack || isNaN(perPack) || perPack < 1) perPack = 3;

                                const targetCharges = 60; // 20 stacków = 60 potek
                                const currentCharges = countItemInBag(config.potionToBuy);
                                const packsToBuy = Math.max(0, Math.ceil((targetCharges - currentCharges) / perPack));

                                if (packsToBuy > 0) {
                                    window._uiCacheData.gui && window._uiCacheData.gui.updateStatus(
                                        `Awaria: dokupuję ${packsToBuy}x ${config.potionToBuy} (do 60 szt.)`,
                                        '#98c379'
                                    );
                                    Engine.shop.buySeriallyItem(packsToBuy, si);
                                    boughtSomething = true;
                                }
                                break;
                            }
                        }
                    }

                    if (needScrolls && scrollPacksToBuy > 0) {
                        for (const k in shopItems) {
                            const si = shopItems[k];
                            if (!si) continue;
                            const siName = (si.name || (si.getName && si.getName()) || '').toLowerCase();
                            if (siName.includes(vendor.teleport_scroll_name.toLowerCase())) {
                                window._uiCacheData.gui && window._uiCacheData.gui.updateStatus(
                                    `Zwoje: ${scrollCount} szt. – dokupuję ${scrollPacksToBuy} pakiet${scrollPacksToBuy === 1 ? '' : 'y'}`,
                                    '#56a5e8'
                                );
                                for (let i = 0; i < scrollPacksToBuy; i++) Engine.shop.basket.buyItem(si);
                                boughtSomething = true;
                                break;
                            }
                        }
                    }

                    if (boughtSomething) {
                        await delay(120);
                        Engine.shop.basket.finalize();
                        await delay(220);
                    }
                }
            } catch(e) {}

            try { Engine.shop.close(); } catch(e) {}
            await delay(180);

            if (boughtSomething) window._uiCacheData.gui && window._uiCacheData.gui.updateStatus('Zakończono zakupy pomyślnie!', '#98c379');

        } catch(e) { buyInProgress = false; }
        finally { buyInProgress = false; }

        return true;
    }

    window._uiCacheData.buy  = handleAutoBuy;
    window._uiCacheData.hasAnyHealingPotions = hasAnyHealingPotions;
    window.handleAutoBuy  = handleAutoBuy;
})();

