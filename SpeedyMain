    function isOtherPlayerNearSpawn(spawnX, spawnY) {
        if (!Engine || !Engine.others) return false;
        try {
            const others = Engine.others.check ? Engine.others.check() : Engine.others.d;
            let partyMembers = new Set();
            if (window._uiCacheData.party && window._uiCacheData.party.isInParty()) {
                const members = Engine.party.getMembers();
                if (typeof members.forEach === 'function') members.forEach((v, k) => partyMembers.add(parseInt((v && v.id) ? v.id : k)));
            }
            for (const id in others) {
                const p = others[id];
                const d = p.d || p;
                if (!d || !d.id) continue;
                if (partyMembers.has(parseInt(d.id))) continue;
                if (chebyshev(d.x, d.y, spawnX, spawnY) <= PLAYER_CHECK_DIST) return true;
            }
        } catch(e) {}
        return false;
    }

    function graphDistance(fromId, toId, graph) {
        fromId = String(fromId); toId = String(toId);
        if (fromId === toId) return 0;
        const queue = [[fromId, 0]];
        const visited = new Set([fromId]);
        while (queue.length > 0) {
            const [curr, dist] = queue.shift();
            for (const n of (graph[curr] || [])) {
                const ns = String(n);
                if (ns === toId) return dist + 1;
                if (!visited.has(ns)) { visited.add(ns); queue.push([ns, dist + 1]); }
            }
        }
        return Infinity;
    }

    function pickBestE2Target(config) {
        const allE2 = window._uiCacheData.e2 || [];
        const mapId = currentMapId();
        const graph = window._uiCacheData.graph || {};

        const myE2Keys = getMyE2Keys(config);
        if (myE2Keys.length === 0) return null;

        const e2ByKey = {};
        for (const e of allE2) e2ByKey[e.key] = e;

        let immediateTargets = [];
        let waitingTargets   = [];

        for (const key of myE2Keys) {
            const e2 = e2ByKey[key];
            if (!e2) continue;
            if (isIgnored(key)) continue;
            if (isDefinitelyNotRespawned(key)) {
                waitingTargets.push(e2);
            } else {
                immediateTargets.push(e2);
            }
        }

        if (immediateTargets.length > 0) {
            let best = null, bestDist = Infinity, bestHasTimer = true;
            for (const e2 of immediateTargets) {
                const dist     = graphDistance(mapId, e2.map_id, graph);
                const hasTimer = !!getTimer(e2.key);
                if (dist < bestDist || (dist === bestDist && !hasTimer && bestHasTimer)) {
                    bestDist = dist; bestHasTimer = hasTimer; best = e2;
                }
            }
            return { type: 'immediate', target: best };
        }

        if (waitingTargets.length > 0) {
            waitingTargets.sort((a, b) => secondsToMinResp(a.key) - secondsToMinResp(b.key));
            return { type: 'waiting', target: waitingTargets[0] };
        }

        return null;
    }

