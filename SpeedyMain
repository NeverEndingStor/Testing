        loadSettingsForHero(heroId) {
            try {
                const defaultSetups = this.getPredefinedSetups();
                const specificKey = '_ext_ui_prefs_v2_' + heroId;
                let saved = localStorage.getItem(specificKey);
                // Jeżeli gracz loguje się na tę postać pierwszy raz po aktualizacji bota:
                // zaciągamy jego stare, wspólne ustawienia, żeby nie musiał klikać od nowa.
                if (!saved) {
                    saved = localStorage.getItem('_ext_ui_prefs_v2');
                }
                if (saved) {
                    const parsed = JSON.parse(saved);
                    this.settings = { ...this.defaultSettings, ...parsed };
                    this.settings.setups = { ...defaultSetups, ...(parsed.setups || {}) };

                    // v22: wpisy wbudowane zawsze bierzemy z aktualnej bazy skryptu.
                    // Dzięki temu stare localStorage nie przywróci błędnych map sprzed aktualizacji
                    // (np. starych setupów łączonych). Własne setupy użytkownika zostają bez zmian.
                    for (const [builtinName, builtinMaps] of Object.entries(defaultSetups)) {
                        this.settings.setups[builtinName] = builtinMaps;
                    }

                    // Setupy dostały zakres w nazwie. Usuń stare klucze i przenieś aktywny wybór.
                    const setupAliases = window._uiCacheData.setupNameAliases || {};
                    for (const [oldName, newName] of Object.entries(setupAliases)) {
                        if (oldName !== newName) delete this.settings.setups[oldName];
                        if (this.settings.activeSetup === oldName) this.settings.activeSetup = newName;
                    }
                } else {
                    this.settings = JSON.parse(JSON.stringify(this.defaultSettings));
                    this.settings.setups = defaultSetups;
                }

                // Oczyść zapisane ustawienia z herosów, których nie ma już w bazie.
                // Dzięki temu usunięte wpisy nie zostają w starej kolejce ani wyborze GUI.
                const validHeroKeys = new Set((window._uiCacheData.heroes || []).map(h => h.key || h.id || h.name));
                if (Array.isArray(this.settings.heroQueue)) {
                    this.settings.heroQueue = this.settings.heroQueue.filter(key => validHeroKeys.has(key));
                    if ((this.settings.heroQueueIndex || 0) >= this.settings.heroQueue.length) {
                        this.settings.heroQueueIndex = Math.max(0, this.settings.heroQueue.length - 1);
                    }
                }
                if (this.settings.heroSelect && !validHeroKeys.has(this.settings.heroSelect)) this.settings.heroSelect = '';

                // ════════════════════════════════════════════════════════
                // WYMUSZONY POWRÓT Z POCZEKALNI - WYŁĄCZENIE BOTA
                // ════════════════════════════════════════════════════════
                if (window.location.search.includes('rozm_stop=1')) {
                    this.settings.isRunning = false;
                    // Czyścimy link, żeby odświeżenie strony F5 nie trzymało tego na stałe
                    window.history.replaceState({}, document.title, window.location.pathname);
                }
                // ════════════════════════════════════════════════════════

                const keys = Object.keys(this.settings.setups);
                if (keys.length > 0 && !this.settings.activeSetup) {
                    this.settings.activeSetup = keys[0];
                    this.applyLevelRange(keys[0]);
                }
                // Jeśli brak zapisanych reguł blokady, załaduj domyślne z data_danger_maps.js
                if (!this.settings.dangerMaps || this.settings.dangerMaps.length === 0) {
                    const defaults = window._uiCacheData.defaultDangerMaps;
                    if (defaults && defaults.length > 0) {
                        this.settings.dangerMaps = JSON.parse(JSON.stringify(defaults));
                    }
                }
