            blessings.forEach((b, i) => {
                const slotNum = i + 1;
                if (slotNum === 1 || slotNum === 8) return; // pomijamy Slot 1 i Slot 8
                const opt = document.createElement('option');
                opt.value = String(slotNum);
                opt.innerText = b.name || ('Slot ' + slotNum);
