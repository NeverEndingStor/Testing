(function() {
    if (!window._uiCacheData) window._uiCacheData = {};
    let monkPenaltyUntil = 0;
    let currentRoute = null;
    let trupiaGatewayOpened = false;

    // Podpięcie pod event włączania/wyłączania bota w GUI.
    // Resetuje pamięć trasy po wyłączeniu, dzięki czemu bot nie zgłupieje po ponownym włączeniu.
    if (!window._uiCacheData._onSettingsChange) window._uiCacheData._onSettingsChange = [];
    window._uiCacheData._onSettingsChange.push(function(newSettings) {
        if (!newSettings.isRunning) {
            currentRoute = null;
            trupiaGatewayOpened = false;
        }
    });

    const CITIES = {
        'Ithan':    { mapId: 1,    npcId: 44099,  name: 'Ithan' },
        'Torneg':   { mapId: 2,    npcId: 44111,  name: 'Torneg' },
        'Werbin':   { mapId: 9,    npcId: 44122,  name: 'Werbin' },
        'Eder':     { mapId: 33,   npcId: 12506,  name: 'Eder' },
        'Karkahan': { mapId: 35,   npcId: 44132,  name: 'Karka' },
        'Thuzal':   { mapId: 114,  npcId: 236624, name: 'Thuzal' },
        'Rozstaje': { mapId: 500,  npcId: 280101, name: 'Rozstaje' },
        'Tuzmer':   { mapId: 589,  npcId: 44176,  name: 'Tuzmer' },
        'Nithal':   { mapId: 574,  npcId: 18951,  name: 'Nithal' },
        'Trupia':   { mapId: 1141, npcId: 32691,  name: 'Trupia' }
    };

    const delay = ms => new Promise(res => setTimeout(res, ms));

    function getMapDistance(start, target) {
        if (parseInt(start) === parseInt(target)) return 0;
        let queue = [{ id: parseInt(start), dist: 0 }];
        let visited = new Set([parseInt(start)]);

        while(queue.length > 0) {
            let curr = queue.shift();
            if (curr.id === parseInt(target)) return curr.dist;

            let neighbors = (window._uiCacheData.graph && window._uiCacheData.graph[curr.id]) || [];
            for (let n of neighbors) {
                if (!visited.has(n)) {
                    visited.add(n);
                    queue.push({ id: n, dist: curr.dist + 1 });
                }
            }
        }
        return 9999;
    }

    const TRUPIA_GATEWAY_NPC_ID = 37859;
    const TRUPIA_PASSAGE_NPC_ID = 27033;
    const TRUPIA_MAP_ID = 1141;
    const TUZMER_MAP_ID = 589;

    async function talkToNpcFirstOption(npcId, statusMsg) {
        if(window._uiCacheData.gui) window._uiCacheData.gui.updateStatus(statusMsg || `Rozmawiam z NPC ${npcId}...`, "#9b59b6");

        const npcs = Engine.npcs.check ? Engine.npcs.check() : Engine.npcs.d;
        let targetNpc = null;

        for (let k in npcs) {
            let n = npcs[k].d || npcs[k];
            if (parseInt(n.id) === npcId || parseInt(n.tpl) === npcId) {
                targetNpc = n;
                break;
            }
        }

        if (!targetNpc) return false;

        let standSpot;
        if (npcId === TRUPIA_PASSAGE_NPC_ID && parseInt(Engine.map.d.id) === TRUPIA_MAP_ID) {
            standSpot = { x: 3, y: 86 };
        } else {
            standSpot = null;
            for (const d of [{x:0,y:-1},{x:0,y:1},{x:-1,y:0},{x:1,y:0}]) {
                try {
                    if (!Engine.map.col.check(targetNpc.x + d.x, targetNpc.y + d.y)) {
                        standSpot = { x: targetNpc.x + d.x, y: targetNpc.y + d.y };
                        break;
                    }
                } catch(e) {}
            }
            if (!standSpot) standSpot = { x: targetNpc.x, y: targetNpc.y };
        }

        const exp = window._uiCacheData.exp;
        if (exp) {
            let path = exp.findPathBFS(Engine.hero.d.x, Engine.hero.d.y, standSpot.x, standSpot.y, 400);
            if (path && path.length > 0) {
                await exp.walkSmoothly(path);
                await delay(400);
            }
        }

        let config = window._uiCacheData.gui ? window._uiCacheData.gui.getSettings() : {isRunning: true};
        if (!config.isRunning || (exp && exp.isCaptchaActive())) return false;

        window._g('talk&id=' + (targetNpc.id || targetNpc.tpl));
        await delay(600);

        let steps = 0;
        while (steps < 6) {
            if (!config.isRunning || (exp && exp.isCaptchaActive())) {
                try { Engine.dialog.close(); } catch(e){}
                return false;
            }
            await delay(500);
            let answers = document.querySelectorAll('.dialogue-window-answer');
            if (answers.length === 0) break;
            answers[0].click();
            steps++;
            await delay(300);
        }

        try { Engine.dialog && Engine.dialog.close && Engine.dialog.close(); } catch(e) {}
        await delay(600);
        return true;
    }

    async function handleTrupiaGateway() {
        if(window._uiCacheData.gui) window._uiCacheData.gui.updateStatus(`Przełęcz: Szukam strażnika bramy...`, "#9b59b6");

        const npcs = Engine.npcs.check ? Engine.npcs.check() : Engine.npcs.d;
