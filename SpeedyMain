        _expWaitCombat = null;
    }
    function _expWaitEnsureAnchor(config, setupMaps, currentMapId) {
        if (!config?.expWaitingRoom || !config.activeSetup || !setupMaps.includes(currentMapId)) return null;
        let st = _expWaitLoad();
        if (!st || st.setupName !== config.activeSetup || !setupMaps.includes(Number(st.anchorMapId))) {
            st = {
                version: 1,
                setupName: config.activeSetup,
                anchorMapId: currentMapId,
