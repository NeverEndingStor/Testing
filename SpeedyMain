        const setupMeta = window._uiCacheData.setups && window._uiCacheData.setups[targetSetup];
        if (setupMeta) {
            cache.gui.settings.minLevel = setupMeta.minLevel;
            cache.gui.settings.maxLevel = setupMeta.maxLevel;
        }

        cache.gui.saveSettings();

        if (typeof cache.gui.updateSetupDropdown === 'function') cache.gui.updateSetupDropdown();
        if (typeof cache.gui.updateSetupUI === 'function') cache.gui.updateSetupUI();

        const minEl = document.getElementById('set-minLevel');
        const maxEl = document.getElementById('set-maxLevel');
        if (minEl && setupMeta) minEl.value = setupMeta.minLevel;
        if (maxEl && setupMeta) maxEl.value = setupMeta.maxLevel;

        if (cache.gui && typeof cache.gui.updateStatus === 'function') {
            cache.gui.updateStatus(`🤖 Automat: ${targetSetup}`, "#9b59b6");
        }

        lastCheckedLevel = currentLvl;
        lastKnownSetup = targetSetup;
    }

    window._uiCacheData.automat = {
        checkAndSwitch,
        getSetupForLevel,
        AUTOMAT_TABLE
    };

})();

