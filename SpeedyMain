// --- START OF FILE autoexp.js ---
(function() {
    if (!window._uiCacheData) window._uiCacheData = {};

    let activeKey = null;
    let lastAttackedTarget = null;
    const attackedAt = {};
    const blacklistedMobs = {};
    const recentlyDeadMobs = {}; // id -> timestamp śmierci
    const DEAD_MOB_GRACE_MS = 4000; // ignoruj moba przez 4s po śmierci serwera

    const KEYS = {
        W: { keyCode: 87, key: 'w', code: 'KeyW' },
        S: { keyCode: 83, key: 's', code: 'KeyS' },
        A: { keyCode: 65, key: 'a', code: 'KeyA' },
        D: { keyCode: 68, key: 'd', code: 'KeyD' }
    };

    const delay = ms => new Promise(res => setTimeout(res, ms));
    const randDelay = (base, lo = 0.75, hi = 1.35) => Math.floor(base * (lo + Math.random() * (hi - lo)));

    const MOB_MEMORY_AGE_MS = 5 * 60 * 1000;
    const mobMemory = {};
    const contaminatedGroupsMemory = {}; // { mapId: { grpId: timestamp } } - Trwała pamięć zakazanych groups

    function getFightingMobIds() {
        let fighting = new Set();
        if (typeof Engine !== 'undefined' && Engine.emotions) {
            let emotions = typeof Engine.emotions.getList === 'function' ? Engine.emotions.getList() : Engine.emotions;
            for (let key in emotions) {
                let emo = emotions[key];
                if (emo && emo.name === 'battle' && emo.sourceType === 2) {
                    fighting.add(parseInt(emo.sourceId));
                    fighting.add(String(emo.sourceId));
                }
            }
        }
        return fighting;
    }

    function isMobAliveAndFree(id) {
        if (!Engine || !Engine.npcs) return false;
        if (recentlyDeadMobs[id] && Date.now() - recentlyDeadMobs[id] < DEAD_MOB_GRACE_MS) return false;
        const npcs = typeof Engine.npcs.check === 'function' ? Engine.npcs.check() : Engine.npcs.d;
        let npc = null;
        for (let k in npcs) {
            let n = npcs[k].d || npcs[k];
            if (n && n.id == id) {
                npc = n;
                break;
            }
        }
        if (!npc) return false;

        if (npc.type !== 2 && npc.type !== 3 && npc.type !== 9) return false;
        if (npc.dead || npc.hp === 0 || npc.hp <= 0 || npc.st === 1 || npc.st === 2 || npc.st === 3) return false;

        const fightingMobs = getFightingMobIds();
        if (fightingMobs.has(id) || fightingMobs.has(String(id))) return false;

        return true;
    }

    function ensureMapMemory(mapId) {
        if (!mobMemory[mapId]) mobMemory[mapId] = {};
        if (!contaminatedGroupsMemory[mapId]) contaminatedGroupsMemory[mapId] = {};
    }

    function updateMobMemory(config) {
        if (!Engine || !Engine.npcs || !Engine.map) return;
        const mapId = Engine.map.d.id;
        ensureMapMemory(mapId);
        const now = Date.now();
        const npcs = Engine.npcs.check();
        const fightingMobs = getFightingMobIds();

        const currentNpcsOnMap = new Set();

        for (let key in npcs) {
            const npc = npcs[key];
            if (!npc.d) continue;
            if (npc.d.type !== 2 && npc.d.type !== 3 && npc.d.type !== 9) continue;

            const id = npc.d.id;
            currentNpcsOnMap.add(String(id));

            if (npc.d.dead || npc.d.hp === 0 || npc.d.st === 1 || npc.d.st === 2 || npc.d.st === 3 || blacklistedMobs[id]) {
                clearSpecificTargetFromMemory(mapId, id, npc.d.grp);
                continue;
            }

            if (fightingMobs.has(id) || fightingMobs.has(String(id))) {
                delete mobMemory[mapId][id];
                continue;
            }

            mobMemory[mapId][id] = {
                id:     id,
                x:      npc.d.x,
                y:      npc.d.y,
                lvl:    npc.d.lvl,
                wt:     npc.d.wt,
                type:   npc.d.type,
                grp:    npc.d.grp || null,
                nick:   npc.d.nick || npc.d.name || 'Potwór',
                seenAt: now,
                mapId:  mapId
            };
        }

        for (let id in mobMemory[mapId]) {
            if (!currentNpcsOnMap.has(String(id))) {
                delete mobMemory[mapId][id];
                continue;
            }
            if (now - mobMemory[mapId][id].seenAt > MOB_MEMORY_AGE_MS) {
                delete mobMemory[mapId][id];
            }
        }
    }

    function clearSpecificTargetFromMemory(mapId, targetId, grpId) {
        if (!mobMemory[mapId]) return;
        if (grpId) {
            for (let memId in mobMemory[mapId]) {
                if (mobMemory[mapId][memId].grp === grpId) delete mobMemory[mapId][memId];
            }
        } else {
            delete mobMemory[mapId][targetId];
        }
    }

    function isCaptchaActive() {
        if (typeof Engine !== 'undefined') {
            if (Engine.lock && Engine.lock.list && Engine.lock.list.includes("captcha")) return true;
            if (Engine.windowsManager && Engine.windowsManager.windows) {
                for (let winId in Engine.windowsManager.windows) {
                    let win = Engine.windowsManager.windows[winId];
                    if (win && win.name && win.name.toLowerCase().includes('captcha')) return true;
                }
            }
        }
        return false;
    }

    // v24: krótki cache BFS. W EXP te same ścieżki są pytane kilka razy pod rząd
    // (ranking celu, Smart Aggro, skan w trakcie ruchu). TTL jest celowo krótki,
    // żeby ruch NPC nie zostawiał starej ścieżki na długo.
    const _expPathCache = new Map();
    let _expPathCacheMapId = null;
    const EXP_PATH_CACHE_TTL = 300;

    // Algorytm ze zmianą - parametr stopAdjacent ignoruje wejście bezpośrednio na kratkę, staje obok
    function _findPathBFSUncached(startX, startY, targetX, targetY, maxSteps, stopAdjacent = false) {
        if (stopAdjacent && Math.max(Math.abs(startX - targetX), Math.abs(startY - targetY)) <= 1) return [];
        if (!stopAdjacent && startX === targetX && startY === targetY) return [];

        let queue = [{ x: startX, y: startY, path: [] }];
        let visited = new Set([`${startX},${startY}`]);
        let dirs = [{dx: 0, dy: -1}, {dx: 0, dy: 1}, {dx: -1, dy: 0}, {dx: 1, dy: 0}];

        let mapWidth = Engine.map.d.x;
        let mapHeight = Engine.map.d.y;

        let npcCol = new Set();
        const fightingMobs = getFightingMobIds();

        if (Engine && Engine.npcs) {
            const npcs = Engine.npcs.check ? Engine.npcs.check() : Engine.npcs.d;
            for (let k in npcs) {
                let n = npcs[k].d || npcs[k];
                if (n && !n.dead && n.hp !== 0 && n.st !== 1 && n.st !== 2 && n.type !== 4 && !fightingMobs.has(n.id) && !fightingMobs.has(String(n.id))) {
                    const wt = n.wt || 0;
                    if (wt > 79 && wt <= 99) continue;
                    npcCol.add(`${n.x},${n.y}`);
                }
            }
        }

        while (queue.length > 0) {
            let curr = queue.shift();
            if (curr.path.length >= maxSteps) continue;

            for (let d of dirs) {
                let nx = curr.x + d.dx;
                let ny = curr.y + d.dy;

                if (nx < 0 || nx >= mapWidth || ny < 0 || ny >= mapHeight) continue;

                let key = `${nx},${ny}`;

                if (!stopAdjacent && nx === targetX && ny === targetY) {
                    return [...curr.path, {x: nx, y: ny}];
                }

                if (!visited.has(key)) {
                    visited.add(key);
                    try {
                        if (!Engine.map.col.check(nx, ny) && !npcCol.has(key)) {

                            if (stopAdjacent && Math.max(Math.abs(nx - targetX), Math.abs(ny - targetY)) <= 1) {
                                return [...curr.path, {x: nx, y: ny}];
                            }

                            queue.push({ x: nx, y: ny, path: [...curr.path, {x: nx, y: ny}] });
                        }
                    } catch(e) {}
                }
            }
        }
        return null;
    }

    function findPathBFS(startX, startY, targetX, targetY, maxSteps, stopAdjacent = false) {
        const mapId = Engine && Engine.map && Engine.map.d ? Number(Engine.map.d.id) : 0;
        if (_expPathCacheMapId !== mapId) {
            _expPathCacheMapId = mapId;
            _expPathCache.clear();
        }
        const key = `${mapId}:${startX},${startY}:${targetX},${targetY}:${maxSteps}:${stopAdjacent ? 1 : 0}`;
        const now = Date.now();
        const hit = _expPathCache.get(key);
        if (hit && now - hit.at <= EXP_PATH_CACHE_TTL) {
            return hit.path === null ? null : hit.path.map(p => ({x:p.x,y:p.y}));
        }
        const path = _findPathBFSUncached(startX, startY, targetX, targetY, maxSteps, stopAdjacent);
        _expPathCache.set(key, { at: now, path: path === null ? null : path.map(p => ({x:p.x,y:p.y})) });
        if (_expPathCache.size > 220) {
            for (const [k,v] of _expPathCache) { if (now - v.at > EXP_PATH_CACHE_TTL) _expPathCache.delete(k); }
        }
        return path;
    }

    const _transitionCache = { mapId: null, at: 0, list: null };
    function getAllMapTransitions() {
        const _mid = Engine && Engine.map && Engine.map.d ? Number(Engine.map.d.id) : 0;
        const _now = Date.now();
        if (_transitionCache.mapId === _mid && _transitionCache.list && _now - _transitionCache.at < 750) {
            return _transitionCache.list.slice();
        }
        let transitions = [];

        try {
            let gwList = typeof Engine.map.gateways.getList === 'function' ? Engine.map.gateways.getList() : (Engine.map.gateways.list || Engine.map.gateways);
            for (let gwId in gwList) {
                let data = gwList[gwId].d || gwList[gwId];

                // gw2 ma format [targetMapId, x, y, key, lvl].
                // W aktualnym Engine gateway.d.id = targetMapId.
                // affectedId/target.map zostawiamy jako priorytet kompatybilności,
                // ale jeśli ich brak, używamy data.id zamiast gubić cel bramki.
                let affected = parseInt(
                    data.affectedId ||
                    (data.target && data.target.map) ||
                    data.id
                );

                if (affected) {
                    transitions.push({
                        type: 'physical',
                        x: data.x,
                        y: data.y,
                        affected: affected,
                        id: data.id
                    });
                }
            }
        } catch(e) {}

        try {
            let npcs = typeof Engine.npcs.check === 'function' ? Engine.npcs.check() : Engine.npcs.d;
            for (let id in npcs) {
                let npc = npcs[id];
                let data = npc.d || npc;
                if (!data) continue;

                let isGate = false;
                const iconStr = String(data.icon || '');
                const npcType = parseInt(data.type);
                if (typeof npc.isGateNpc === 'function' && npc.isGateNpc()) isGate = true;
                else if (npcType === 6) isGate = true; // Margonem: obiekt wyjścia/gate jako NPC type=6
                else if (iconStr.match(/(gate|exit|drzwi|jaskinia|przejscie|strzalka|schody|dziura|wlaz|wejscie)/i)) isGate = true;

                const STWORZYCIEL_NPC_IDS = new Set([323825, 323824, 323811, 323814]);
                let isStworzyciel = STWORZYCIEL_NPC_IDS.has(parseInt(data.id)) || STWORZYCIEL_NPC_IDS.has(parseInt(data.tpl));
                if (isStworzyciel) {
                    isGate = true;
                    data.affectedId = 7375;
                }

                if (isGate) {
                    let affected = parseInt(
                        data.gwMap ||
                        data.affectedId ||
                        (data.target && data.target.map) ||
                        (data.actions && data.actions.map) ||
                        (data.actions && data.actions.target && data.actions.target.map)
                    );
                    transitions.push({
                        type: 'npc',
                        x: data.x,
                        y: data.y,
                        affected: affected || null,
                        id: data.id,
                        tpl: data.tpl,
                        nick: data.nick || data.name || '',
                        icon: iconStr,
                        objectType: npcType,
                        isExitObject: npcType === 6 || /(?:^|\/)exit\.(?:gif|png|webp)$/i.test(iconStr),
                        raw: npc,
                        isStworzyciel: isStworzyciel
                    });
                }
            }
        } catch(e) {}

        _transitionCache.mapId = _mid;
        _transitionCache.at = _now;
        _transitionCache.list = transitions.slice();
        return transitions;
    }

    async function processNpcGateway(tData, delayFn, dialogSteps = null) {
        const beforeMapId = Number(Engine?.map?.d?.id || 0);

        // Niektóre nowe przejścia (np. Przełęcz Dwóch Koron) są wystawione jako
        // NPC type=6 z ikoną mas/exit.gif i bez affectedId/gwMap. W pierwszej
        // kolejności aktywujemy ich natywny handler kliknięcia, bo nie są dialogiem.
        if (tData && tData.isExitObject && tData.raw) {
            let clicked = false;
            try {
                if (typeof tData.raw.onclick === 'function') {
                    tData.raw.onclick({ stopPropagation(){}, preventDefault(){}, target:tData.raw, button:0, clientX:0, clientY:0 });
                    clicked = true;
                } else if (typeof tData.raw.click === 'function') {
                    tData.raw.click();
                    clicked = true;
                }
            } catch(e) {}
            if (clicked) {
                await delayFn(120);
                if (Number(Engine?.map?.d?.id || 0) !== beforeMapId) return;
            }
        }

        try {
            if (typeof Engine.hero.talkNearMob === 'function') Engine.hero.talkNearMob(tData.id);
            else window._g(`talk&id=${tData.id}`);
        } catch(e) { window._g(`talk&id=${tData.id}`); }

        const stepsWanted = Array.isArray(dialogSteps) ? dialogSteps : (tData.isStworzyciel ? [1,1,1,1,1,1] : null);
        if (stepsWanted) {
            await delayFn(450);
            for (const rawIndex of stepsWanted) {
                let tries=0, answers=[];
                while(tries++<8 && (answers=document.querySelectorAll('.dialogue-window-answer')).length===0) await delayFn(150);
                if (!answers.length) break;
                const idx=Math.max(0,Math.min(answers.length-1,Number(rawIndex||1)-1));
                answers[idx].click();
                await delayFn(300);
            }
            try { Engine.dialog && Engine.dialog.close && Engine.dialog.close(); } catch(e) {}
        }
    }

    function checkGatewayReachability(candX, candY, type = 'physical') {
        if (type === 'physical') {
            const dirs = [{x:0,y:-1},{x:0,y:1},{x:-1,y:0},{x:1,y:0}];
            let directPath = findPathBFS(Engine.hero.d.x, Engine.hero.d.y, candX, candY, 2000);
            if (directPath !== null) return { coords: { x: candX, y: candY }, path: directPath };
            for (const d of dirs) {
                try {
                    if (!Engine.map.col.check(candX + d.x, candY + d.y)) {
                        let entryPath = findPathBFS(Engine.hero.d.x, Engine.hero.d.y, candX + d.x, candY + d.y, 2000);
                        if (entryPath !== null) return { coords: { x: candX + d.x, y: candY + d.y }, path: entryPath };
                    }
                } catch(e) {}
            }
            return null;
        } else {
            let dist = Math.max(Math.abs(Engine.hero.d.x - candX), Math.abs(Engine.hero.d.y - candY));
            if (dist <= 1) {
                return { coords: { x: Engine.hero.d.x, y: Engine.hero.d.y }, path: [] };
            }

            const dirs = [{x:0,y:-1},{x:0,y:1},{x:-1,y:0},{x:1,y:0},{x:-1,y:-1},{x:1,y:-1},{x:-1,y:1},{x:1,y:1}];
            let bestPath = null;
            let bestCoords = null;

            for (const d of dirs) {
                let adjX = candX + d.x;
                let adjY = candY + d.y;
                try {
                    if (adjX >= 0 && adjY >= 0 && !Engine.map.col.check(adjX, adjY)) {
                        let path = findPathBFS(Engine.hero.d.x, Engine.hero.d.y, adjX, adjY, 2000);
                        if (path !== null) {
                            if (!bestPath || path.length < bestPath.length) {
                                bestPath = path;
                                bestCoords = { x: adjX, y: adjY };
                            }
                        }
                    }
                } catch(e) {}
            }
            if (bestPath) return { coords: bestCoords, path: bestPath };
            return null;
        }
    }

    function canReachGatewayToMap(targetMapId) {
        let transitions = getAllMapTransitions();
        for (let t of transitions) {
            if (t.affected === parseInt(targetMapId)) {
                return checkGatewayReachability(t.x, t.y, t.type) !== null;
            }
        }
        return false;
    }


    // v29: pamięć krawędzi, które istnieją w globalnym grafie, ale z bieżącego komponentu mapy
    // nie mają osiągalnej bramki. Blokada jest lokalna (pozycja + TTL), więc po wejściu na drugi
    // komponent tej samej mapy automatycznie przestaje obowiązywać.
    const _dynamicBlockedEdges = new Map();
    function _edgeKey(a,b){ return String(a)+'>'+String(b); }
    function isDynamicEdgeBlocked(a,b){
        const rec=_dynamicBlockedEdges.get(_edgeKey(a,b)); if(!rec) return false;
        if(Date.now()-rec.at>90000){_dynamicBlockedEdges.delete(_edgeKey(a,b));return false;}
        try{const dist=Math.abs(Number(Engine.hero.d.x)-rec.x)+Math.abs(Number(Engine.hero.d.y)-rec.y);if(dist>24)return false;}catch(e){}
        return true;
    }
    function markDynamicEdgeBlocked(a,b){
        try{_dynamicBlockedEdges.set(_edgeKey(a,b),{at:Date.now(),x:Number(Engine.hero.d.x),y:Number(Engine.hero.d.y)});}catch(e){}
    }
    function clearDynamicEdge(a,b){_dynamicBlockedEdges.delete(_edgeKey(a,b));}

    function findBestReachableTransitionToward(finalTargetMapId){
        const cur=Number(Engine.map.d.id); let best=null;
        for(const t of getAllMapTransitions()){
            if(!t || !t.affected || Number(t.affected)===cur) continue;
            if(isDynamicEdgeBlocked(cur,t.affected)) continue;
            const reach=checkGatewayReachability(t.x,t.y,t.type); if(!reach) continue;
            const worldPath=findSafeGraphPath(Number(t.affected),Number(finalTargetMapId)); if(!worldPath) continue;
            const score=(worldPath.length-1)*1000+(reach.path?reach.path.length:0);
            if(!best||score<best.score) best={mapId:Number(t.affected),coords:reach.coords,path:reach.path,transitionData:t,score};
        }
        return best;
    }

    function _findTransitionNear(x,y,type='npc',radius=2){
        let best=null,bestD=Infinity;
        for(const t of getAllMapTransitions()){
            if(type && t.type!==type) continue;
            const d=Math.abs(Number(t.x)-x)+Math.abs(Number(t.y)-y);
            if(d<=radius && d<bestD){best=t;bestD=d;}
        }
        return best;
    }

    async function handleSpecialTransit(activeSetupName,currentMapId,setMapCooldown){
        const n=String(activeSetupName||'').toLowerCase();
        const crystal=n.includes('kryształowa')||n.includes('krysie');
        let spec=null;
        if(crystal && Number(currentMapId)===10 && !canReachGatewayToMap(7342)) spec={x:75,y:50,dialog:[1],label:'Kryształowa Grota: przejście do 1791'};
        else if(crystal && Number(currentMapId)===1791) spec={x:14,y:5,dialog:[1],label:'Kryształowa Grota: wejście do odciętej części mapy 10'};
        if(!spec) return false;
        const t=_findTransitionNear(spec.x,spec.y,'npc',2); if(!t) return false;
        const reach=checkGatewayReachability(t.x,t.y,'npc'); if(!reach) return false;
        if(window._uiCacheData.gui) window._uiCacheData.gui.updateStatus(spec.label,'#9b59b6');
        if(reach.path&&reach.path.length){const ok=await walkSmoothly(reach.path);if(!ok)return true;}
        const old=Number(Engine.map.d.id); setMapCooldown(true); releaseKey();
        await processNpcGateway(t,delay,spec.dialog);
        let loops=0;while(Number(Engine.map.d.id)===old&&loops++<60)await delay(100);
        await delay(200);setMapCooldown(false);return true;
    }

    function getBlockedMapIds(exemptMapId) {
        const config = window._uiCacheData.gui ? window._uiCacheData.gui.getSettings() : {};
        const dangerMaps = config.dangerMaps || [];

        const playerLevel = (typeof Engine !== 'undefined' && Engine.hero && Engine.hero.d) ? (Engine.hero.d.lvl || 0) : (window._uiCacheData.playerLevel || 0);
        if (playerLevel === 0) return new Set();

        const exemptStr = exemptMapId ? String(exemptMapId) : null;
        const blocked = new Set();

        // 1) Ręczne reguły z zakładki Blokady Map.
        for (const rule of dangerMaps) {
            if (!rule || !rule.enabled) continue;
            const mapStr = String(rule.mapId);
            if (mapStr === exemptStr) continue;
            if (playerLevel < Number(rule.minLevel || 0)) blocked.add(mapStr);
        }

        // 2) v1.0.3: automatyczna ochrona tranzytu z bazy gotowych expowisk.
        // Jeśli mapa jest częścią expowiska przeznaczonego dla wyższego poziomu,
        // nie używamy jej jako skrótu. Bierzemy NAJNIŻSZY minLevel spośród setupów,
        // w których mapa występuje, żeby mapy współdzielone nie były nadmiernie blokowane.
        try {
            const setupDb = window._uiCacheData.setups || {};
            const minByMap = new Map();
            for (const setupName in setupDb) {
                const def = setupDb[setupName];
                if (!def || !Array.isArray(def.target_maps)) continue;
                const minLvl = Number(def.minLevel || 0);
                if (!minLvl) continue;
                for (const mapId of def.target_maps) {
                    const key = String(mapId);
                    const prev = minByMap.get(key);
                    if (prev === undefined || minLvl < prev) minByMap.set(key, minLvl);
                }
            }
            for (const [mapStr, minLvl] of minByMap.entries()) {
                if (mapStr === exemptStr) continue;
                if (playerLevel < minLvl) blocked.add(mapStr);
            }
        } catch(e) {}

        return blocked;
    }

    function findSafeGraphPath(startMapId, targetMapId) {
        startMapId = String(startMapId); targetMapId = String(targetMapId);
        if (startMapId === targetMapId) return [parseInt(startMapId)];
        const graph = window._uiCacheData.graph || {};
        const blocked = getBlockedMapIds(targetMapId);
        const queue = [[startMapId]]; const visited = new Set([startMapId]);
        while (queue.length) {
            const path = queue.shift(); const cur = path[path.length - 1];
            for (const n of (graph[cur] || [])) {
                const ns=String(n);
                if (visited.has(ns) || blocked.has(ns) || isDynamicEdgeBlocked(cur,ns)) continue;
                const next=path.concat(ns); if(ns===targetMapId)return next.map(Number);
                visited.add(ns);queue.push(next);
            }
        }
        return null;
    }

    async function tryEmergencySafeTeleport(finalTargetMapId) {
        if (typeof Engine === 'undefined' || !Engine.heroEquipment) return false;
        const items = getPlayerItems();
        const candidates = [];
        for (const key in items) {
            const item = items[key];
            if (!item) continue;
            const statStr = String(item.stat || (item.d && item.d.stat) || '').toLowerCase();
            const m = statStr.match(/(?:custom_)?teleport[=:](\d+)/);
            if (!m) continue;
            const destMapId = parseInt(m[1]);
            const safePath = findSafeGraphPath(destMapId, finalTargetMapId);
            if (!safePath) continue;
            candidates.push({ item, destMapId, distance: safePath.length });
        }
        if (!candidates.length) return false;
        candidates.sort((a,b) => a.distance - b.distance);
        const best = candidates[0];
        try {
            if (window._uiCacheData.gui) window._uiCacheData.gui.updateStatus(`Bezpieczny TP z niebezpiecznej strefy → mapa ${best.destMapId}`, '#e67e22');
            try { if (typeof Engine.hero.stop === 'function') Engine.hero.stop(); } catch(e) {}
            if (typeof Engine.heroEquipment.sendUseRequest === 'function') Engine.heroEquipment.sendUseRequest(best.item);
            else if (typeof best.item.createUseItem === 'function') best.item.createUseItem();
            else window._g('moveitem&st=1&id=' + (best.item.id || best.item.d?.id));
            return true;
        } catch(e) { return false; }
    }

    function getNextHopMap(startMapId, targetMapId) {
        if (!startMapId || !targetMapId) return null;
        if (startMapId == targetMapId) return startMapId;

        let config = window._uiCacheData.gui ? window._uiCacheData.gui.getSettings() : {};
        let activeSetupName = config.activeSetup;
        let hardRoutes = window._uiCacheData.hardRoutes || {};

        let isTargetExpMap = false;
        if (activeSetupName && config.setups && config.setups[activeSetupName]) {
            isTargetExpMap = config.setups[activeSetupName].some(m => parseInt(m.id || m) === parseInt(targetMapId));
        }

        let isHuntingE2orHero = (config.e2Enabled || config.heroOnlyMode) && !isTargetExpMap;

        let e2TargetKey = null;
        if (config.e2Enabled && window._uiCacheData.e2) {
             const foundE2 = window._uiCacheData.e2.find(e => parseInt(e.map_id) === parseInt(targetMapId));
             if (foundE2) e2TargetKey = foundE2.key;
        } else if (config.e2Enabled && config.elite2Key) {
             e2TargetKey = config.elite2Key;
        }

        if (e2TargetKey && hardRoutes[e2TargetKey] && hardRoutes[e2TargetKey][startMapId]) {
            let rule = hardRoutes[e2TargetKey][startMapId];
            let forcedMapId = typeof rule === 'function' ? rule({ canReachGatewayTo: canReachGatewayToMap }, targetMapId) : rule;
            if (forcedMapId) return parseInt(forcedMapId);
        }

        if (!isHuntingE2orHero && activeSetupName && hardRoutes[activeSetupName] && hardRoutes[activeSetupName][startMapId]) {
            let rule = hardRoutes[activeSetupName][startMapId];
            let forcedMapId = null;
            if (typeof rule === 'function') forcedMapId = rule({ canReachGatewayTo: canReachGatewayToMap }, targetMapId);
            else forcedMapId = rule;
            if (forcedMapId) return parseInt(forcedMapId);
        }

        let globalRoutes = window._uiCacheData.globalTransitRoutes || {};
        let globalRule = globalRoutes[String(startMapId)];
        if (globalRule) {
            let forcedMapId = (typeof globalRule === 'function') ? globalRule({}) : globalRule;
            if (forcedMapId) return parseInt(forcedMapId);
        }

        startMapId = startMapId.toString(); targetMapId = targetMapId.toString();
        let queue = [[startMapId]];
        let visited = new Set([startMapId]);
        const MAP_GRAPH = window._uiCacheData.graph || {};
        const blockedMaps = getBlockedMapIds(targetMapId);

        while(queue.length > 0) {
            let path = queue.shift();
            let current = path[path.length - 1];
            if (current === targetMapId) return parseInt(path[1]);

            let neighbors = MAP_GRAPH[current] || [];
            for(let n of neighbors) {
                let nStr = n.toString();
                if(!visited.has(nStr) && !blockedMaps.has(nStr) && !isDynamicEdgeBlocked(current,nStr)) {
                    visited.add(nStr);
                    queue.push([...path, nStr]);
                }
            }
        }
        return null;
    }

    function getHardRouteNextHop(currentMapId, setupMaps, activeSetupName) {
        let hardRoutes = window._uiCacheData.hardRoutes || {};
        let config = window._uiCacheData.gui ? window._uiCacheData.gui.getSettings() : {};

        let rule = null;
        if (activeSetupName && hardRoutes[activeSetupName] && hardRoutes[activeSetupName][currentMapId]) {
            rule = hardRoutes[activeSetupName][currentMapId];
        }

        if (!rule) return null;

        let forcedMapId = null;
        let targetMapId = setupMaps && setupMaps.length > 0 ? setupMaps[0] : null;

        if (typeof rule === 'function') forcedMapId = rule({ canReachGatewayTo: canReachGatewayToMap }, targetMapId);
        else forcedMapId = rule;

        return forcedMapId ? parseInt(forcedMapId) : null;
    }

    function getMobRank(wt) {
        if (!wt) return 'normal';
        if (wt > 99) return 'titan';
        if (wt > 89) return 'colossus';
        if (wt > 79) return 'hero';
        if (wt > 29) return 'e3';
        if (wt > 19) return 'e2';
        if (wt > 9)  return 'elite';
        return 'normal';
    }

    function isMobAllowed(mobData, config) {
        if (mobData.lvl < config.minLevel || mobData.lvl > config.maxLevel) return false;
        const rank = getMobRank(mobData.wt);
        if (rank === 'titan' || rank === 'colossus') return false;
        if (rank === 'hero' && !config.attackHero) return false;
        if ((rank === 'e2' || rank === 'e3') && !config.attackElite2) return false;
        if (rank === 'elite' && !config.attackElite) return false;
        if (rank === 'normal' && !config.attackNormal) return false;
        return true;
    }

    const mapVisitTimestamps = {};

    // v22: branch-aware EXP traversal. Na hubach preferujemy wejście w gałąź,
    // która zawiera najwięcej jeszcze nieodwiedzonych map, zamiast odbijać losowo
    // między sąsiadami. Liczymy komponent po usunięciu bieżącej mapy z grafu setupu.
    function getSetupBranchFreshCount(candidateMapId, currentMapId, setupMaps) {
        try {
            const graph = window._uiCacheData.graph || {};
            const allowed = new Set((setupMaps || []).map(Number));
            const start = Number(candidateMapId);
            const blockedCurrent = Number(currentMapId);
            if (!allowed.has(start)) return 0;

            const q = [start];
            const seen = new Set([start]);
            let fresh = 0;
            while (q.length) {
                const cur = q.shift();
                const visit = mapVisitTimestamps[cur] || 0;
                if (!visit) fresh++;

                for (const raw of (graph[String(cur)] || [])) {
                    const n = Number(raw);
                    if (n === blockedCurrent || !allowed.has(n) || seen.has(n)) continue;
                    seen.add(n);
                    q.push(n);
                }
            }
            return fresh;
        } catch (_) { return 0; }
    }

    let lastSetupName = null;
