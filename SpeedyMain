            lastAttackedTarget = { id: target.id, grp: target.grp || null, mapId: currentMapId };
            const autoStarted = await waitForExpAggro(target, randDelay(520, 0.92, 1.08));
            if (autoStarted) return true;

            if (window._uiCacheData.gui) {
                window._uiCacheData.gui.updateStatus(`Brak auto-agro – atak: ${target.nick}`, '#e67e22');
            }
        } else if (window._uiCacheData.gui) {
            window._uiCacheData.gui.updateStatus(`Atak: ${target.nick}`, '#e74c3c');
        }

        if (!isExpBattleVisible() && isMobAliveAndFree(target.id)) {
            markExpTargetAttack(target, currentMapId);
            Engine.hero.heroAtackRequest(target.id, !0);
            await delay(randDelay(80, 0.90, 1.10));
            return true;
        }
        return isExpBattleVisible();
    }

