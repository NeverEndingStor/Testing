    async function handleMapTransition(config, setMapCooldown, forcedTargetMapId = null) {
        let setupMaps = [];
        let activeSetupName = config.activeSetup;

        if (forcedTargetMapId) {
            setupMaps = [parseInt(forcedTargetMapId)];
        } else {
            if (!activeSetupName || !config.setups[activeSetupName] || config.setups[activeSetupName].length === 0) {
                if(window._uiCacheData.gui) window._uiCacheData.gui.updateStatus("Oczekiwanie...", "var(--text-muted)");
                await delay(randDelay(1000)); return;
            }
            setupMaps = config.setups[activeSetupName].map(m => parseInt(m.id || m));
        }

        let currentMapId = parseInt(Engine.map.d.id);

        if (!forcedTargetMapId && lastSetupName !== activeSetupName) {
            for (let k in mapVisitTimestamps) delete mapVisitTimestamps[k];
            lastSetupName = activeSetupName;
        }

        let targetMapId = null;
        let gatewayCoords = null;
        let pathToGw = null;
        let transitionData = null;

        const resolveGateway = (expectedTarget) => {
            let transitions = getAllMapTransitions();

            for (let t of transitions) {
                if (t.affected === expectedTarget) {
                    let reachCheck = checkGatewayReachability(t.x, t.y, t.type);
                    if (reachCheck) return { coords: reachCheck.coords, path: reachCheck.path, data: t };
                }
            }

            let hiddenNpcGates = transitions.filter(t => t.type === 'npc' && !t.affected);
            for (let t of hiddenNpcGates) {
