                    mapVisitTimestamps[currentMapId] = Date.now();
                    reachableOptions.sort((a, b) => {
                        // 1) Nie cofaj się natychmiast, jeśli istnieje inna droga.
                        const aIsBack = (a.mapId === lastExitedMapId);
                        const bIsBack = (b.mapId === lastExitedMapId);
                        if (aIsBack !== bIsBack) return aIsBack ? 1 : -1;

                        // 2) Dokończ świeższą / większą gałąź zanim wrócisz do huba.
                        const aFresh = getSetupBranchFreshCount(a.mapId, currentMapId, setupMaps);
                        const bFresh = getSetupBranchFreshCount(b.mapId, currentMapId, setupMaps);
                        if (aFresh !== bFresh) return bFresh - aFresh;

                        // 3) Przy remisie wybierz mapę najdawniej odwiedzoną.
                        const aVisit = mapVisitTimestamps[a.mapId] || 0;
                        const bVisit = mapVisitTimestamps[b.mapId] || 0;
                        if (aVisit !== bVisit) return aVisit - bVisit;

                        // 4) Ostatni tie-breaker: krótsze dojście do bramki na bieżącej mapie.
                        return (a.path ? a.path.length : 999999) - (b.path ? b.path.length : 999999);
                    });

