    function _expWaitMarkVisit(config, setupMaps, currentMapId) {
        if (!config?.expWaitingRoom) return;
        const st = _expWaitEnsureAnchor(config, setupMaps, currentMapId);
        if (!st || !st.armed) return;
        const visited = new Set((st.visited || []).map(Number));
        visited.add(currentMapId);
        st.visited = [...visited];
        if (currentMapId !== Number(st.anchorMapId)) st.cycleLeftAnchor = true;
        st.updatedAt = Date.now();
