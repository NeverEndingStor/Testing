/**
 * M-Helper - Moduł Ucieczki (autoflee.js)
 *
 * UWAGA dotycząca zakresu detekcji zagrożeń:
 * Moduł reaguje na mapy "ekspowe", przez co rozumie się:
 *   1) mapy z aktywnego setupu expowego (config.setups[activeSetup]),
 *   2) mapy E2 z aktywnej kolejki tej postaci (jeśli e2Enabled).
 *
 * Dzięki temu wszystkie opcje (zatrzymaj / teleport+ukryj / czarne listy)
 * działają identycznie podczas zwykłego expa i podczas bicia E2.
 *
 * Bot nadal NIE reaguje podczas tranzytów przez mapy miejskie ani
 * podczas podróży do sprzedawcy – te mapy nie są ani w setupie, ani
 * w mapach E2.
 */
(function() {
    if (!window._uiCacheData) window._uiCacheData = {};
    if (window._uiCacheData.flee) return;

    let isHiding = false;
    let hideUntil = 0;

    const delay = ms => new Promise(res => setTimeout(res, ms));

    // ── Hook na zmiany GUI ────────────────────────────────────────────────────
    // Gdy gracz wyłączy bota lub zmieni listy flee/ignore – reaguj natychmiast,
    // nie czekając aż skończy się aktualny tick pętli.
    if (!window._uiCacheData._onSettingsChange) window._uiCacheData._onSettingsChange = [];
    window._uiCacheData._onSettingsChange.push(function(newSettings) {
        // Bot wyłączony → wyjdź z trybu ukrycia
        if (!newSettings.isRunning) {
            isHiding = false;
            hideUntil = 0;
        }
    });

    async function useTeleportScroll(targetMapId) {
        if (!Engine || !Engine.heroEquipment) return false;
        const items = Engine.heroEquipment.getHItems();
        const targetId = String(targetMapId).trim();

        for (const key in items) {
            const item = items[key];
            if (!item) continue;
            const st = item.st !== undefined ? item.st : (item.d && item.d.st);
            if (st !== 0 && st < 20) continue;

            const statStr = (item.stat || (item.d && item.d.stat) || '').toLowerCase();
            const teleMatch = statStr.match(/(?:custom_)?teleport[=:](\d+)/);

            if (teleMatch && teleMatch[1] === targetId) {
                try {
                    if (typeof Engine.heroEquipment.sendUseRequest === 'function') {
                        Engine.heroEquipment.sendUseRequest(item);
                    } else if (typeof item.createUseItem === 'function') {
                        item.createUseItem();
                    } else {
                        window._g('moveitem&st=1&id=' + (item.id || item.d.id));
                    }
                    return true;
                } catch(e) { return false; }
            }
        }
        return false;
    }

    function parseList(str) {
        if (!str) return [];
        return str.split(',').map(s => s.trim().toLowerCase()).filter(s => s.length > 0);
    }

    function checkForThreats(config) {
        if (!Engine || !Engine.others || typeof Engine.others.check !== 'function') return null;

        const players = Engine.others.check();
        const ignorePlayers = parseList(config.warnIgnoreList);
        const ignoreClans = parseList(config.warnIgnoreClans);
        const fleePlayers = parseList(config.warnRunFromList);
        const fleeClans = parseList(config.warnRunFromClans);

        for (let id in players) {
            const p = players[id];
            const d = p.d || p;
            if (!d || !d.nick) continue;

            const nick = d.nick.toLowerCase();
            const clanName = (d.clan && d.clan.name) ? d.clan.name.toLowerCase() : "";
            const rights = p.rights || d.uprawnienia || 0;
            const relation = d.relation || 1;

            // 1. WHITE LISTY (Ignoruj)
            if (ignorePlayers.includes(nick)) continue;
            if (clanName && ignoreClans.includes(clanName)) continue;

            let isThreat = false;
            let reason = "";

            // 2. BLACK LISTY (Konkretni gracze/klany)
            if (fleePlayers.includes(nick)) { isThreat = true; reason = "Z Czarnej Listy"; }
            if (clanName && fleeClans.includes(clanName)) { isThreat = true; reason = "Klan z Czarnej Listy"; }

            // 3. ZASADY OGÓLNE
            if (!isThreat && config.warnAnyone) { isThreat = true; reason = "Ktokolwiek (Włączone reagowanie na wszystkich)"; }

            if (!isThreat && config.warnEnemy && [3, 6, 8].includes(relation)) {
                isThreat = true; reason = "Zaznaczony jako wróg";
            }

            if (!isThreat && config.warnMGPlus && ((rights & 1) || (rights & 16) || (rights & 2))) {
                isThreat = true; reason = "Admin/MG";
            }

            if (!isThreat && config.warnSMC && (rights & 4)) {
                isThreat = true; reason = "SMC";
            }

            if (!isThreat && config.warnMC && (rights & 8)) {
                isThreat = true; reason = "MC";
            }

            if (isThreat) {
                return { nick: d.nick, reason: reason };
            }
        }
        return null;
    }

    async function handlePlayersLogic(config) {
        if (!config.isRunning) return false;

        // Filtruj tylko mapy ekspowe (celowe – patrz komentarz na górze pliku).
        // ROZSZERZENIE: jeśli bot ma włączone E2 (config.e2Enabled), mapy E2 z aktywnej
        // kolejki traktujemy jako "moje" – inaczej bot bije E2 i nie reaguje na MG/SMC,
        // bo mapa E2 nie jest w setupie.
        if (Engine && Engine.map) {
            const currentMapId = parseInt(Engine.map.d.id);
            const setupMaps = (config.activeSetup && config.setups && config.setups[config.activeSetup])
                ? config.setups[config.activeSetup].map(m => parseInt(m.id || m))
                : [];

            // Dorzuć mapy E2 (zarówno z config.e2Queue jak i z rostera)
            const e2Maps = [];
            if (config.e2Enabled && Array.isArray(window._uiCacheData.e2)) {
                const e2List = window._uiCacheData.e2;
                const autoe2 = window._uiCacheData.autoe2;

                // Klucze E2: priorytetowo z autoe2.getMyE2Keys (uwzględnia roster
                // + filtrowanie po assigned char), fallback na config.e2Queue.
                let myKeys = [];
                try {
                    if (autoe2 && typeof autoe2.getMyE2Keys === 'function') {
                        myKeys = autoe2.getMyE2Keys(config) || [];
                    }
                } catch (e) {}

                // Fallback: surowy e2Queue jeśli getMyE2Keys nic nie zwrócił
                if (myKeys.length === 0 && Array.isArray(config.e2Queue)) {
                    for (const q of config.e2Queue) {
                        let candidates = [];
                        if (typeof q === 'string') candidates.push(q);
                        else if (q && typeof q === 'object') candidates = Object.values(q).filter(v => typeof v === 'string');
                        for (const s of candidates) {
                            const cleaned = String(s).toLowerCase().replace(/\[\d+\]/g, '').replace(/\(.*?\)/g, '').trim();
                            if (!cleaned) continue;
                            const found = e2List.find(e =>
                                e.key === cleaned ||
                                (e.name && e.name.toLowerCase().replace(/\[\d+\]/g, '').replace(/\(.*?\)/g, '').trim() === cleaned)
                            );
                            if (found && !myKeys.includes(found.key)) myKeys.push(found.key);
                        }
                    }
                }

                for (const key of myKeys) {
                    const e2 = e2List.find(e => e.key === key);
                    if (e2 && e2.map_id) e2Maps.push(parseInt(e2.map_id));
                }
            }

            const activeMaps = [...new Set([...setupMaps, ...e2Maps])];

            // Jeśli mamy skonfigurowany jakiś zakres (setup lub E2) i mapa NIE jest w nim → nie reaguj
            if (activeMaps.length > 0 && !activeMaps.includes(currentMapId)) {
                return false;
            }
        }

        const gui = window._uiCacheData.gui;
        const exp = window._uiCacheData.exp;

        // Jeśli bot czeka w ukryciu
        if (isHiding) {
            if (Date.now() < hideUntil) {
                const timeLeft = Math.ceil((hideUntil - Date.now()) / 1000);
                if (gui) gui.updateStatus(`Ukrywanie się... (${timeLeft}s)`, "#e74c3c");
                return true;
            } else {
                isHiding = false;
                if (!config.warnReturn && config.isRunning) {
                    if (gui) gui.forceStop("Zakończono ukrywanie (Brak opcji Powrót).");
                    return true;
                }
                if (gui) gui.updateStatus("Koniec ukrywania, powrót na spot...", "#f39c12");
                return false;
            }
        }

        const threat = checkForThreats(config);

        if (threat) {
            if (exp) exp.releaseKey();
            if (Engine.stepsToSend) Engine.stepsToSend.reset();
            if (Engine.hero) Engine.hero.clearAutoPathOfHero();

            if (gui) gui.updateStatus(`🚨 Zagrożenie! ${threat.nick}`, "#e74c3c");

            // Opcja 1: Zatrzymaj bota całkowicie
            if (config.warnPlayers) {
                await delay(500);
                if (gui) gui.forceStop(`Wykryto: ${threat.nick} (${threat.reason})`);
                return true;
            }

            // Opcja 2: Teleport na mapę ewakuacyjną
            if (config.warnTeleportMap && config.warnTeleportMap !== "" && config.warnTeleportMap !== "0") {
                const mapId = config.warnTeleportMap.trim();
                const used = await useTeleportScroll(mapId);
                if (used) {
                    if (gui) gui.updateStatus(`🚨 Ucieczka na mapę ${mapId}...`, "#e74c3c");
                    await delay(2000);
                } else {
                    if (gui) gui.updateStatus(`🚨 Brak teleportu na mapę ${mapId}! Czekam na miejscu...`, "#e74c3c");
                    await delay(500);
                }
            }

            // Opcja 3: Losowy czas ukrycia
            const minMin = parseInt(config.warnMinWait) || 5;
            const maxMin = parseInt(config.warnMaxWait) || 15;
            let waitMinutes = minMin;
            if (maxMin > minMin) {
                waitMinutes = Math.floor(Math.random() * (maxMin - minMin + 1)) + minMin;
            }

            isHiding = true;
            hideUntil = Date.now() + (waitMinutes * 60 * 1000);

            if (gui) gui.updateStatus(`Ukrywanie na ${waitMinutes} min...`, "#e74c3c");

            return true;
        }

        return false;
    }

    window._uiCacheData.flee = {
        handlePlayersLogic
    };

})();

