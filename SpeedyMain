    function getMyE2Keys(config) {
        // v28: jedna, czytelna kolejka. Aktualna postać robi wyłącznie E2 przypisane
        // do niej w mg_e2_roster. Stare legacy e2Queue/elite2Key nie sterują AutoE2.
        const myEntry = findMyRosterEntry();
