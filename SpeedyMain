    async function walkSmoothly(path, arg2 = null, arg3 = null) {
        if (!path || path.length === 0) return true;

        let targetId = null;
        let interruptCheckCallback = null;

        if (typeof arg2 === 'function') {
            interruptCheckCallback = arg2;
        } else {
            targetId = (arg2 === undefined) ? null : arg2;
            interruptCheckCallback = arg3;
        }

        let stepsSinceScan = 0;
        const _versionAtStart = window._uiCacheData._settingsVersion || 0;

        for (let i = 0; i < path.length; i++) {
            let config = window._uiCacheData.gui ? window._uiCacheData.gui.getSettings() : {};

            if ((window._uiCacheData._settingsVersion || 0) !== _versionAtStart) {
                releaseKey(); return false;
            }

            if (!config.isRunning || isCaptchaActive() || Engine.dead || (Engine.battle && Engine.battle.getShow())) {
                releaseKey(); return false;
            }

            if (targetId !== null && !isMobAliveAndFree(targetId)) {
                abortOnDeadTarget(targetId);
                return false;
            }

            if (interruptCheckCallback && stepsSinceScan >= 2) {
                releaseKey(); await delay(randDelay(30, 0.85, 1.15));
                let shouldInterrupt = interruptCheckCallback(path.length - i);
                if (shouldInterrupt) return false;
                stepsSinceScan = 0;
            }

            let step = path[i];
            let timeout = 0;
            let deltaX = step.x - Engine.hero.d.x;
            let deltaY = step.y - Engine.hero.d.y;

            let neededKey = null;
            if (deltaX > 0) neededKey = KEYS.D;
            else if (deltaX < 0) neededKey = KEYS.A;
            else if (deltaY > 0) neededKey = KEYS.S;
            else if (deltaY < 0) neededKey = KEYS.W;

            if (!neededKey) continue;

            if (activeKey && activeKey.code !== neededKey.code) { releaseKey(); await delay(randDelay(7, 0.80, 1.20)); }

            while ((Engine.hero.d.x !== step.x || Engine.hero.d.y !== step.y) && timeout < 25) {
                if (Engine.battle && Engine.battle.getShow()) { releaseKey(); return true; }

                if (targetId !== null && !isMobAliveAndFree(targetId)) {
                    abortOnDeadTarget(targetId);
                    return false;
                }

                pressKey(neededKey); await delay(randDelay(14, 0.90, 1.10)); timeout++;
            }
            if (timeout >= 25) { releaseKey(); return false; }
            stepsSinceScan++;
        }
        releaseKey(); return true;
    }

