// Toggle przypisanych map – jednorazowa rejestracja w IIFE, by uniknąć
// wielokrotnej rejestracji gdy plik zostanie załadowany ponownie.
(function () {
    if (window._uiCacheData && window._uiCacheData._expTabToggleBound) return;
    if (!window._uiCacheData) window._uiCacheData = {};
    window._uiCacheData._expTabToggleBound = true;

    document.addEventListener('click', function(e) {
        if (e.target && e.target.id === 'btnToggleAssignedMaps') {
            var wrapper = document.getElementById('assignedMapsWrapper');
            if (wrapper) {
                wrapper.style.display = wrapper.style.display === 'none' ? 'block' : 'none';
            }
        }
    });
})();

