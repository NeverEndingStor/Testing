    function pickNextRosterChar(config) {
        const roster = loadRoster();
        if (roster.length < 2) return null;

        const nick = myNick();
        const myIdx = roster.findIndex(r => nick.startsWith(r.nick.toLowerCase()) || r.nick.toLowerCase().startsWith(nick));
        if (myIdx === -1) {
            return null;
        }

        let readyCandidates  = [];
        let waitingCandidates = [];

        for (let i = 0; i < roster.length; i++) {
            if (i === myIdx) continue;
            const entry = roster[i];

            // Pomiń postać jeśli jest martwa i jeszcze się nie respawił
            const entryWorld = entry.world || getWorldName();
            if (heroDeadSecondsLeft(entry.nick, entryWorld) > 0) continue;

            // v28: tylko jawne przypisania z prostej kolejki postać -> E2.
            const entryE2Keys = (entry.e2Keys && entry.e2Keys.length > 0) ? [...entry.e2Keys] : [];

            if (entryE2Keys.length === 0) continue;

            let hasReady = false;
            let shortestTimer = Infinity;

            for (const key of entryE2Keys) {
                if (isIgnored(key)) continue;
                if (!isDefinitelyNotRespawned(key)) {
                    hasReady = true;
                    break;
                }
                const secs = secondsToMinResp(key);
                if (secs < shortestTimer) shortestTimer = secs;
            }

            if (hasReady) {
                const distFromMe = (i - myIdx + roster.length) % roster.length;
                readyCandidates.push({ entry, distFromMe });
            } else if (shortestTimer < Infinity) {
                const distFromMe = (i - myIdx + roster.length) % roster.length;
                waitingCandidates.push({ entry, distFromMe, shortestTimer });
            }
        }

        if (readyCandidates.length > 0) {
            readyCandidates.sort((a, b) => a.distFromMe - b.distFromMe);
            return readyCandidates[0].entry;
        }

        if (waitingCandidates.length > 0) {
            waitingCandidates.sort((a, b) => a.shortestTimer - b.shortestTimer);
            return waitingCandidates[0].entry;
        }

        return null;
    }

