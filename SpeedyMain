        const existingOptions = Array.from(sel.options);
        sel.innerHTML = '';

        const emptyOpt = document.createElement('option');
        emptyOpt.value = '';
        emptyOpt.innerText = '-- Brak --';
        sel.appendChild(emptyOpt);

        existingOptions.forEach(opt => {
            if (opt.value === '') return;
            const slotNum = parseInt(opt.value);
            if (slotNum === 1 || slotNum === 8) return; // pomijamy Slot 1 i Slot 8
