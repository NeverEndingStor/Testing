                observer = new MutationObserver(check);
                observer.observe(document.body, { subtree: true, childList: true, characterData: true });
            } catch (e) {}

            timer = setTimeout(() => {
                if (isShopOpen()) finish('shop');
                else if (document.querySelectorAll('.dialogue-window-answer').length > 0) finish('answers');
                else finish('timeout');
            }, maxMs);

            check();
