(function () {
    if (!window._uiCacheData) window._uiCacheData = {};
    if (window._uiCacheData.hero) return;

    const STEP_WALK_TIMEOUT_MS  = 30_000;
    const MAP_CHANGE_TIMEOUT_MS = 15_000;
    const LOOP_RESTART_DELAY_MS = 2_000;

    const delay = ms => new Promise(res => setTimeout(res, ms));
    let _aborted = false;

    const randomFastDelay = () => Math.floor(Math.random() * (150 - 50 + 1)) + 50;

    function log(msg, color) {
        const gui = window._uiCacheData.gui;
        if (gui && typeof gui.updateStatus === 'function') {
            gui.updateStatus(msg, color || '#9b59b6');
        }
    }

    function cfg() {
        return window._uiCacheData.gui ? window._uiCacheData.gui.getSettings() : {};
    }

    function isRunning() {
        const c = cfg();
        return !!c.isRunning;
    }

    function getCurrentMapId() {
        return (typeof Engine !== 'undefined' && Engine.map && Engine.map.d)
            ? parseInt(Engine.map.d.id) : null;
    }

    function getHeroPos() {
        return (typeof Engine !== 'undefined' && Engine.hero && Engine.hero.d)
            ? { x: Engine.hero.d.x, y: Engine.hero.d.y }
            : null;
    }

    function expFns() {
        return window._uiCacheData.exp || {};
    }

    function getSelectedHeroData(config) {
        const live = (window._uiCacheData.gui && window._uiCacheData.gui.settings)
            ? window._uiCacheData.gui.settings
            : null;
        const c = live || config || cfg();
        if (!c) return null;
        const heroes = window._uiCacheData.heroes || [];

        const queue = c.heroQueue;
        if (Array.isArray(queue) && queue.length > 0) {
            const idx = Math.max(0, Math.min((c.heroQueueIndex || 0), queue.length - 1));
            const key = queue[idx];
            return heroes.find(h => (h.key || h.id || h.name) === key) || null;
        }

        if (!c.heroSelect) return null;
        return heroes.find(h => (h.key || h.id || h.name) === c.heroSelect) || null;
    }

    // HERO routing is intentionally independent from EXP setup minLevel blocks.
    // Manual danger-map rules remain respected, but automatic EXP safety blocks must not
    // prevent a Hero route from using legitimate transit maps.
    function getHeroManualBlockedMaps(targetMapId) {
        const blocked = new Set();
        try {
            const config = cfg();
            const dangerMaps = config.dangerMaps || [];
            const playerLevel = (typeof Engine !== 'undefined' && Engine.hero && Engine.hero.d)
                ? Number(Engine.hero.d.lvl || 0)
                : 0;

            for (const rule of dangerMaps) {
                if (!rule || !rule.enabled) continue;
                const mapStr = String(rule.mapId);
                if (mapStr === String(targetMapId)) continue;
                if (playerLevel < Number(rule.minLevel || 0)) blocked.add(mapStr);
            }
        } catch (e) {}
        return blocked;
    }

    function getHeroNextHopMap(startMapId, targetMapId) {
        if (!startMapId || !targetMapId) return null;
        if (parseInt(startMapId) === parseInt(targetMapId)) return parseInt(targetMapId);

        const graph = window._uiCacheData.graph || {};
        const start = String(startMapId);
        const target = String(targetMapId);
        const blocked = getHeroManualBlockedMaps(targetMapId);

        const queue = [[start]];
        const visited = new Set([start]);

        while (queue.length) {
            const path = queue.shift();
            const cur = path[path.length - 1];

            for (const n of (graph[cur] || [])) {
                const ns = String(n);
                if (visited.has(ns) || blocked.has(ns)) continue;

                const nextPath = path.concat(ns);
                if (ns === target) return parseInt(nextPath[1]);

                visited.add(ns);
                queue.push(nextPath);
            }
        }
        return null;
    }

    function isLiveHeroNpcData(d) {
        if (!d) return false;
        const wt = Number(d.wt || 0);
        // Native Margonem WT band for Heros: 80-89. Devil used >=80, but that can
        // also swallow later special categories, so Speedy keeps the precise band.
        if (wt < 80 || wt > 89) return false;
        if (d.dead || d.hp === 0 || d.st === 1 || d.st === 2) return false;
        return true;
    }

    function getKnownHeroDataByNpcName(nick) {
        const n = String(nick || '').trim().toLowerCase();
        if (!n) return null;
        return (window._uiCacheData.heroes || []).find(h =>
            String(h.npcName || h.name || '').replace(/\s*\(\d+\)\s*$/, '').trim().toLowerCase() === n
        ) || null;
    }

    function findHeroNpcOnMap(heroData) {
        if (!heroData || typeof Engine === 'undefined' || !Engine.npcs) return null;

        const npcsRaw = typeof Engine.npcs.check === 'function'
            ? Engine.npcs.check()
            : Engine.npcs.d;
        if (!npcsRaw) return null;

        const targetName = (heroData.npcName || heroData.name || '').replace(/\s*\(\d+\)\s*$/, '').trim().toLowerCase();

        for (const k in npcsRaw) {
            const d = npcsRaw[k].d || npcsRaw[k];
            if (!isLiveHeroNpcData(d)) continue;

            const npcName = (d.nick || d.name || '').trim().toLowerCase();
            if (npcName !== targetName) continue;
            return d;
        }
        return null;
    }

    function findAnyHeroNpcOnMap(heroData) {
        // Selected hero always wins if both are visible.
        const selected = findHeroNpcOnMap(heroData);
        if (selected) return { npc: selected, selected: true, heroData };

        if (typeof Engine === 'undefined' || !Engine.npcs) return null;
        const npcsRaw = typeof Engine.npcs.check === 'function' ? Engine.npcs.check() : Engine.npcs.d;
        if (!npcsRaw) return null;

        for (const k in npcsRaw) {
            const d = npcsRaw[k].d || npcsRaw[k];
            if (!isLiveHeroNpcData(d)) continue;
            const matched = getKnownHeroDataByNpcName(d.nick || d.name) || {
                key: '__opportunistic__',
                name: String(d.nick || d.name || 'Nieznany heros'),
                npcName: String(d.nick || d.name || 'Nieznany heros')
            };
            return { npc: d, selected: false, heroData: matched };
        }
        return null;
    }

    async function navigateToMap(targetMapId, setMapCooldown) {
        const { findPathBFS, walkSmoothly, getAllMapTransitions, checkGatewayReachability } = expFns();
        if (!findPathBFS || !walkSmoothly || !getAllMapTransitions || !checkGatewayReachability) {
            await delay(2000); return false;
        }

        const MAX_HOPS = 30;
        for (let hop = 0; hop < MAX_HOPS; hop++) {
            if (_aborted || !isRunning()) return false;

            const currentMapId = getCurrentMapId();
            if (currentMapId === targetMapId) return true;

            const nextHop = getHeroNextHopMap(currentMapId, targetMapId);
            try {
                if (currentMapId === 2020 || targetMapId === 7347) {
                    console.log('[Speedy HERO ROUTE]', { currentMapId, targetMapId, nextHop });
                }
            } catch (e) {}

            // ================= WSTAWKA DLA STWORZYCIELA =================
            if (currentMapId === 1742 && nextHop === 7375) {
                if (window._uiCacheData.handleStworzycielNpcDialog) {
                    await window._uiCacheData.handleStworzycielNpcDialog(walkSmoothly, findPathBFS, delay);
                    if (setMapCooldown) setMapCooldown(true);
                    let stwWait = 0;
                    while (Engine.map.d.id == 1742 && stwWait < 50) { await delay(100); stwWait++; }
                    await delay(1500);
                    if (setMapCooldown) setMapCooldown(false);
                    continue;
                }
            }
            // ============================================================

            if (!nextHop) {
                log(`Brak ścieżki BFS: ${currentMapId} → ${targetMapId}`, '#e74c3c');
                await delay(1500); return false;
            }

            let gwCoords = null;
            let tData = null;
            const transitions = getAllMapTransitions();

            if (currentMapId === 1116) {
                try {
                    console.log('[Speedy HERO GATES 1116]', {
                        targetMapId,
                        nextHop,
                        transitions: transitions.map(t => ({
                            type: t.type,
                            x: t.x,
                            y: t.y,
                            affected: t.affected,
                            id: t.id
                        }))
                    });
                } catch (e) {}
            }

            for (const t of transitions) {
                if (t.affected === nextHop) {
                    let reachCheck = checkGatewayReachability(t.x, t.y, t.type);
                    if (reachCheck) {
                        gwCoords = reachCheck.coords;
                        tData = t;
                        break;
                    }
                }
            }

            if (!gwCoords) {
                let hiddenNpcGates = transitions.filter(t => t.type === 'npc' && !t.affected);
                for (const t of hiddenNpcGates) {
                    let reachCheck = checkGatewayReachability(t.x, t.y, t.type);
                    if (reachCheck) {
                        log(`Przejście ukryte (Fallback) na ID: ${t.id}`, '#f39c12');
                        gwCoords = reachCheck.coords;
                        tData = t;
                        break;
                    }
                }
            }

            if (!gwCoords) {
                log(`Brak bramki do mapy ${nextHop}`, '#e74c3c');
                await delay(1500); return false;
            }

            const pos  = getHeroPos();
            if (!pos) { await delay(500); return false; }

            const path = findPathBFS(pos.x, pos.y, gwCoords.x, gwCoords.y, 2000);
            if (!path || path.length === 0 && (pos.x !== gwCoords.x || pos.y !== gwCoords.y)) {
                log(`Brak ścieżki pieszej do bramki (${currentMapId}→${nextHop})`, '#e74c3c');
                await delay(100); return false;
            }

            log(`🚶 ${currentMapId} → ${nextHop}`);
            const reached = await walkSmoothly(path, () => _aborted || !isRunning());
            if (!reached) return false;

            if (tData && tData.type === 'npc') {
                log(`🗣️ Aktywacja przejścia NPC (ID: ${tData.id})`, '#f39c12');
                try {
                    if (typeof Engine.hero.talkNearMob === 'function') Engine.hero.talkNearMob(tData.id);
                    else window._g(`talk&id=${tData.id}`);
                } catch(e) { window._g(`talk&id=${tData.id}`); }
            } else if (pos.x === gwCoords.x && pos.y === gwCoords.y) {
                 if (typeof Engine.hero.getTroughGateway === 'function') Engine.hero.getTroughGateway();
            }

            if (setMapCooldown) setMapCooldown(true);
            const deadline = Date.now() + MAP_CHANGE_TIMEOUT_MS;
            while (getCurrentMapId() === currentMapId && Date.now() < deadline) {
                await delay(50);
            }
            if (setMapCooldown) setMapCooldown(false);

            if (getCurrentMapId() === currentMapId) {
                log(`Timeout zmiany mapy ${currentMapId} → ${nextHop}`, '#e74c3c');
                return false;
            }

            await delay(randomFastDelay());
        }
        return false;
    }

    const HERO_RESP_VISION_RANGE = 9;

    function manhattanDistance(ax, ay, bx, by) {
        return Math.abs(parseInt(ax) - parseInt(bx)) + Math.abs(parseInt(ay) - parseInt(by));
    }

    function isRespInVisionRange(x, y, range = HERO_RESP_VISION_RANGE) {
        const pos = getHeroPos();
        if (!pos) return false;
        return manhattanDistance(pos.x, pos.y, x, y) <= range;
    }

    async function walkToRespVisionRange(x, y, range = HERO_RESP_VISION_RANGE) {
        const { findPathBFS, walkSmoothly } = expFns();
        if (!findPathBFS || !walkSmoothly) return false;

        const pos = getHeroPos();
        if (!pos) return false;

        const startDist = manhattanDistance(pos.x, pos.y, x, y);
        if (startDist <= range) {
            log(`👁️ Resp [${x},${y}] już w zasięgu: ${startDist}/${range} pól`, '#27ae60');
            return true;
        }

        // Wyznaczamy zwykłą ścieżkę do respu, ale ucinamy ją w pierwszym miejscu,
        // z którego dystans Manhattan do punktu respu wynosi <= range.
        let path = findPathBFS(pos.x, pos.y, x, y, 2000);

        if (!path) {
            // Bezpieczny fallback: zachowujemy starą logikę dokładnego dojścia.
            // Dzięki temu ta optymalizacja nie psuje respów z nietypową kolizją.
            return walkToPoint(x, y);
        }

        let stopIndex = -1;
        for (let i = 0; i < path.length; i++) {
            const p = path[i];
            if (manhattanDistance(p.x, p.y, x, y) <= range) {
                stopIndex = i;
                break;
            }
        }

        if (stopIndex < 0) {
            // Teoretycznie nie powinno się zdarzyć, skoro pełna ścieżka dochodzi do celu.
            return walkToPoint(x, y);
        }

        const shortenedPath = path.slice(0, stopIndex + 1);
        if (shortenedPath.length > 0) {
            log(`👁️ Skracam dojście do respu [${x},${y}] → zatrzymam się w zasięgu ${range} pól`, '#3498db');
            const deadline = Date.now() + STEP_WALK_TIMEOUT_MS;
            const reached = await walkSmoothly(
                shortenedPath,
                () => _aborted || !isRunning() || Date.now() > deadline || !!_heroMidWalkFound
            );

            // walkSmoothly() może zwrócić false np. po timeout/callbacku mimo że postać
            // faktycznie zdążyła wejść w wymagany zasięg respu. Nie ufamy więc samemu
            // wynikowi walkSmoothly — źródłem prawdy jest końcowa pozycja sprawdzana niżej.
            if (!reached && !_heroMidWalkFound) {
                const currentPos = getHeroPos();
                const currentDist = currentPos
                    ? manhattanDistance(currentPos.x, currentPos.y, x, y)
                    : Infinity;
                if (currentDist <= range) {
                    log(`✅ Resp [${x},${y}] osiągnięty mimo wyniku walkSmoothly=false: ${currentDist}/${range} pól`, '#27ae60');
                    return true;
                }
                return false;
            }
        }

        const endPos = getHeroPos();
        if (!endPos) return false;

        const endDist = manhattanDistance(endPos.x, endPos.y, x, y);
        const inRange = endDist <= range;

        if (inRange) {
            log(`✅ Resp [${x},${y}] sprawdzony z ${endDist}/${range} pól`, '#27ae60');
        }

        return inRange;
    }

    async function walkToPoint(x, y) {
        const { findPathBFS, walkSmoothly } = expFns();
        if (!findPathBFS || !walkSmoothly) return false;

        const pos = getHeroPos();
        if (!pos) return false;
        if (pos.x === x && pos.y === y) return true;

        let path = findPathBFS(pos.x, pos.y, x, y, 2000);

        if (!path) {
            const offsets = [
                {dx: 0, dy: -1}, {dx: 0, dy: 1}, {dx: -1, dy: 0}, {dx: 1, dy: 0},
                {dx: -1, dy: -1}, {dx: 1, dy: -1}, {dx: -1, dy: 1}, {dx: 1, dy: 1},
                {dx: 0, dy: -2}, {dx: 0, dy: 2}, {dx: -2, dy: 0}, {dx: 2, dy: 0}
            ];
            let best = null;
            let bestDist = Infinity;
            for (const {dx, dy} of offsets) {
                const nx = x + dx, ny = y + dy;
                const alt = findPathBFS(pos.x, pos.y, nx, ny, 2000);
                if (alt !== null) {
                    const dist = Math.abs(dx) + Math.abs(dy);
                    if (dist < bestDist) {
                        bestDist = dist;
                        best = alt;
                    }
                }
            }
            if (best) {
                log(`🔀 Cel [${x},${y}] zajęty – omijam przez sąsiednie pole`, '#e67e22');
                path = best;
            } else {
                return false;
            }
        }

        if (path.length === 0) return true;

        const deadline = Date.now() + STEP_WALK_TIMEOUT_MS;
        return walkSmoothly(path, () => _aborted || !isRunning() || Date.now() > deadline);
    }

    function isHeroStillAlive(npcId) {
        const npcsRaw = typeof Engine.npcs.check === 'function' ? Engine.npcs.check() : Engine.npcs.d;
        return !!(npcsRaw && Object.values(npcsRaw).some(n => {
            const d = n.d || n;
            return d && d.id === npcId && !d.dead && d.hp !== 0 && d.st !== 1 && d.st !== 2;
        }));
    }

    async function waitNextToHero(npc) {
        if (!npc) return;
        const { findPathBFS, walkSmoothly } = expFns();
        if (!findPathBFS || !walkSmoothly) return;

        log(`🕐 Bij Herosa wyłączone – stoję obok: ${npc.nick || npc.name || npc.id} [${npc.x}, ${npc.y}]`, '#e67e22');

        const pos = getHeroPos();
        if (pos) {
            const dist = Math.max(Math.abs(pos.x - npc.x), Math.abs(pos.y - npc.y));
            if (dist > 1) {
                const path = findPathBFS(pos.x, pos.y, npc.x, npc.y, 400);
                if (path && path.length > 0)
                    await walkSmoothly(path, () => _aborted || !isRunning());
            }
        }

        const deadline = Date.now() + 10 * 60_000;
        while (!_aborted && isRunning() && Date.now() < deadline) {
            if (!isHeroStillAlive(npc.id)) {
                log('💀 Heros pokonany przez gracza!', '#27ae60');
                return;
            }
            const npcsRaw = typeof Engine.npcs.check === 'function' ? Engine.npcs.check() : Engine.npcs.d;
            if (npcsRaw) {
                for (const k in npcsRaw) {
                    const d = npcsRaw[k].d || npcsRaw[k];
                    if (d && d.id === npc.id) {
                        const curPos = getHeroPos();
                        if (curPos) {
                            const d2 = Math.max(Math.abs(curPos.x - d.x), Math.abs(curPos.y - d.y));
                            if (d2 > 1) {
                                const path = findPathBFS(curPos.x, curPos.y, d.x, d.y, 400);
                                if (path && path.length > 0)
                                    await walkSmoothly(path, () => _aborted || !isRunning());
                            }
                        }
                        break;
                    }
                }
            }
            await delay(500);
        }
        if (Date.now() >= deadline)
            log('⏱️ Timeout czekania na zabicie herosa – wznawiam trasę.', '#e67e22');
    }

    function isBattleVisible() {
        try {
            return !!(Engine.battle && Engine.battle.getShow && Engine.battle.getShow());
        } catch (_) {
            return false;
        }
    }

    function isAggressiveHeroNpc(npc) {
        if (!npc) return false;

        // Jeśli klient wystawia jawny znacznik agresji, ma pierwszeństwo.
        for (const key of ['aggressive', 'aggr', 'aggro', 'isAggressive']) {
            if (npc[key] !== undefined && npc[key] !== null) {
                const v = npc[key];
                if (typeof v === 'string') return v === '1' || v.toLowerCase() === 'true';
                return !!v;
            }
        }

        // W danych NPC Margonem typ 3 jest wariantem agresywnym moba.
        return parseInt(npc.type, 10) === 3;
    }

    function getCardinalApproachPath(npc, findPathBFS) {
        const pos = getHeroPos();
        if (!pos || !npc || !findPathBFS) return null;

        const dxNow = Math.abs(pos.x - npc.x);
        const dyNow = Math.abs(pos.y - npc.y);
        if (dxNow + dyNow === 1) {
            return { path: [], x: pos.x, y: pos.y };
        }

        const candidates = [
            { x: npc.x,     y: npc.y - 1 },
            { x: npc.x + 1, y: npc.y     },
            { x: npc.x,     y: npc.y + 1 },
            { x: npc.x - 1, y: npc.y     }
        ];

        let best = null;
        for (const c of candidates) {
            const path = findPathBFS(pos.x, pos.y, c.x, c.y, 600);
            if (path === null || path === undefined) continue;
            if (!best || path.length < best.path.length) best = { path, x: c.x, y: c.y };
        }
        return best;
    }

    async function approachHeroCardinal(npc, findPathBFS, walkSmoothly) {
        const approach = getCardinalApproachPath(npc, findPathBFS);
        if (!approach) {
            log(`⚠️ Brak dostępnej prostej kratki obok herosa [${npc.x},${npc.y}]`, '#e67e22');
            return false;
        }

        if (approach.path.length > 0) {
            log(`🧭 Podejście obok herosa → [${approach.x},${approach.y}]`, '#3498db');
            const ok = await walkSmoothly(approach.path, () => _aborted || !isRunning() || isBattleVisible());
            if (!ok && !isBattleVisible()) return false;
        }

        if (isBattleVisible()) return true;
        const pos = getHeroPos();
        return !!pos && (Math.abs(pos.x - npc.x) + Math.abs(pos.y - npc.y) === 1);
    }

    async function waitForAggroOrTimeout(npcId, waitMs = 2000) {
        const deadline = Date.now() + waitMs;
        while (!_aborted && isRunning() && Date.now() < deadline) {
            if (isBattleVisible()) return true;
            if (!isHeroStillAlive(npcId)) return true;
            await delay(100);
        }
        return isBattleVisible();
    }

    async function attackHeroNpc(npc, config = null) {
        if (!npc) return;
        const { findPathBFS, walkSmoothly } = expFns();
        if (!findPathBFS || !walkSmoothly) return;

        const live = (window._uiCacheData.gui && window._uiCacheData.gui.settings)
            ? window._uiCacheData.gui.settings
            : (config || {});
        const smartAggro = false; // Smart Aggro należy wyłącznie do EXP
        const aggressive = isAggressiveHeroNpc(npc);

        log(`⚔️ Heros: ${npc.nick || npc.name || npc.id} [${npc.x}, ${npc.y}] | ${aggressive ? 'AGRESYWNY' : 'nieagresywny'}${smartAggro ? ' | Smart aggro' : ''}`, '#e74c3c');

        const ATTACK_TIMEOUT_MS = 60_000;
        const deadline = Date.now() + ATTACK_TIMEOUT_MS;
        let aggroWaitDone = false;
        let lastAttackRequestAt = 0;

        while (!_aborted && isRunning() && Date.now() < deadline) {
            if (!isHeroStillAlive(npc.id)) {
                log('💀 Heros pokonany!', '#27ae60');
                break;
            }

            // Jeżeli walka już wystartowała (np. z auto-agro), nie wysyłamy kolejnych requestów.
            if (isBattleVisible()) {
                await delay(300);
                continue;
            }

            // Zawsze ustawiamy się na kratce ortogonalnej obok celu. To usuwa problem
            // pozycji po skosie, kiedy boczne kratki przy NPC są kolizyjne.
            const pos = getHeroPos();
            const cardinalAdjacent = pos && (Math.abs(pos.x - npc.x) + Math.abs(pos.y - npc.y) === 1);
            if (!cardinalAdjacent) {
                const reached = await approachHeroCardinal(npc, findPathBFS, walkSmoothly);
                if (isBattleVisible()) {
                    await delay(300);
                    continue;
                }
                if (!reached) {
                    await delay(400);
                    continue;
                }
            }

            if (smartAggro && aggressive && !aggroWaitDone) {
                aggroWaitDone = true;
                log('🛡️ Agresywny heros – czekam 2 s na auto-atak...', '#f1c40f');
                const autoStarted = await waitForAggroOrTimeout(npc.id, 2000);
                if (autoStarted) {
                    log('✅ Auto-agro uruchomiło walkę – bez ręcznego ataku.', '#27ae60');
                    await delay(300);
                    continue;
                }
                log('⏱️ Brak auto-ataku po 2 s – wysyłam atak awaryjny.', '#e67e22');
            }

            // Nieagresywny: natychmiast. Agresywny: dopiero po 2 s fallbacku.
            if (!isBattleVisible() && Date.now() - lastAttackRequestAt >= 800) {
                lastAttackRequestAt = Date.now();
                Engine.hero.heroAtackRequest(npc.id, !0);
            }

            await delay(200);
        }
    }

    async function onHeroFound(heroData, npc, config) {
        notifyHeroFound(heroData, getCurrentMapId(), npc.x, npc.y);

        const live = (window._uiCacheData.gui && window._uiCacheData.gui.settings)
            ? window._uiCacheData.gui.settings
            : config;

        if (live.heroBicie) {
            await attackHeroNpc(npc, live);
        } else {
            await waitNextToHero(npc);
        }

        _routeIndex     = -1;
        _currentHeroKey = null;

        const queue   = live.heroQueue || [];
        const inQueue = queue.length > 0;

        if (inQueue) {
            const currentIdx = live.heroQueueIndex || 0;
            const nextIdx    = currentIdx + 1;

            if (nextIdx < queue.length) {
                log(`➡️ Kolejka: ${currentIdx + 1}/${queue.length} ukończony – przechodzę do ${nextIdx + 1}/${queue.length}`, '#9b59b6');
                if (window._uiCacheData.gui) {
                    window._uiCacheData.gui.settings.heroQueueIndex = nextIdx;
                    window._uiCacheData.gui.saveSettings();
                    if (typeof window._uiCacheData.gui.renderHeroQueue === 'function')
                        window._uiCacheData.gui.renderHeroQueue();
                    if (typeof window._uiCacheData.gui.updateHeroQueueCurrent === 'function')
                        window._uiCacheData.gui.updateHeroQueueCurrent(queue[nextIdx]);
                }
                saveState();
                await delay(LOOP_RESTART_DELAY_MS);

            } else {
                if (live.heroPetla) {
                    log('🔄 Kolejka ukończona – restart od początku...', '#9b59b6');
                    if (window._uiCacheData.gui) {
                        window._uiCacheData.gui.settings.heroQueueIndex = 0;
                        window._uiCacheData.gui.saveSettings();
                        if (typeof window._uiCacheData.gui.renderHeroQueue === 'function')
                            window._uiCacheData.gui.renderHeroQueue();
                        if (typeof window._uiCacheData.gui.updateHeroQueueCurrent === 'function')
                            window._uiCacheData.gui.updateHeroQueueCurrent(queue[0]);
                    }
                    saveState();
                    await delay(LOOP_RESTART_DELAY_MS);
                } else {
                    log('✅ Kolejka ukończona (pętla wyłączona) – zatrzymuję.', '#27ae60');
                    if (window._uiCacheData.gui) {
                        window._uiCacheData.gui.settings.heroQueueIndex = 0;
                        window._uiCacheData.gui.saveSettings();
                        if (typeof window._uiCacheData.gui.updateHeroQueueCurrent === 'function')
                            window._uiCacheData.gui.updateHeroQueueCurrent(null);
                        window._uiCacheData.gui.forceStop('Kolejka herosów ukończona');
                    }
                    clearState();
                }
            }

        } else {
            _routeDone = !live.heroPetla;
            if (live.heroPetla) {
                log('🔄 Heros pokonany – restart pętli...', '#9b59b6');
                saveState();
                await delay(LOOP_RESTART_DELAY_MS);
            } else {
                clearState();
                if (window._uiCacheData.gui) window._uiCacheData.gui.forceStop('Heros pokonany');
            }
        }
    }

    async function onOpportunisticHeroFound(selectedHeroData, detectedHeroData, npc, config) {
        log(`🎯 Przypadkowy heros podczas patrolu ${selectedHeroData.name}: ${detectedHeroData.name || npc.nick}`, '#e67e22');
        notifyHeroFound(detectedHeroData, getCurrentMapId(), npc.x, npc.y);
        const live = (window._uiCacheData.gui && window._uiCacheData.gui.settings) ? window._uiCacheData.gui.settings : config;
        if (live.heroBicie) await attackHeroNpc(npc, live);
        else await waitNextToHero(npc);
        // Critical difference vs selected target: do NOT advance queue and do NOT reset route.
        // Resume from exactly the current patrol step after the incidental hero disappears.
        saveState();
        await delay(randomFastDelay());
    }

    async function executeHeroNpcAction(step) {
        const npcsRaw = (typeof Engine !== 'undefined' && Engine.npcs)
            ? (typeof Engine.npcs.check === 'function' ? Engine.npcs.check() : Engine.npcs.d)
            : null;
        if (!npcsRaw) return false;
        const wanted = String(step.npcName || '').trim().toLowerCase();
        let npc = null;
        for (const k in npcsRaw) {
            const d = npcsRaw[k].d || npcsRaw[k];
            if (String(d && (d.nick || d.name) || '').trim().toLowerCase() === wanted) { npc = d; break; }
        }
        if (!npc) {
            log(`⚠️ Hero special: nie widzę NPC ${step.npcName}`, '#e67e22');
            return false;
        }
        const { findPathBFS, walkSmoothly } = expFns();
        if (findPathBFS && walkSmoothly) await approachHeroCardinal(npc, findPathBFS, walkSmoothly);
        try {
            if (typeof Engine.hero.talkNearMob === 'function') Engine.hero.talkNearMob(npc.id);
            else window._g(`talk&id=${npc.id}`);
        } catch (e) { try { window._g(`talk&id=${npc.id}`); } catch (_) {} }

        const dialog = Array.isArray(step.dialog) ? step.dialog : [];
        for (const rawIdx of dialog) {
            const idx = Math.max(0, Number(rawIdx) - 1);
            let clicked = false;
            const deadline = Date.now() + 2500;
            while (!clicked && Date.now() < deadline) {
                const opts = document.querySelectorAll('.dialogue-window-answer, .answer.line_option');
                if (opts[idx]) {
                    try { opts[idx].click(); clicked = true; } catch (e) {}
                }
                if (!clicked) await delay(80);
            }
            await delay(120);
        }
        return true;
    }

    function notifyHeroFound(heroData, mapId, x, y) {
        log(`✅ HEROS: ${heroData.name} | mapa ${mapId} [${x}, ${y}]`, '#27ae60');
    }

    const LS_KEY = '_autohero_state';

    function loadState() {
        try {
            const raw = localStorage.getItem(LS_KEY);
            if (!raw) return;
            const s = JSON.parse(raw);
            if (s.heroKey)      _currentHeroKey = s.heroKey;
            if (typeof s.routeIndex === 'number') _routeIndex = s.routeIndex;
            if (typeof s.routeStartIndex === 'number') _routeStartIndex = s.routeStartIndex;
            if (s.routeDirection === -1 || s.routeDirection === 1) {
                _routeDirection = s.routeDirection;
            } else {
                // Migracja stanu z v17: stary zapis nie znał kierunku trasy.
                // Wymuszamy ponowny wybór startu/kierunku z aktualnej mapy,
                // żeby końcówka trasy nie próbowała zawijać globalnym skrótem.
                _routeIndex = -1;
                _routeStartIndex = -1;
            }
        } catch (e) { }
    }

    function getHeroPatrolRoute(heroData) {
        if (heroData && Array.isArray(heroData.devilScanRoute) && heroData.devilScanRoute.length) {
            return heroData.devilScanRoute;
        }
        return Array.isArray(heroData && heroData.route) ? heroData.route : [];
    }

    function graphDistanceForHero(startMapId, targetMapId, maxDepth = 80) {
        const start = String(startMapId), target = String(targetMapId);
        if (start === target) return 0;
        const graph = window._uiCacheData.graph || {};
        const blocked = getHeroManualBlockedMaps(targetMapId);
        const q = [[start, 0]];
        const seen = new Set([start]);
        while (q.length) {
            const [cur, dist] = q.shift();
            if (dist >= maxDepth) continue;
            for (const n of (graph[cur] || [])) {
                const ns = String(n);
                if (seen.has(ns) || blocked.has(ns)) continue;
                if (ns === target) return dist + 1;
                seen.add(ns); q.push([ns, dist + 1]);
            }
        }
        return Infinity;
    }

    function chooseNearestHeroEntryIndex(heroData, currentMapId) {
        const route = getHeroPatrolRoute(heroData);
        if (!route.length) return 0;
        const current = Number(currentMapId);
        const pos = getHeroPos();

        // If already on a patrol map, enter at the nearest scan/resp point on this map.
        const local = [];
        for (let i = 0; i < route.length; i++) {
            const st = route[i];
            if (Number(st.mapId) !== current) continue;
            const type = String(st.type || 'resp').toLowerCase();
            if ((type === 'scan' || type === 'resp') && Number.isFinite(Number(st.x)) && Number.isFinite(Number(st.y)) && pos) {
                local.push({ i, d: manhattanDistance(pos.x, pos.y, st.x, st.y) });
            }
        }
        if (local.length) {
            local.sort((a,b) => a.d - b.d);
            return local[0].i;
        }
        const sameMap = route.findIndex(st => Number(st.mapId) === current);
        if (sameMap >= 0) return sameMap;

        // Outside the patrol: choose the closest reachable patrol map, not one hardcoded start map.
        const firstIndexByMap = new Map();
        for (let i = 0; i < route.length; i++) {
            const id = Number(route[i].mapId);
            if (id && !firstIndexByMap.has(id)) firstIndexByMap.set(id, i);
        }
        let best = { i: 0, d: Infinity };
        for (const [mapId, i] of firstIndexByMap.entries()) {
            const d = graphDistanceForHero(current, mapId);
            if (d < best.d) best = { i, d };
        }
        return Number.isFinite(best.d) ? best.i : 0;
    }

    function resyncRouteIndexToCurrentMap(heroData) {
        if (!heroData || !getHeroPatrolRoute(heroData).length) return false;

        const currentMapId = getCurrentMapId();
        if (!currentMapId) return false;

        // routeIndex jest indeksem w OBRÓCONYM cyklu, więc resync również
        // musi pracować na tej samej kolejności, a nie na surowym heroData.route.
        const activeRoute = getCyclicHeroRoute(heroData);

        if (_routeIndex >= 0 && _routeIndex < activeRoute.length) {
            const currentStep = activeRoute[_routeIndex];
            if (currentStep && parseInt(currentStep.mapId) === parseInt(currentMapId)) {
                return false;
            }
        }

        // Znajdź wszystkie kroki należące do aktualnej mapy w aktywnym cyklu.
        const indexes = [];
        for (let i = 0; i < activeRoute.length; i++) {
            if (parseInt(activeRoute[i].mapId) === parseInt(currentMapId)) {
                indexes.push(i);
            }
        }

        if (!indexes.length) return false;

        // Preferujemy ostatni krok na tej mapie oznaczony jako transition,
        // bo jego zadaniem jest wyjść na kolejną mapę trasy.
        // Vapor: na 1116 wybierze order 3, czyli [22,95] -> 7830.
        let chosen = -1;
        for (const i of indexes) {
            if (activeRoute[i] && activeRoute[i].type === 'transition') {
                chosen = i;
            }
        }

        // Jeżeli nie ma transition, wracamy do pierwszego kroku na tej mapie.
        if (chosen < 0) chosen = indexes[0];

        const old = _routeIndex;
        _routeIndex = chosen;
        saveState();

        log(
            `🔄 Resync trasy ${heroData.name}: zapisany krok ${old + 1} nie pasował do mapy ${currentMapId}; ustawiam krok ${chosen + 1}/${activeRoute.length}`,
            '#f39c12'
        );

        return true;
    }

    function saveState() {
        try {
            localStorage.setItem(LS_KEY, JSON.stringify({
                heroKey:         _currentHeroKey,
                routeIndex:      _routeIndex,
                routeStartIndex: _routeStartIndex,
                routeDirection:  _routeDirection
            }));
        } catch (e) {}
    }

    function clearState() {
        try { localStorage.removeItem(LS_KEY); } catch (e) {}
    }

    let _routeIndex       = -1;
    let _routeStartIndex  = -1;
    let _routeDirection   = 1; // 1 = zgodnie z planem, -1 = od końca
    let _currentHeroKey   = null;
    let _routeDone        = false;
    let _heroMidWalkFound = null;

    // Resync routeIndex służy WYŁĄCZNIE do naprawienia starego stanu
    // po F5 / przeładowaniu userscripta. Nie wolno odpalać go co tick,
    // bo po przejściu do kroku na następnej mapie cofał indeks na starą mapę.
    let _needsInitialRouteResync = true;

    loadState();

    function getDirectionalBaseRoute(heroData) {
        const route = getHeroPatrolRoute(heroData);
        // Devil routes are ordered scan patrols. Reversing them would invalidate explicit
        // transition/NPC steps, so keep their authored direction. Exact-resp fallback routes
        // retain Speedy's old reverse-tail behavior.
        if (heroData && Array.isArray(heroData.devilScanRoute) && heroData.devilScanRoute.length) return route;
        if (_routeDirection === -1) return route.slice().reverse();
        return route;
    }

    function getCyclicHeroRoute(heroData) {
        const route = getDirectionalBaseRoute(heroData);
        if (!route.length) return route;
        const start = (_routeStartIndex >= 0 && _routeStartIndex < route.length) ? _routeStartIndex : 0;
        if (start === 0) return route;
        return route.slice(start).concat(route.slice(0, start));
    }

    function chooseRouteDirection(heroData, currentMapId) {
        const patrol = getHeroPatrolRoute(heroData);
        if (!heroData || !patrol.length) return 1;
        if (Array.isArray(heroData.devilScanRoute) && heroData.devilScanRoute.length) return 1;
        const current = parseInt(currentMapId);
        if (!current) return 1;

        const firstMapId = parseInt(patrol[0] && patrol[0].mapId);
        const lastMapId = parseInt(patrol[patrol.length - 1] && patrol[patrol.length - 1].mapId);

        // Kluczowa zasada Hero: jeśli gracz jest na KOŃCU zapisanej trasy,
        // nie zawijamy cyklu do początku przez globalny skrót. Robimy trasę od tyłu.
        if (current === lastMapId && lastMapId !== firstMapId) return -1;
        return 1;
    }

    function chooseCycleStartIndex(heroData, currentMapId) {
        if (Array.isArray(heroData && heroData.devilScanRoute) && heroData.devilScanRoute.length) {
            return chooseNearestHeroEntryIndex(heroData, currentMapId);
        }
        const route = getDirectionalBaseRoute(heroData);
        if (!route.length) return 0;
        const current = parseInt(currentMapId);
        if (!current) return 0;
        for (let i = 0; i < route.length; i++) {
            if (parseInt(route[i].mapId) === current) return i;
        }
        return 0;
    }

    async function handleHeroHunting(config, setMapCooldown) {
        _aborted = false;

        const liveConfig = (window._uiCacheData.gui && window._uiCacheData.gui.settings)
            ? window._uiCacheData.gui.settings
            : config;

        const heroData = getSelectedHeroData(liveConfig);
        if (!heroData) {
            log('⚠️ Kolejka pusta – dodaj herosów do kolejki', '#e67e22');
            await delay(1000); return;
        }

        // Wpisy bez uzupełnionej trasy są widoczne w GUI, ale nie wolno
        // próbować nawigować do startMapId=null/0.
        if (heroData.ready === false || !getHeroPatrolRoute(heroData).length) {
            log(`⚠️ ${heroData.name}: brak uzupełnionej trasy – pomijam.`, '#e67e22');
            const queue = liveConfig.heroQueue || [];
            if (queue.length > 0) {
                const currentIdx = Math.max(0, liveConfig.heroQueueIndex || 0);
                const nextIdx = currentIdx + 1 < queue.length ? currentIdx + 1 : (liveConfig.heroPetla ? 0 : -1);
                if (nextIdx >= 0 && nextIdx !== currentIdx && window._uiCacheData.gui) {
                    window._uiCacheData.gui.settings.heroQueueIndex = nextIdx;
                    window._uiCacheData.gui.saveSettings();
                    if (typeof window._uiCacheData.gui.renderHeroQueue === 'function') window._uiCacheData.gui.renderHeroQueue();
                    if (typeof window._uiCacheData.gui.updateHeroQueueCurrent === 'function') window._uiCacheData.gui.updateHeroQueueCurrent(queue[nextIdx]);
                }
            }
            await delay(1000);
            return;
        }

        if (_currentHeroKey !== heroData.key) {
            _currentHeroKey  = heroData.key;
            _routeIndex      = -1;
            _routeDone       = false;
            _routeDirection  = chooseRouteDirection(heroData, getCurrentMapId());
            _routeStartIndex = chooseCycleStartIndex(heroData, getCurrentMapId());
            _needsInitialRouteResync = false;
            saveState();
            const directionalRoute = getDirectionalBaseRoute(heroData);
            const startStep = directionalRoute[_routeStartIndex];
            log(`Nowy heros: ${heroData.name} | Trasa ${_routeDirection === -1 ? 'OD TYŁU' : 'do przodu'} od mapy ${startStep ? startStep.mapId : heroData.startMapId}.`);
        }

        if (window._uiCacheData.gui && typeof window._uiCacheData.gui.updateHeroQueueCurrent === 'function') {
            window._uiCacheData.gui.updateHeroQueueCurrent(heroData.key);
        }

        // localStorage może pamiętać routeIndex z wcześniejszego uruchomienia/skryptu.
        // Naprawiamy go TYLKO RAZ po starcie/reloadzie. Potem routeIndex jest
        // autorytatywny i może prawidłowo wskazać krok na następnej mapie.
        if (_needsInitialRouteResync) {
            if (_routeIndex >= 0) {
                resyncRouteIndexToCurrentMap(heroData);
            }
            _needsInitialRouteResync = false;
        }

        if (_routeDone) {
            await delay(500); return;
        }

        if (_routeIndex === -1) {
            const rawRoute = getHeroPatrolRoute(heroData);
            const currentMapId = getCurrentMapId();
            _routeDirection = chooseRouteDirection(heroData, currentMapId);
            _routeStartIndex = chooseCycleStartIndex(heroData, currentMapId);
            const directionalRoute = getDirectionalBaseRoute(heroData);
            const startStep = directionalRoute[_routeStartIndex] || directionalRoute[0];

            if (startStep && Number(currentMapId) !== Number(startStep.mapId)) {
                log(`🗺️ Najbliższe wejście w patrol ${heroData.name}: mapa ${startStep.mapId} (zamiast sztywnego startu ${heroData.startMapId || heroData.devilStartMapId || '?'})...`);
                const ok = await navigateToMap(Number(startStep.mapId), setMapCooldown);
                if (!ok) return;
                await delay(randomFastDelay());
            } else {
                log(`🔄 Start patrolu od aktualnej mapy ${currentMapId}, krok bazowy ${_routeStartIndex + 1}/${directionalRoute.length}`, '#9b59b6');
            }

            _routeIndex = 0;
            saveState();
            return;
        }

        const route = getCyclicHeroRoute(heroData);

        if (_routeIndex >= route.length) {
            const queue   = liveConfig.heroQueue || [];
            const inQueue = queue.length > 0;

            if (liveConfig.heroPetla && !inQueue) {
                log('🔄 Trasa ukończona – restart od mapy startowej...');
                _routeIndex = -1;
                saveState();
                await delay(LOOP_RESTART_DELAY_MS);
            } else if (inQueue) {
                const currentIdx = liveConfig.heroQueueIndex || 0;
                const nextIdx    = currentIdx + 1 < queue.length ? currentIdx + 1 : (liveConfig.heroPetla ? 0 : -1);
                log(`⏭️ Trasa ${heroData.name} ukończona bez znalezienia – ${nextIdx >= 0 ? 'następny w kolejce' : 'koniec kolejki'}`, '#e67e22');
                if (nextIdx >= 0) {
                    if (window._uiCacheData.gui) {
                        window._uiCacheData.gui.settings.heroQueueIndex = nextIdx;
                        window._uiCacheData.gui.saveSettings();
                        if (typeof window._uiCacheData.gui.renderHeroQueue === 'function')
                            window._uiCacheData.gui.renderHeroQueue();
                        if (typeof window._uiCacheData.gui.updateHeroQueueCurrent === 'function')
                            window._uiCacheData.gui.updateHeroQueueCurrent(queue[nextIdx]);
                    }
                    _routeIndex      = -1;
                    _routeStartIndex = -1;
                    _routeDirection  = 1;
                    _currentHeroKey  = null;
                    saveState();
                    await delay(LOOP_RESTART_DELAY_MS);
                } else {
                    log('✅ Kolejka ukończona (pętla wyłączona) – zatrzymuję.', '#27ae60');
                    if (window._uiCacheData.gui) {
                        window._uiCacheData.gui.settings.heroQueueIndex = 0;
                        window._uiCacheData.gui.saveSettings();
                        if (typeof window._uiCacheData.gui.updateHeroQueueCurrent === 'function')
                            window._uiCacheData.gui.updateHeroQueueCurrent(null);
                        window._uiCacheData.gui.forceStop('Kolejka herosów ukończona');
                    }
                    _routeIndex = -1;
                    clearState();
                }
            } else {
                log('✅ Trasa ukończona (pętla wyłączona) – zatrzymuję.', '#27ae60');
                _routeIndex = -1;
                _routeStartIndex = -1;
                clearState();
                if (window._uiCacheData.gui) window._uiCacheData.gui.forceStop('Trasa herosa ukończona');
            }
            return;
        }

        const step = route[_routeIndex];
        const stepType = String(step.type || 'resp').toLowerCase();
        const stepDesc = (Number.isFinite(Number(step.x)) && Number.isFinite(Number(step.y))) ? ` [${step.x}, ${step.y}]` : '';
        log(`👣 Krok ${_routeIndex + 1}/${route.length} → ${stepType} mapa ${step.mapId}${stepDesc}${step.targetMapId ? ` → ${step.targetMapId}` : ''}`);

        // A previous NPC/dialog step may already have moved us to the transition target.
        if ((stepType === 'transition' || stepType === 'namedtransition' || stepType === 'npctransition') && Number(getCurrentMapId()) === Number(step.targetMapId)) {
            _routeIndex++; saveState(); return;
        }

        if (getCurrentMapId() !== Number(step.mapId)) {
            log(`🧭 Hero route target: current=${getCurrentMapId()} routeIndex=${_routeIndex} target=${step.mapId} type=${stepType}`);
            const ok = await navigateToMap(Number(step.mapId), setMapCooldown);
            if (!ok) return;
            await delay(randomFastDelay());
        }

        const entryDetection = findAnyHeroNpcOnMap(heroData);
        if (entryDetection) {
            if (entryDetection.selected) await onHeroFound(heroData, entryDetection.npc, liveConfig);
            else await onOpportunisticHeroFound(heroData, entryDetection.heroData, entryDetection.npc, liveConfig);
            return;
        }

        if (stepType === 'transition' || stepType === 'namedtransition') {
            const ok = await navigateToMap(Number(step.targetMapId), setMapCooldown);
            if (!ok) return;
            _routeIndex++; saveState(); return;
        }

        if (stepType === 'npcaction' || stepType === 'npctransition') {
            const beforeMap = getCurrentMapId();
            const ok = await executeHeroNpcAction(step);
            if (!ok) { await delay(500); return; }
            if (stepType === 'npctransition' && step.targetMapId) {
                const deadline = Date.now() + MAP_CHANGE_TIMEOUT_MS;
                while (Number(getCurrentMapId()) === Number(beforeMap) && Date.now() < deadline) await delay(80);
                if (Number(getCurrentMapId()) !== Number(step.targetMapId)) {
                    const navOk = await navigateToMap(Number(step.targetMapId), setMapCooldown);
                    if (!navOk) return;
                }
            }
            _routeIndex++; saveState(); return;
        }

        _heroMidWalkFound = null;
        const _midWalkTimer = setInterval(() => {
            if (_heroMidWalkFound || _aborted || !isRunning()) return;
            const found = findAnyHeroNpcOnMap(heroData);
            if (found) {
                _heroMidWalkFound = found;
                log(`👁️ Heros wykryty podczas chodzenia: ${found.npc.nick || found.npc.name} [${found.npc.x}, ${found.npc.y}]`, '#e74c3c');
            }
        }, 250);

        // Exact Speedy resp = stop as soon as the exact resp is within vision range.
        // Devil scan point = stand on the authored vantage tile, then scan the whole visible map.
        const isRespStep = stepType === 'resp';
        const reached = isRespStep
            ? await walkToRespVisionRange(step.x, step.y, HERO_RESP_VISION_RANGE)
            : await walkToPoint(step.x, step.y);

        clearInterval(_midWalkTimer);
        if (_aborted || !isRunning()) return;

        if (_heroMidWalkFound) {
            const found = _heroMidWalkFound;
            _heroMidWalkFound = null;
            if (found.selected) await onHeroFound(heroData, found.npc, liveConfig);
            else await onOpportunisticHeroFound(heroData, found.heroData, found.npc, liveConfig);
            return;
        }

        if (!reached) {
            if (isRespStep) {
                const p = getHeroPos();
                const d = p ? manhattanDistance(p.x, p.y, step.x, step.y) : '?';
                log(`⚠️ Nie udało się wejść w zasięg respu [${step.x},${step.y}] (dystans ${d}, wymagane ≤${HERO_RESP_VISION_RANGE}) – retry...`, '#e67e22');
            } else {
                log(`⚠️ Nie udało się dojść do punktu skanu [${step.x},${step.y}] – retry...`, '#e67e22');
            }
            await delay(500); return;
        }

        await delay(randomFastDelay());
        const pointDetection = findAnyHeroNpcOnMap(heroData);
        if (pointDetection) {
            if (pointDetection.selected) await onHeroFound(heroData, pointDetection.npc, liveConfig);
            else await onOpportunisticHeroFound(heroData, pointDetection.heroData, pointDetection.npc, liveConfig);
            return;
        }

        const completedIndex = _routeIndex;
        _routeIndex++;
        saveState();

        const nextStep = route[_routeIndex];
        if (nextStep) {
            log(`➡️ Krok zaliczony: ${completedIndex + 1} → następny ${_routeIndex + 1}/${route.length}, mapa ${nextStep.mapId} [${nextStep.x},${nextStep.y}]`, '#3498db');
        } else {
            log(`➡️ Ostatni krok trasy zaliczony`, '#3498db');
        }
    }

    function detectHero(config) {
        const heroData = getSelectedHeroData(config);
        if (!heroData) return null;
        return findHeroNpcOnMap(heroData);
    }

    function abortScan() {
        _aborted         = true;
        _routeIndex      = -1;
        _routeStartIndex = -1;
        _routeDone       = false;
        clearState();
        log('🛑 Skan przerwany.', '#e74c3c');
    }

    window._uiCacheData.hero = {
        handleHeroHunting,
        detectHero,
        abortScan,
        getHeroPatrolRoute,
        findAnyHeroNpcOnMap,
        chooseNearestHeroEntryIndex
    };

})();
// --- END OF FILE autohero.js ---

