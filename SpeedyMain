        getNativeE2TimerByName,
        scheduleOfflineWait: _scheduleOfflineWait,
        logoutToMainForScheduler: _logoutToMainForScheduler,
        schedulerState: () => { const s = _schedulerStore(); return s ? s.read() : null; },
