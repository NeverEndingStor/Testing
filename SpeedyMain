    async function handleStworzycielNpcDialog(walkSmoothly, findPathBFS, delay) {
        if (!Engine || !Engine.npcs || !Engine.hero || !Engine.map) return false;

        const STWORZYCIEL_NPC_IDS = new Set([
            323810, 323811, 323812, 323813, 323814, 323815, 323816, 323817,
            323818, 323819, 323820, 323821, 323822, 323823, 323824, 323825,
            323892
        ]);

        const npcs = typeof Engine.npcs.check === 'function' ? Engine.npcs.check() : (Engine.npcs.d || {});
        let nearest = null;
        let nearestDist = Infinity;

        for (let k in npcs) {
            let npc = npcs[k].d || npcs[k];
            if (!npc) continue;
            if (!STWORZYCIEL_NPC_IDS.has(parseInt(npc.id))) continue;
            let dist = Math.abs(Engine.hero.d.x - npc.x) + Math.abs(Engine.hero.d.y - npc.y);
            if (dist < nearestDist) { nearestDist = dist; nearest = npc; }
        }

        if (!nearest) {
            if (window._uiCacheData.gui) window._uiCacheData.gui.updateStatus("Stworzyciel – brak NPC bramkarza!", "#e74c3c");
            return false;
        }

        if (nearestDist > 1) {
            if (window._uiCacheData.gui) window._uiCacheData.gui.updateStatus("Stworzyciel – podchodzę do NPC bramkarza...", "#9b59b6");

            let standSpot = null;
            for (const d of [{x:0,y:-1},{x:0,y:1},{x:-1,y:0},{x:1,y:0}]) {
                try {
                    if (!Engine.map.col.check(nearest.x + d.x, nearest.y + d.y)) {
                        standSpot = { x: nearest.x + d.x, y: nearest.y + d.y };
                        break;
                    }
                } catch(e) {}
            }
            if (!standSpot) standSpot = { x: nearest.x, y: nearest.y };

            const path = findPathBFS(Engine.hero.d.x, Engine.hero.d.y, standSpot.x, standSpot.y, 400);
            if (path && path.length > 0) {
                await walkSmoothly(path);
                await delay(400);
            }
        }

        if (window._uiCacheData.gui) window._uiCacheData.gui.updateStatus("Stworzyciel – otwieram dialog...", "#9b59b6");
        window._g('talk&id=' + (nearest.id || nearest.tpl));
        await delay(600);

        let steps = 0;
        while (steps < 6) {
            await delay(500);
            let answers = document.querySelectorAll('.dialogue-window-answer');
            if (answers.length === 0) break;
            answers[0].click();
            steps++;
            await delay(300);
        }

        try { Engine.dialog && Engine.dialog.close && Engine.dialog.close(); } catch(e) {}
        await delay(600);
        return true;
    }

