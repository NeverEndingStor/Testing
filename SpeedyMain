    async function handleTrupiaPassageNpc() {
        if(window._uiCacheData.gui) window._uiCacheData.gui.updateStatus(`Przełęcz: Odblokuję przejście...`, "#9b59b6");
        const result = await talkToNpcFirstOption(
            TRUPIA_PASSAGE_NPC_ID,
            `Przełęcz: Otwieram przejście (NPC ${TRUPIA_PASSAGE_NPC_ID})...`
        );
        return result;
    }

    async function walkToNpcWithPassageFallback(monkNpc) {
        const exp = window._uiCacheData.exp;
        if (!exp) return false;

        let standSpot = null;
        for (const d of [{x:0,y:-1},{x:0,y:1},{x:-1,y:0},{x:1,y:0}]) {
            try {
                if (!Engine.map.col.check(monkNpc.x + d.x, monkNpc.y + d.y)) {
                    standSpot = { x: monkNpc.x + d.x, y: monkNpc.y + d.y };
                    break;
                }
            } catch(e) {}
        }
        if (!standSpot) standSpot = { x: monkNpc.x, y: monkNpc.y };

        let path = exp.findPathBFS(Engine.hero.d.x, Engine.hero.d.y, standSpot.x, standSpot.y, 300);

        if (!path || path.length === 0) {
            if(window._uiCacheData.gui) window._uiCacheData.gui.updateStatus(`Przełęcz: Brak ścieżki – odblokuję przejście...`, "#e67e22");
            const opened = await handleTrupiaPassageNpc();

            let config = window._uiCacheData.gui ? window._uiCacheData.gui.getSettings() : {isRunning: true};
            if (!config.isRunning || (exp && exp.isCaptchaActive())) return false; // Nie nakładaj kary za przerwanie

            if (!opened) return false;

            path = exp.findPathBFS(Engine.hero.d.x, Engine.hero.d.y, standSpot.x, standSpot.y, 300);
        }

        if (path && path.length > 0) {
            await exp.walkSmoothly(path);
            await delay(300);
        }

        return true;
    }

    async function processAstralTeleport(finalTargetMapId, config, setMapCooldown) {
        if (!window._uiCacheData.exp || !Engine || !Engine.map) return false;
        if (Engine.battle && Engine.battle.getShow()) return false;

        let currentMapId = parseInt(Engine.map.d.id);
        finalTargetMapId = parseInt(finalTargetMapId);

        // Obsługa wysp
        if (window._uiCacheData.islands) {
            const isl = window._uiCacheData.islands;

            if (currentMapId === isl.FLYING_DUTCHMAN_MAP_ID) {
                const escaped = await isl.handleFlyingDutchman(setMapCooldown);
                return escaped ? { action: "HANDLED" } : false;
            }

            const entranceId = isl.getEntranceForMap(finalTargetMapId);
            if (entranceId && isl.getEntranceForMap(currentMapId) === entranceId) {
                return false;
            }

            if (entranceId && currentMapId === isl.GATEWAY_MAP_ID) {
                const result = await isl.processIslandTeleport(finalTargetMapId, config, setMapCooldown);
                return result ? { action: "HANDLED" } : false;
            }
        }

        if (currentRoute) {
            const arrivedAtDest = currentMapId === parseInt(currentRoute.destMapId);
            const targetChanged = parseInt(currentRoute.finalTargetMapId) !== finalTargetMapId;

            if (targetChanged || arrivedAtDest) {
                currentRoute = null;
            }
        }

        if (!currentRoute) {
            if (Date.now() < monkPenaltyUntil) return false;

            let directDist = getMapDistance(currentMapId, finalTargetMapId);
            if (directDist > 2) {
                let bestRoute = null;
                let bestSavings = 0;

                for (let startKey in CITIES) {
                    let startMapId = CITIES[startKey].mapId;
                    let distToMonk = getMapDistance(currentMapId, startMapId);

                    if (distToMonk >= directDist - 2) continue;

                    for (let destKey in CITIES) {
                        if (startKey === destKey) continue;

                        let localCanUseStart = config[`tpFrom${startKey}`];
                        let localCanUseDest = config[`tpTo${destKey}`];

                        if (startKey === 'Tuzmer' && destKey !== 'Trupia') {
                            if (config['tpFromTuzmer'] && localCanUseDest) {
                                let distFromDest = getMapDistance(CITIES[destKey].mapId, finalTargetMapId);
                                let totalDistTwoStepOut = distToMonk + distFromDest;
                                let savingsTwoStepOut = directDist - totalDistTwoStepOut;

                                if (savingsTwoStepOut > 2 && savingsTwoStepOut > bestSavings) {
                                    bestSavings = savingsTwoStepOut;
                                    bestRoute = {
                                        startCity: 'Tuzmer',
                                        startMapId: startMapId,
                                        destCity: 'Trupia',
                                        destCityName: CITIES['Trupia'].name,
                                        destMapId: CITIES['Trupia'].mapId,
                                        finalTargetMapId: finalTargetMapId
                                    };
                                }
                            }
                            continue;
                        }

                        if (destKey === 'Tuzmer' && startKey !== 'Trupia') {
                            continue;
                        }

                        if (startKey === 'Trupia' && destKey === 'Tuzmer' && config['tpToTuzmer']) {
                            localCanUseStart = true;
                            localCanUseDest = true;
                        }
                        if (startKey === 'Tuzmer' && destKey === 'Trupia' && config['tpFromTuzmer']) {
                            localCanUseStart = true;
                            localCanUseDest = true;
                        }

                        if (!localCanUseStart || !localCanUseDest) continue;

                        let destMapId = CITIES[destKey].mapId;
                        let distFromMonk = getMapDistance(destMapId, finalTargetMapId);
                        let totalDistDirect = distToMonk + distFromMonk;
                        let savingsDirect = directDist - totalDistDirect;

                        let requiredSavings = 2;
                        if ((startKey === 'Trupia' && destKey === 'Tuzmer') || (startKey === 'Tuzmer' && destKey === 'Trupia')) {
                            requiredSavings = 0;
                        }

                        if (savingsDirect > requiredSavings && savingsDirect > bestSavings) {
                            bestSavings = savingsDirect;
                            bestRoute = {
                                startCity: startKey,
                                startMapId: startMapId,
                                destCity: destKey,
                                destCityName: CITIES[destKey].name,
                                destMapId: destMapId,
                                finalTargetMapId: finalTargetMapId
                            };
                        }

                        if (destKey === 'Trupia' && config['tpToTuzmer'] && localCanUseStart) {
                            let distFromTuzmer = getMapDistance(CITIES['Tuzmer'].mapId, finalTargetMapId);
                            let totalDistTwoStep = distToMonk + distFromTuzmer;
                            let savingsTwoStep = directDist - totalDistTwoStep;

                            if (savingsTwoStep > 2 && savingsTwoStep > bestSavings) {
                                bestSavings = savingsTwoStep;
                                bestRoute = {
                                    startCity: startKey,
                                    startMapId: startMapId,
                                    destCity: 'Trupia',
                                    destCityName: CITIES['Trupia'].name,
                                    destMapId: CITIES['Trupia'].mapId,
                                    finalTargetMapId: finalTargetMapId
                                };
                            }
                        }
                    }
                }

                if (bestRoute) {
                    currentRoute = bestRoute;
                    if(window._uiCacheData.gui) window._uiCacheData.gui.updateStatus(`Optymalizacja trasy... (TP)`, "#9b59b6");
                }
            }
        }

        const TRUPIA_BLOCKED_COORDS = [
            {x:0,y:81},{x:1,y:82},{x:1,y:81},{x:2,y:81},
            {x:2,y:80},{x:3,y:80},{x:4,y:80},{x:5,y:81},
            {x:4,y:81},{x:3,y:81}
        ];
        const heroX = Engine.hero.d.x;
        const heroY = Engine.hero.d.y;
        const isOnBlockedSpot = TRUPIA_BLOCKED_COORDS.some(c => c.x === heroX && c.y === heroY);

        if (currentMapId === TRUPIA_MAP_ID && isOnBlockedSpot) {
            let wantToTeleportFromTrupia = (currentRoute && parseInt(currentRoute.startMapId) === TRUPIA_MAP_ID);
            let targetIsTrupia = finalTargetMapId === TRUPIA_MAP_ID;

            if (!wantToTeleportFromTrupia && !targetIsTrupia) {
                if (!trupiaGatewayOpened) {
                    await handleTrupiaGateway();

                    if (!config.isRunning || (window._uiCacheData.exp && window._uiCacheData.exp.isCaptchaActive())) {
                        return false;
                    }

                    trupiaGatewayOpened = true;
                }
                return { action: "HANDLED" };
            }
        }

        if (currentMapId !== TRUPIA_MAP_ID) {
            trupiaGatewayOpened = false;
        }

        if (!currentRoute) return false;

        if (currentMapId !== parseInt(currentRoute.startMapId)) {
            return { action: "WALK_TO", targetMapId: currentRoute.startMapId };
        }

        let monkNpc = null;
        const expectedNpcId = CITIES[currentRoute.startCity].npcId;
        const npcs = Engine.npcs.check ? Engine.npcs.check() : Engine.npcs.d;

        for (let k in npcs) {
            let n = npcs[k].d || npcs[k];
            if (parseInt(n.id) === expectedNpcId || parseInt(n.tpl) === expectedNpcId) {
                monkNpc = n;
                break;
            }
        }

        if (!monkNpc) {
            for (let k in npcs) {
                let n = npcs[k].d || npcs[k];
                if (n.nick && n.nick.toLowerCase().includes("zakonnik")) {
                    monkNpc = n; break;
                }
            }
        }

        if (!monkNpc) {
            monkPenaltyUntil = Date.now() + 60 * 1000;
            currentRoute = null;
            return false;
        }

        // ZABEZPIECZENIE: Sprawdź czy bot nie został zatrzymany w locie
        if (!config.isRunning || (window._uiCacheData.exp && window._uiCacheData.exp.isCaptchaActive())) {
            return false;
        }

        if (currentMapId === TRUPIA_MAP_ID) {
            const reached = await walkToNpcWithPassageFallback(monkNpc);

            // Jeśli bot został wyłączony lub dostał captchę w trakcie podchodzenia, wychodzimy bez kary
            if (!config.isRunning || (window._uiCacheData.exp && window._uiCacheData.exp.isCaptchaActive())) {
                return false;
            }

            if (!reached) {
                monkPenaltyUntil = Date.now() + 60 * 1000;
                currentRoute = null;
                return false;
            }
        } else {
            let standSpot = null;
            for (const d of [{x:0,y:-1},{x:0,y:1},{x:-1,y:0},{x:1,y:0}]) {
                try {
                    if (!Engine.map.col.check(monkNpc.x + d.x, monkNpc.y + d.y)) {
                        standSpot = { x: monkNpc.x + d.x, y: monkNpc.y + d.y };
                        break;
                    }
                } catch(e) {}
            }
            if (!standSpot) standSpot = { x: monkNpc.x, y: monkNpc.y };

            let path = window._uiCacheData.exp
                ? window._uiCacheData.exp.findPathBFS(Engine.hero.d.x, Engine.hero.d.y, standSpot.x, standSpot.y, 300)
                : null;

            if (path && path.length > 0) {
                if(window._uiCacheData.exp) await window._uiCacheData.exp.walkSmoothly(path);
                await delay(300);
            }

            // Weryfikacja po spacerze - czy bot jest w ogóle blisko NPC,
            // czy spacer przerwała captcha/stop?
            if (!config.isRunning || (window._uiCacheData.exp && window._uiCacheData.exp.isCaptchaActive())) {
                return false;
            }

            let distToNpc = Math.max(Math.abs(Engine.hero.d.x - monkNpc.x), Math.abs(Engine.hero.d.y - monkNpc.y));
            if (distToNpc > 2) {
                return false; // Interrupted during walk
            }
        }

        window._g('talk&id=' + (monkNpc.id || monkNpc.tpl));
        await delay(600);

        let oldMap = Engine.map.d.id;
        let dialogSteps = 0;
        let interrupted = false;

        while (dialogSteps < 6) {
            if (Engine.map.d.id !== oldMap) break;

            if (!config.isRunning || (window._uiCacheData.exp && window._uiCacheData.exp.isCaptchaActive())) {
                interrupted = true;
                break;
            }

            await delay(500);
            let answers = document.querySelectorAll('.dialogue-window-answer');
            if (answers.length === 0) break;

            let clicked = false;

            if (!clicked) {
                let initOpt = Array.from(answers).find(a => a.innerText.toLowerCase().includes("przenieść") || a.innerText.toLowerCase().includes("teleport"));
                if (initOpt) { initOpt.click(); clicked = true; }
            }

            if (!clicked) {
                let destNameLower = currentRoute.destCityName.toLowerCase();
                let destOpt = Array.from(answers).find(a => a.innerText.toLowerCase().includes(destNameLower));
                if (!destOpt && currentRoute.destCity === 'Rozstaje') {
                    destOpt = Array.from(answers).find(a => a.innerText.toLowerCase().includes("rozstaje"));
                }
                if (destOpt) { destOpt.click(); clicked = true; }
            }

            if (!clicked) {
                let confOpt = Array.from(answers).find(a =>
                    a.innerText.toLowerCase().includes("zapłacę") ||
                    a.innerText.toLowerCase().includes("tak") ||
                    a.innerText.toLowerCase().includes("zgadzam")
                );
                if (confOpt) { confOpt.click(); clicked = true; }
            }

            if (!clicked) {
                let any = Array.from(answers).find(a =>
                    !a.innerText.toLowerCase().includes("żegnaj") &&
                    !a.innerText.toLowerCase().includes("do widzenia")
                );
                if (any) { any.click(); clicked = true; }
            }

            dialogSteps++;
        }

        if (interrupted) {
            try { Engine.dialog.close(); } catch(e){}
            return false; // Yield back, no penalty!
        }

        if (typeof setMapCooldown === 'function') setMapCooldown(true);
        let timeout = 0;

        while (Engine.map.d.id === oldMap && timeout < 40) {
            if (!config.isRunning || (window._uiCacheData.exp && window._uiCacheData.exp.isCaptchaActive())) {
                interrupted = true;
                break;
            }
            await delay(100);
            timeout++;
            if (document.querySelector('.mAlert')) {
                let btn = document.querySelector('.mAlert .button, .mAlert .alert-accept-hotkey');
                if (btn) btn.click();
                break; // Alert z błędem, np brak złota - dajemy karę
            }
        }

        if (Engine.map.d.id === oldMap) {
            if (interrupted) {
                if (typeof setMapCooldown === 'function') setMapCooldown(false);
                try { Engine.dialog.close(); } catch(e){}
                return false; // Yield back, no penalty!
            } else {
                monkPenaltyUntil = Date.now() + 5 * 60 * 1000;
                currentRoute = null;
                try { Engine.dialog.close(); } catch(e){}
            }
        }

        await delay(1500);
        if (typeof setMapCooldown === 'function') setMapCooldown(false);

        return { action: "HANDLED" };
    }

    window._uiCacheData.tp = {
        processAstralTeleport
    };
})();
