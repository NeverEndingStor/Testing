        if (_processedDeaths.has(cached.id)) return;
        _processedDeaths.add(cached.id);
        setTimeout(() => _processedDeaths.delete(cached.id), 5000);

        const allE2 = window._uiCacheData.e2 || [];
        const nickLower = cached.nick.toLowerCase();

        let finalRespBaseOverride = respBaseSeconds;
        let respSource = '';

        if (finalRespBaseOverride) {
            respSource = 'sieć';
        } else if (cached.tpl && _npcTplCache[cached.tpl]) {
            finalRespBaseOverride = _npcTplCache[cached.tpl].respBaseSeconds;
            respSource = finalRespBaseOverride ? 'tpl-cache' : '';
        }

        for (const e2 of allE2) {
            if (nickLower.includes(cleanName(e2.name)) || cleanName(e2.name).includes(nickLower) || e2.key === nickLower) {
                const finalRespBase = finalRespBaseOverride || e2.resp || null;
                if (!respSource) respSource = finalRespBaseOverride ? '?' : (e2.resp ? 'e2-config' : 'fallback-3600');
                const respRand = getRespRand(cached.wt, cached.resp_rand);
                _onE2Died(e2.key, finalRespBase, respRand, cached.id, reason, respSource);
                break;
            }
        }
    }

    function checkAndProcessDeletion(id, respBaseOverride) {
        let cached = _npcCache[id];
        if (!cached) return;
        if (Date.now() - _mapChangeTime < 1500) { delete _npcCache[id]; return; }
        const hP = heroPos();
        const dist = chebyshev(hP.x, hP.y, cached.x, cached.y);
        let isRealDeath = false;
        let deathReason = '';
        if (cached.dead) { isRealDeath = true; deathReason = 'flaga dead'; }
        else if (cached.hp === 0) { isRealDeath = true; deathReason = 'hp=0'; }
        else if (dist < 14) { isRealDeath = true; deathReason = `w zasięgu (dist=${dist})`; }

        if (isRealDeath) {
            const tplResp = cached.tpl && _npcTplCache[cached.tpl] ? _npcTplCache[cached.tpl].respBaseSeconds : null;
            const finalRespBase = respBaseOverride || cached.respBaseSeconds || tplResp || null;
            try {
                if (window._uiCacheData.exp && typeof window._uiCacheData.exp.observeNpcDeletion === 'function') {
                    window._uiCacheData.exp.observeNpcDeletion(cached, finalRespBase, `del-pakiet (${deathReason})`);
                }
            } catch (_) {}
            processDeath(cached, finalRespBase, `del-pakiet (${deathReason})`);
        }
        delete _npcCache[id];
    }

    function hookNetworkForDeaths() {
        function handleData(data) {
            if (!data) return;
            if (data.town && data.town.file) { _mapChangeTime = Date.now(); for (const k in _npcCache) delete _npcCache[k]; }
            if (data.npc_tpls) for (let tpl of data.npc_tpls) _npcTplCache[tpl.id] = tpl;

            // ── Wykrycie śmierci bohatera z pakietu sieciowego ─────────────────
            // Serwer wysyła hero.dead=1 lub hero.respawnTime gdy gracz ginie.
            // Dzięki temu mamy dokładny czas respawnu zamiast zgadywać.
            if (data.hero) {
                const h = data.hero;
                const isDead = h.dead === 1 || h.dead === true || h.st === 'dead';
                if (isDead) {
                    const nick = myNick();
                    const world = getWorldName();
                    if (nick && !getHeroDeadState(nick, world)) {
                        // Pobierz czas respawnu z pakietu
                        const respSecs = h.respawnTime || h.resp || h.respBaseSeconds || h.dead_timer || 120;
                        markHeroDead(nick, world, parseInt(respSecs));
                    }
                }
            }
            if (data.npcs) {
                for (let npc of data.npcs) {
                    let tpl = _npcTplCache[npc.tpl] || {};
                    _npcCache[npc.id] = { id: npc.id, tpl: npc.tpl, nick: npc.nick || tpl.nick || tpl.name || '', wt: npc.wt !== undefined ? npc.wt : (tpl.warrior_type || tpl.wt || 0), x: npc.x, y: npc.y, hp: npc.hp, dead: npc.dead || false, resp_rand: npc.resp_rand !== undefined ? npc.resp_rand : tpl.resp_rand, respBaseSeconds: npc.respBaseSeconds !== undefined ? npc.respBaseSeconds : tpl.respBaseSeconds };
                }
            }
            if (data.npc) {
                for (let id in data.npc) {
                    let npc = data.npc[id];
                    if (npc.del) continue;
                    if (!_npcCache[id]) _npcCache[id] = { id: id };
                    let cached = _npcCache[id];
                    const tpl = (npc.tpl && _npcTplCache[npc.tpl]) ? _npcTplCache[npc.tpl]
                              : (cached.tpl && _npcTplCache[cached.tpl]) ? _npcTplCache[cached.tpl]
                              : {};
                    if (npc.tpl !== undefined) cached.tpl = npc.tpl;
                    if (npc.nick) cached.nick = npc.nick;
                    else if (!cached.nick && (tpl.nick || tpl.name)) cached.nick = tpl.nick || tpl.name;
                    if (npc.wt !== undefined) cached.wt = npc.wt;
                    else if (cached.wt === undefined && (tpl.warrior_type || tpl.wt)) cached.wt = tpl.warrior_type || tpl.wt || 0;
                    if (npc.x !== undefined) cached.x = npc.x;
                    if (npc.y !== undefined) cached.y = npc.y;
                    if (npc.hp !== undefined) cached.hp = npc.hp;
                    if (npc.dead !== undefined) cached.dead = npc.dead;
                    if (npc.resp_rand !== undefined) cached.resp_rand = npc.resp_rand;
                    else if (cached.resp_rand === undefined && tpl.resp_rand !== undefined) cached.resp_rand = tpl.resp_rand;
                    if (npc.respBaseSeconds !== undefined) cached.respBaseSeconds = npc.respBaseSeconds;
                    else if (cached.respBaseSeconds === undefined && tpl.respBaseSeconds !== undefined) cached.respBaseSeconds = tpl.respBaseSeconds;
                }
            }
            if (data.npcs_del) for (let del of data.npcs_del) checkAndProcessDeletion(del.id, del.respBaseSeconds);
            if (data.npc) for (let id in data.npc) if (data.npc[id].del) checkAndProcessDeletion(id, data.npc[id].respBaseSeconds);
        }

        let hooked = false;
        if (typeof Engine !== 'undefined' && Engine.communication) {
            const orig = Engine.communication.parseJSON;
            Engine.communication.parseJSON = function(d) { try { handleData(d); } catch(e) {} return orig.apply(this, arguments); };
            hooked = true;
        }
        if (typeof window.parseInput === 'function') {
            const origParseInput = window.parseInput;
            window.parseInput = function(d) { try { handleData(d); } catch(e) {} return origParseInput.apply(this, arguments); };
            hooked = true;
        }
        if (!hooked) setTimeout(hookNetworkForDeaths, 500);
    }

    function _onE2Died(e2Key, respBase, respRand, npcId, reason, respSource) {
        saveRespawnTimer(e2Key, respBase, respRand, respSource || reason);
        let wasMyKill = false;

        // Zmiana na własną, lokalną zmienną _lastAttackedE2Target
        if (_lastAttackedE2Target) {
            const lat = _lastAttackedE2Target;
            const idStr = String(npcId);
            const matchDirect = String(lat.id) == idStr;
            const matchE2     = lat.e2Id && String(lat.e2Id) == idStr;
            const matchGroup  = Array.isArray(lat.groupIds) && lat.groupIds.indexOf(idStr) !== -1;

            if (matchDirect || matchE2 || matchGroup) {
                wasMyKill = true;
                _lastAttackedE2Target = null;
            }
        }

        if (wasMyKill) {
            _pushFeed(`⚔️ Ubito: ${e2Key} (${reason})`, '#2ecc71');
            if (window._uiCacheData.party && window._uiCacheData.party.notifyE2Killed) window._uiCacheData.party.notifyE2Killed();
        } else {
            _pushFeed(`💀 ${e2Key} zbita przez innego (${reason})`, '#888');
        }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // GŁÓWNA LOGIKA CHODZENIA
    // ─────────────────────────────────────────────────────────────────────────

    async function handleE2Logic(config, setMapCooldown) {
        if (!config.isRunning) return 'idle';

        // v28: jeśli użytkownik ręcznie przełączył się na postać, której jeszcze nie
        // dodał do kolejki, Speedy NIE przeloguje go z niej i niczego nie zacznie.
        const managedEntry = findMyRosterEntry();
        if (!managedEntry || !Array.isArray(managedEntry.e2Keys) || managedEntry.e2Keys.length === 0) {
            if (window._uiCacheData.gui) window._uiCacheData.gui.updateStatus('E2 – ta postać nie jest w kolejce', '#888');
            return 'idle';
        }

        // ── WYKRYCIE ŚMIERCI BOHATERA ─────────────────────────────────────────
        // v27: Engine.dead jest źródłem prawdy. Nie zgadujemy czasu respawnu i nie
        // uciekamy na inną postać. Po odrodzeniu od razu wracamy do logiki E2.
        if (Engine && Engine.dead) {
            if (!_heroDeathRelogPending) {
                _heroDeathRelogPending = true;
                _pushFeed(`💀 ${myNick()} nieprzytomny – czekam na odrodzenie`, '#e74c3c');
            }
            if (window._uiCacheData.gui) window._uiCacheData.gui.updateStatus(`💀 E2 – czekam na odrodzenie...`, '#e74c3c');
            await delay(750);
            return 'dead';
        } else if (_heroDeathRelogPending) {
            _heroDeathRelogPending = false;
            _pushFeed(`✅ ${myNick()} odrodzony – natychmiast wracam do E2`, '#2ecc71');
            if (window._uiCacheData.gui) window._uiCacheData.gui.updateStatus(`✅ Odrodzony – wracam do E2`, '#2ecc71');
            await delay(750);
        }

        _consumeWakeStateIfNeeded();
        syncNativeE2Timers();

        // v27: stan śmierci obsługujemy wyłącznie natywnym Engine.dead na aktywnej postaci.

        if (!Engine || !Engine.hero || Engine.dead) return 'idle';

        if (_pendingRelog) {
            _pendingRelog = false;
            if (isAutoLoginEnabled(config)) {
                await _relogWithDelay(config);
                return 'relogging';
            }
        }

        if (Engine.battle && Engine.battle.getShow()) {
            _handleBattle();
            return 'idle';
        }

        // Walka się skończyła – weryfikujemy samodzielnie _lastAttackedE2Target
        if (_lastAttackedE2Target && (!Engine.battle || !Engine.battle.getShow())) {
            const tData = _lastAttackedE2Target;
            if (tData.e2Key) {
                const e2Cfg = (window._uiCacheData.e2 || []).find(e => e.key === tData.e2Key);
                const mapIdMatch = e2Cfg && currentMapId() === parseInt(e2Cfg.map_id);
                const liveOnMap = e2Cfg && findLiveE2OnMap(e2Cfg);

                if (mapIdMatch && !liveOnMap) {
                    const checkId = tData.e2Id || tData.id;
                    const npcCached = _npcCache[checkId];
                    const netRespBase = npcCached && npcCached.respBaseSeconds ? npcCached.respBaseSeconds : null;
                    const finalBase = netRespBase || tData.respBase;
                    const respRand = npcCached ? getRespRand(npcCached.wt, npcCached.resp_rand) : 0.10;
                    const src = netRespBase ? 'po-walce+sieć' : 'po-walce+mapa';

                    // Zapisujemy tylko jeśli jakimś cudem event z pakietu tego nie wyłapał
                    if (!getTimer(tData.e2Key)) {
                        saveRespawnTimer(tData.e2Key, finalBase, respRand, src);
                        _pushFeed(`⚔️ Ubito (skaner mapy): ${tData.e2Key}`, '#2ecc71');
                        if (window._uiCacheData.party && window._uiCacheData.party.notifyE2Killed) window._uiCacheData.party.notifyE2Killed();
                    }
                }
            }
            // Zawsze usuwamy po weryfikacji post-battle
            _lastAttackedE2Target = null;
        }

        syncNativeE2Timers();

        if (window._uiCacheData.exp && typeof window._uiCacheData.exp.isCaptchaActive === 'function' && window._uiCacheData.exp.isCaptchaActive()) return 'idle';

        const exp = window._uiCacheData.exp;
        if (!exp) return 'idle';

        if (_needsTownVisit(config)) {
            const lbl = _bagFull() && _hasJunkToSell(config) ? 'Plecak pełny – idę sprzedać' : 'Brak potek – idę kupić';
            if (window._uiCacheData.gui) window._uiCacheData.gui.updateStatus(`E2 pauza: ${lbl}`, '#e67e22');
            return 'idle';
        }

        const bestPick = pickBestE2Target(config);

        if (!bestPick || !bestPick.target) {
            const roster = loadRoster();
            const hasOtherChars = roster.length >= 2;

            if (hasOtherChars && isAutoLoginEnabled(config)) {
                if (window._uiCacheData.gui) window._uiCacheData.gui.updateStatus(`E2 – Moje zrobione, loguje na następną...`, '#9b59b6');
                _pushFeed(`✅ Wszystkie moje E2 done – reloguję`, '#2ecc71');
                await _relogWithDelay(config);
                return 'relogging';
            }

            if (window._uiCacheData.gui) window._uiCacheData.gui.updateStatus('E2 – Brak celów', '#888');
            await delay(2000);
            return 'idle';
        }

        const target = bestPick.target;

        if (bestPick.type === 'waiting') {
            const roster = loadRoster();
            const hasOtherChars = roster.length >= 2;

            if (hasOtherChars && isAutoLoginEnabled(config)) {
                const nextEntry = pickNextRosterChar(config);
                if (nextEntry) {
                    const hasReady = nextEntry.e2Keys && nextEntry.e2Keys.some(k => !isIgnored(k) && !isDefinitelyNotRespawned(k));

                    let nextShortestTimer = Infinity;
                    if (nextEntry.e2Keys) {
                        for (const k of nextEntry.e2Keys) {
                            if (!isIgnored(k)) {
                                const t = secondsToMinResp(k);
                                if (t < nextShortestTimer) nextShortestTimer = t;
                            }
                        }
                    }

                    const myShortestTimer = secondsToMinResp(bestPick.target.key);

                    if (hasReady || nextShortestTimer < myShortestTimer) {
                        if (!_isOnMyE2Map(config)) {
                            if (window._uiCacheData.gui) window._uiCacheData.gui.updateStatus(`E2 – Wracam na spawn przed relogiem...`, '#3498db');
                        } else {
                            if (window._uiCacheData.gui) window._uiCacheData.gui.updateStatus(`E2 – Zmiana na postać z krótszym czasem...`, '#9b59b6');
                            await _relogWithDelay(config);
                            return 'relogging';
                        }
                    }
                }
            }
        }

        // Jeśli wszystkie sensowne cele są jeszcze przed minResp i nie opłaca się
        // przełączać na inną postać, wyjdź na stronę główną i wróć 30 s przed minResp.
        if (bestPick.type === 'waiting' && isAutoLoginEnabled(config)) {
            const slept = await _scheduleOfflineWait(target);
            if (slept) return 'offline';
        }

        const mapId = currentMapId();

        if (mapId === parseInt(target.map_id)) {
            return await _handleSameMap(config, target, exp, setMapCooldown);
        }

        if (window._uiCacheData.gui) {
            if (bestPick.type === 'waiting') {
                window._uiCacheData.gui.updateStatus(`E2 – Biegnę pod ${target.name} (${_fmtTime(secondsToMinResp(target.key))})`, '#e67e22');
            } else {
                window._uiCacheData.gui.updateStatus(`E2 – Biegnę na mapę: ${target.map_name}`, '#9b59b6');
            }
        }

        if (typeof exp.handleMapTransition === 'function') {
            await exp.handleMapTransition(config, setMapCooldown, parseInt(target.map_id));
            return 'walking';
        } else {
            const nextHop = exp.getNextHopMap(mapId, parseInt(target.map_id));
            if (!nextHop) { await delay(2000); return 'idle'; }
        }

        return 'walking';
    }

    async function _handleSameMap(config, target, exp, setMapCooldown) {
        const mapId = currentMapId();
        const allE2 = window._uiCacheData.e2 || [];
        const myE2Keys = getMyE2Keys(config);

        let mapTargets = [];
        for (const key of myE2Keys) {
            if (isIgnored(key)) continue;
            const e2Obj = allE2.find(e => e.key === key);
            if (e2Obj && parseInt(e2Obj.map_id) === mapId) {
                mapTargets.push(e2Obj);
            }
        }

        let liveTargets = [];
        for (const e2 of mapTargets) {
            const live = findLiveE2OnMap(e2);
            if (live) liveTargets.push({ live, e2 });
        }

        liveTargets.sort((a, b) => (getTimer(a.e2.key) ? 1 : 0) - (getTimer(b.e2.key) ? 1 : 0));

        if (liveTargets.length > 0) {
            const { live: anyLiveE2, e2: activeTargetData } = liveTargets[0];
            if (isOtherPlayerNearSpawn(anyLiveE2.x, anyLiveE2.y)) {
                ignoreE2(activeTargetData.key, 'obcy gracz kampi przy E2');
                if (window._uiCacheData.gui) window._uiCacheData.gui.updateStatus(`E2 – Ktoś obcy stoi na E2. Ignoruje 30 min.`, '#e67e22');
                await delay(1000);
                return 'waiting';
            }
            // Losowe opóźnienie 300-500ms przed atakiem – symuluje ludzką reakcję
            const humanDelay = 300 + Math.floor(Math.random() * 201);
            await delay(humanDelay);
            return await _approachAndAttack(anyLiveE2, activeTargetData, exp);
        }

        const allMapTargetsHaveTimers = mapTargets.every(e2 => isDefinitelyNotRespawned(e2.key));

        if (allMapTargetsHaveTimers) {
            const graph = window._uiCacheData.graph || {};
            let hasOtherImmediateTarget = false;
            for (const key of myE2Keys) {
                if (isIgnored(key)) continue;
                const e2Obj = allE2.find(e => e.key === key);
                if (!e2Obj || parseInt(e2Obj.map_id) === mapId) continue;
                if (!isDefinitelyNotRespawned(key)) { hasOtherImmediateTarget = true; break; }
            }
            if (hasOtherImmediateTarget) {
                if (window._uiCacheData.gui) window._uiCacheData.gui.updateStatus(`E2 – Wszystkie zbite na tej mapie, szukam następnej...`, '#3498db');
                await delay(300);
                return 'idle';
            }
        }

        if (secondsToMaxResp(target.key) === 0 && isDefinitelyNotRespawned(target.key)) {
            clearTimer(target.key);
        }

        const waitTarget = mapTargets.length > 0
            ? mapTargets.reduce((a, b) => secondsToMinResp(a.key) <= secondsToMinResp(b.key) ? a : b)
            : target;

        return await _waitAtSpawn(waitTarget, exp);
    }

    async function _approachAndAttack(liveE2, target, exp) {
        const pick = pickClosestGroupMember(liveE2);
        const attackNpc = pick.attackTarget;

        const pos  = heroPos();
        const dist = chebyshev(pos.x, pos.y, attackNpc.x, attackNpc.y);

        const isE2Target = (attackNpc.id === liveE2.id);
        const statusLabel = isE2Target
            ? `E2 - Atak: ${liveE2.nick || target.name}!`
            : `E2 - Atak grp ${target.name} przez: ${attackNpc.nick || attackNpc.name || '?'}!`;
        if (window._uiCacheData.gui) window._uiCacheData.gui.updateStatus(statusLabel, '#e74c3c');

        const tagTarget = () => {
            const e2Cached = _npcCache[liveE2.id];
            const respBaseFromServer = e2Cached && e2Cached.respBaseSeconds ? e2Cached.respBaseSeconds : null;

            const targetData = {
                id: attackNpc.id,
                e2Id: liveE2.id,
                e2Key: target.key,
                grp: pick.grp,
                groupIds: pick.groupIds,
                respBase: respBaseFromServer || target.resp || null,
                ts: Date.now()
            };

            _lastAttackedE2Target = targetData; // NASZ LOKALNY STATE

            if (window._uiCacheData.exp) {
                window._uiCacheData.exp.lastAttackedTarget = targetData;
            }
        };

        const doAttackOnce = () => {
            const now = Date.now();
            if (now - _lastAttackMs < ATTACK_COOLDOWN_MS) return false;
            _lastAttackMs = now;
            tagTarget();
            Engine.hero.heroAtackRequest(attackNpc.id, true);
            return true;
        };

        if (dist > 1) {
            const path = exp.findPathBFS(pos.x, pos.y, attackNpc.x, attackNpc.y, 4000, true);
            if (path && path.length > 0) {
                const reached = await exp.walkSmoothly(path, attackNpc.id);
                if (!reached && currentMapId() === parseInt(target.map_id)) {
                    doAttackOnce();
                }
            } else {
                if (currentMapId() !== parseInt(target.map_id)) {
                    await delay(500);
                    return 'idle';
                }
                doAttackOnce();
                await delay(300);
                return 'attacking';
            }
        }

        const posNow = heroPos();
        if (chebyshev(posNow.x, posNow.y, attackNpc.x, attackNpc.y) <= 1) {
            doAttackOnce();
            await delay(150);
            return 'attacking';
        }
        return 'walking';
    }

    async function _waitAtSpawn(target, exp) {
        const pos = heroPos();
        const saved = getSavedCoordsForCurrent(target.key);
        const spawnX = saved && (!saved.mapId || saved.mapId === currentMapId()) ? saved.x : target.spawn_x;
        const spawnY = saved && (!saved.mapId || saved.mapId === currentMapId()) ? saved.y : target.spawn_y;
        const distToSpawn = chebyshev(pos.x, pos.y, spawnX, spawnY);

        if (distToSpawn > WAIT_NEAR_DIST) {
            if (parseInt(target.map_id) !== currentMapId()) {
                await delay(500);
                return 'idle';
            }
            if (window._uiCacheData.gui) window._uiCacheData.gui.updateStatus(`E2 – Biegnę na respa: ${target.name}`, '#3498db');
            const path = exp.findPathBFS(pos.x, pos.y, spawnX, spawnY, 4000);
            if (path && path.length > 0) {
                const shouldStop = () => !!findLiveE2OnMap(target);
                await exp.walkSmoothly(path, null, shouldStop);
                if (findLiveE2OnMap(target)) return 'walking';
            } else {
                await delay(1000);
            }
            return 'walking';
        }

        if (isOtherPlayerNearSpawn(spawnX, spawnY)) {
            ignoreE2(target.key, 'obcy gracz na respie');
            if (window._uiCacheData.gui) window._uiCacheData.gui.updateStatus(`E2 – Spocik zajęty! Ignoruje 30 min.`, '#e67e22');
            await delay(1000);
            return 'waiting';
        }

        if (window._uiCacheData.gui) {
            const distLabel = distToSpawn === 0 ? 'na respie' : `${distToSpawn} p. od respa`;
            window._uiCacheData.gui.updateStatus(`E2 – Czekam ${distLabel}: ${target.name} (${_fmtTime(secondsToMinResp(target.key))})`, '#9b59b6');
        }
        try { if (typeof Engine.hero.stop === 'function') Engine.hero.stop(); } catch(e) {}
        await delay(WAIT_POLL_MS);
        return 'waiting';
    }

    function _handleBattle() {
        if (!Engine.battle.endBattle && !Engine.battle.isAutoFightActive()) {
            try { window._g('fight&a=f'); } catch(e) {}
        }
        if (Engine.battle.endBattle || document.querySelector('.close-fight-button') || document.querySelector('.battle-summary')) {
            if (_lastAttackedE2Target) {
                const tData = _lastAttackedE2Target;
                const checkId = tData.e2Id || tData.id;
                const npcsNow = typeof Engine.npcs.check === 'function' ? Engine.npcs.check() : Engine.npcs.d;
                const mob = npcsNow[checkId] ? (npcsNow[checkId].d || npcsNow[checkId]) : null;
                const isDead = !mob || mob.hp === 0 || mob.dead || mob.st === 1 || mob.st === 2;
                if (isDead && tData.e2Key) {
                    const npcCached = _npcCache[checkId];
                    const netRespBase = npcCached && npcCached.respBaseSeconds ? npcCached.respBaseSeconds : null;
                    const finalBase = netRespBase || tData.respBase;
                    const respRand = npcCached ? getRespRand(npcCached.wt, npcCached.resp_rand) : 0.10;
                    const src = netRespBase ? 'walka+sieć' : 'walka+stan';

                    if (!getTimer(tData.e2Key)) {
                         saveRespawnTimer(tData.e2Key, finalBase, respRand, src);
                         _pushFeed(`⚔️ Ubito (endBattle): ${tData.e2Key}`, '#2ecc71');
                         if (window._uiCacheData.party && window._uiCacheData.party.notifyE2Killed) window._uiCacheData.party.notifyE2Killed();
                    }
                }
                _lastAttackedE2Target = null;
            }
            try { window._g('fight&a=exit'); } catch(e) {}
            const btn = document.querySelector('.close-fight-button');
            if (btn) btn.click();
        }
    }

    function _fmtTime(secs) {
        if (secs <= 0) return '00:00';
        const m = Math.floor(secs / 60);
        const s = secs % 60;
        return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
    }

    function getQueueStatus() {
        const allE2 = window._uiCacheData.e2 || [];
        const e2Map = {};
        for (const e of allE2) e2Map[e.key] = e;

        const myEntry = findMyRosterEntry();
        const keys = myEntry ? (myEntry.e2Keys || []) : [];

        if (keys.length === 0) return 'Brak przypisanych E2';

        return keys.slice(0, 3).map(key => {
            const e2 = e2Map[key];
            if (!e2) return `❓ ${key}`;
            if (isIgnored(key)) return `⛔ ${e2.name}`;
            if (isDefinitelyNotRespawned(key)) return `⏳ ${e2.name} (${_fmtTime(secondsToMinResp(key))})`;
            return `✅ ${e2.name}`;
        }).join(' | ');
    }

    function injectE2LogicIntoMainLoop() {
        if (!window._uiCacheData || !window._uiCacheData.exp || typeof window._uiCacheData.exp.handleAutoExp !== 'function') {
            setTimeout(injectE2LogicIntoMainLoop, 500);
            return;
        }
        if (window._uiCacheData.exp._e2Hooked) return;

        const originalHandleAutoExp = window._uiCacheData.exp.handleAutoExp;
        window._uiCacheData.exp.handleAutoExp = async function(config, setMapCooldown) {
            if (config.e2Enabled && window._uiCacheData.autoe2) {
                if (typeof window._uiCacheData.autoe2.handleE2Logic === 'function') {
                    const status = window._uiCacheData.autoe2.getQueueStatus();
                    if (window._uiCacheData.gui) window._uiCacheData.gui.updateStatus('E2: ' + status, '#c9a465');
                    await window._uiCacheData.autoe2.handleE2Logic(config, setMapCooldown);
                    // v28: prosta kolejka jest jedynym źródłem E2. Nie spadamy już do
                    // starego trybu legacy/klasycznego z elite2Key/e2Queue.
                    return;
                }
            }
            return await originalHandleAutoExp.apply(this, arguments);
        };
        window._uiCacheData.exp._e2Hooked = true;
    }

    injectE2LogicIntoMainLoop();
    hookNetworkForDeaths();

    window._uiCacheData.autoe2 = {
        handleE2Logic,
        getQueueStatus,
        saveRespawnTimer,
        ignoreE2,
        isIgnored,
        getIgnoreMap,
        clearIgnoreMap,
        getTimer,
        clearTimer,
