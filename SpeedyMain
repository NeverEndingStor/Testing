        }
        const store = window.__speedyE2SchedulerStore;
        if (!store?.write || !Engine?.hero?.d?.id) return false;
        const hostParts = location.hostname.split('.');
        const world = hostParts[0];
        const domain = location.hostname.endsWith('.com') ? 'com' : 'pl';
        store.write({
            version: 1,
            kind: 'EXP',
            state: 'EXP_OFFLINE_WAIT',
            createdAt: Date.now(),
            charId: Number(Engine.hero.d.id),
            nick: Engine.hero.d.nick || '',
            world,
            domain,
            setupName: config.activeSetup,
            anchorMapId: Number(st.anchorMapId),
            firstMobName: st.firstMobName || '',
            minResp: Number(st.minResp || 0),
            maxResp: Number(st.maxResp || 0),
            wakeAt,
            source: st.respSource || 'npc-packet'
        });
        if (window._uiCacheData.gui?.updateStatus) {
            const left = Math.max(0, wakeAt - now);
            window._uiCacheData.gui.updateStatus(`Poczekalnia EXP: wylogowanie na ${Math.ceil(left/60)} min`, '#9b59b6');
