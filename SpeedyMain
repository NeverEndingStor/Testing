            if (await handleSpecialTransit(activeSetupName, currentMapId, setMapCooldown)) return;

            let nextHopMapId = getNextHopMap(currentMapId, targetMapId);
            if (!nextHopMapId) {
                // v1.0.3: jeżeli jedyna piesza droga prowadzi przez mapę za wysokiego poziomu
