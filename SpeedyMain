                    anticaptchaOpen:    this.settings.anticaptchaOpen,
                    anticaptchaMinTime: this.settings.anticaptchaMinTime,
                    anticaptchaMaxTime: this.settings.anticaptchaMaxTime,
                }));
            } catch(_) {}

            // BLOKADA ZAPISU - Jeśli gra nie załadowała jeszcze ID postaci, zabroń zapisu,
            // aby zapobiec nadpisywaniu się błędnych danych pod kluczem "_ext_ui_prefs_v2_null"
            if (!this.currentHeroId) return;

