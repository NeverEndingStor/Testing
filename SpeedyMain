/**
 * M-Helper - Moduł Auto-Ulepszania (kowadło)
 * Własny licznik limitu bazujący na zmiennej z gry: Engine.crafting.enhanceUsages.count
 */
(function () {
    if (!window._uiCacheData) window._uiCacheData = {};
    if (window._uiCacheData.upgrade) return;

    let isProcessingRequest = false;

    const TYPE_MAP = {
        weapon:   [1, 2, 3, 4],
        wand:     [6],
        offhand:  [5],
        armor:    [8],
        helmet:   [9],
        boots:    [10],
        gloves:   [11],
        ring:     [12],
        necklace: [13],
        shield:   [14],
        orb:      [7],
        arrows:   [29]
    };

    function collectIngredients(targetItemId, config) {
        const upgradeSlots   = config.upgradeSlots   || {};
        const upgradeTypes   = config.upgradeTypes   || {};

        let allowedCls = [];
        for (const slotKey in upgradeSlots) {
            if (upgradeSlots[slotKey] && TYPE_MAP[slotKey]) {
                allowedCls = allowedCls.concat(TYPE_MAP[slotKey]);
            }
        }

        const allItems = Engine.heroEquipment.getHItems();
        const ingredients = [];

        for (const id in allItems) {
            const item = allItems[id];
            if (String(item.id) === String(targetItemId)) continue;
            if (item.loc !== 'g') continue;
            if (item.st !== 0) continue;

            const stats = item._cachedStats || {};

            if (stats.soulbound || stats.permbound || stats.quest ||
                stats.timelimit || stats.enhancement_upgrade_lvl) {
                continue;
            }

            if (stats.artisan_worthless) continue;
            const rawStat = item.stat || (item.d && item.d.stat) || '';
            if (typeof rawStat === 'string' && rawStat.includes('artisan_worthless')) continue;
            if (typeof rawStat === 'object' && rawStat !== null && rawStat.artisan_worthless) continue;
            try {
                if (typeof item.issetStat === 'function' && item.issetStat('artisan_worthless')) continue;
                if (typeof item.getStat  === 'function' && item.getStat('artisan_worthless'))   continue;
            } catch(e) {}

            const rarity   = stats.rarity || 'common';
            const isCommon = rarity === 'common';
            const isUnique = rarity === 'unique';

            const rarityOk = (isCommon && upgradeTypes.normal) ||
                             (isUnique && upgradeTypes.unique);
            if (!rarityOk) continue;

            if (allowedCls.includes(Number(item.cl))) {
                ingredients.push(item.id);
            }
        }

        return ingredients;
    }

    // Pobierz limit ZAWSZE z silnika gry – jest to jedyne wiarygodne źródło prawdy.
    // Lokalny licznik służy TYLKO jako pesymistyczne zabezpieczenie w trakcie batcha,
    // zanim serwer zdąży odświeżyć Engine.crafting.enhanceUsages.count.
    let _localPessimisticExtra = 0;

    function getDailyUsage() {
        let engineUsage = 0;
        if (typeof Engine !== 'undefined' && Engine.crafting && Engine.crafting.enhanceUsages) {
            engineUsage = parseInt(Engine.crafting.enhanceUsages.count) || 0;
        }
        // Zwracamy max(silnik, silnik + pesymistyczny naddatek po batchu)
        return engineUsage + _localPessimisticExtra;
    }

    function processEnhancement(targetItemId, ingredientIds, threshold, gui) {
        isProcessingRequest = true;
        if (gui) gui.updateStatus('⚒️ Otwieram kowadło...', '#e5c07b');

        const currentUsage = getDailyUsage();
        const availableSlots = 2000 - currentUsage;
        const maxBatchSize = Math.min(threshold, availableSlots);

        const batch = ingredientIds.slice(0, maxBatchSize);
        const batchSize = batch.length;

        window._g('enhancement&action=open&item=' + targetItemId, function (res) {
            setTimeout(function () {
                window._g('enhancement&action=progress&item=' + targetItemId + '&ingredients=' + batch.join(','), function (res2) {

                    // Obsługa WSZYSTKICH błędów serwera, nie tylko 1801001
                    const hasError = res2 && res2.e;
                    if (hasError) {
                        const errCode = String(res2.e);
                        if (errCode.includes('1801001')) {
                            // Limit 2000 po stronie serwera
                            if (gui) {
                                gui.updateStatus('⚠️ Serwer: Limit 2000 wyczerpany!', '#e06c75');
                                gui.settings.upgradeEnabled = false;
                                gui.saveSettings();
                                if (typeof gui.applySettingsToUI === 'function') gui.applySettingsToUI();
                            }
                        } else {
                            // Inny błąd (timeout, maintenance itp.) – logujemy, ale NIE inkrementujemy licznika
                            if (gui) gui.updateStatus(`⚠️ Błąd kowadła: ${errCode}`, '#e06c75');
                        }
                    } else {
                        // SUKCES: pesymistyczny naddatek – zostanie wyzerowany gdy silnik odświeży stan
                        _localPessimisticExtra += batchSize;
                        // Zeruj naddatek gdy silnik zaktualizuje wartość (sprawdzamy co 5s)
                        setTimeout(() => { _localPessimisticExtra = 0; }, 5000);

                        if (gui && typeof gui.updateUpgradeDailyLimit === 'function') {
                            gui.updateUpgradeDailyLimit(getDailyUsage());
                        }
                    }

                    // Zamknij okno kowadła
                    try {
                        var closeBtn = document.querySelector('.crafting')?.closest('.border-window')?.querySelector('.close-button');
                        if (closeBtn) closeBtn.click();
                    } catch (e) {}

                    isProcessingRequest = false;
                    if (gui && gui.settings.upgradeEnabled) {
                        gui.updateStatus('✨ Pył naładowany! Exp trwa...', '#98c379');
                    }
                });
            }, 800);
        });
    }

    function handleAutoUpgrade(config) {
        if (!config.upgradeEnabled) return false;
        if (isProcessingRequest)    return true;

        const gui = window._uiCacheData.gui;
        const currentUsage = getDailyUsage();

        if (gui && typeof gui.updateUpgradeDailyLimit === 'function') {
            gui.updateUpgradeDailyLimit(currentUsage);
        }

        if (currentUsage >= 2000) {
            if (gui) {
                gui.updateStatus('🛑 Dzienny limit ulepszeń (2000) wykorzystany!', '#e06c75');
                const btn = document.getElementById('set-upgradeEnabled');
                if (btn) {
                    btn.className = 'toggle-button-small off';
                    btn.innerText = 'OFF';
                }
                gui.settings.upgradeEnabled = false;
                gui.saveSettings();
            }
            return false;
        }

        const targetItemId = config.upgradeItemId;
        if (!targetItemId) return false;

        if (!Engine || !Engine.items || !Engine.heroEquipment) return false;

        const targetItem = Engine.items.getItemById(targetItemId);
        if (!targetItem) {
            if (gui) {
                gui.updateStatus('⚠️ Przedmiot ulepszania zniknął!', '#e06c75');
                gui.settings.upgradeItemId   = null;
                gui.settings.upgradeItemName = '';
                gui.settings.upgradeEnabled  = false;
                gui.saveSettings();
                if (typeof gui.applyUpgradeItemPreview === 'function') gui.applyUpgradeItemPreview();
                if (typeof gui.applySettingsToUI === 'function') gui.applySettingsToUI();
            }
            return false;
        }

        const threshold = Math.max(1, parseInt(config.upgradeMinItems) || 3);
        const ingredients = collectIngredients(targetItemId, config);

        if (gui && typeof gui.updateUpgradeCounter === 'function') {
            gui.updateUpgradeCounter(ingredients.length, threshold);
        }

        const availableSlots = 2000 - currentUsage;
        const currentThreshold = Math.min(threshold, availableSlots);

        if (currentThreshold <= 0) return false;

        if (gui && ingredients.length >= currentThreshold) {
            gui.updateStatus(`⚒️ Pył: ${ingredients.length}/${currentThreshold} — Kowadło!`, '#e5c07b');
        }

        if (ingredients.length >= currentThreshold) {
            processEnhancement(targetItemId, ingredients, currentThreshold, gui);
            return true;
        }

        return false;
    }

    window._uiCacheData.upgrade = {
        handleAutoUpgrade
    };
})();

// ====== route_optimizer.js (bundled) ======
(function () {
    if (!window._uiCacheData) window._uiCacheData = {};

    const CITY_MAPS = {
        Ithan: 1,
        Torneg: 2,
        Werbin: 9,
        Eder: 33,
        Karkahan: 35,
        Thuzal: 114,
        Rozstaje: 500,
        Tuzmer: 589,
        Nithal: 574,
        Trupia: 1141
    };

    function getItems() {
        try {
            if (Engine.heroEquipment && typeof Engine.heroEquipment.getHItems === 'function') {
                return Engine.heroEquipment.getHItems() || {};
            }
        } catch (e) {}
        return {};
    }

    function getItemName(item) {
        try {
            return (item.name || (item.getName && item.getName()) || (item.d && item.d.name) || '').trim();
        } catch (e) { return ''; }
    }

    function getItemStat(item) {
        try {
            return String(item.stat || (item.d && item.d.stat) || '');
        } catch (e) { return ''; }
    }

    function getItemStack(item) {
        try {
            const amount = item.amount ?? item._amount ?? (item.d && (item.d.amount ?? item.d._amount));
            if (Number.isFinite(Number(amount))) return Number(amount);
            const st = item.st ?? (item.d && item.d.st);
            // st nie zawsze oznacza stack, więc tylko wartości dodatnie pokazujemy informacyjnie.
            return Number.isFinite(Number(st)) && Number(st) > 0 ? Number(st) : 1;
        } catch (e) { return 1; }
    }

    function getMapDistance(start, target) {
        start = parseInt(start);
        target = parseInt(target);
        if (!start || !target) return Infinity;
        if (start === target) return 0;

        const graph = window._uiCacheData.graph || {};
        const queue = [{ id: start, dist: 0 }];
        const visited = new Set([start]);

        while (queue.length) {
            const cur = queue.shift();
            const neighbors = graph[String(cur.id)] || graph[cur.id] || [];
            for (const nRaw of neighbors) {
                const n = parseInt(nRaw);
                if (!n || visited.has(n)) continue;
                if (n === target) return cur.dist + 1;
                visited.add(n);
                queue.push({ id: n, dist: cur.dist + 1 });
            }
        }
        return Infinity;
    }

    function detectInventoryTeleports() {
        const result = [];
        const items = getItems();

        for (const key in items) {
            const item = items[key];
            if (!item) continue;

            const name = getItemName(item);
            const stat = getItemStat(item);
            const low = stat.toLowerCase();

            const direct = low.match(/(?:custom_)?teleport[=:](\d+)/);
            if (direct) {
                result.push({
                    type: 'direct',
                    name,
                    itemId: item.id || (item.d && item.d.id) || key,
                    destMapId: parseInt(direct[1]),
                    stack: getItemStack(item),
                    stat
                });
                continue;
            }

            // Teleportopodobny item bez jednoznacznego map_id.
            const looksTeleportish =
                /teleport|zwój|zwoj|przenie/i.test(name) ||
                /teleport|action=.*tele|custom_tele/i.test(low);

            if (looksTeleportish) {
                result.push({
                    type: 'unknown',
                    name,
                    itemId: item.id || (item.d && item.d.id) || key,
                    destMapId: null,
                    stack: getItemStack(item),
                    stat
                });
            }
        }

        // Deduplikacja po itemId + dest.
        const seen = new Set();
        return result.filter(t => {
            const k = `${t.itemId}|${t.destMapId || 'x'}`;
            if (seen.has(k)) return false;
            seen.add(k);
            return true;
        });
    }

    function getCurrentTargetMaps() {
        try {
            const gui = window._uiCacheData.gui;
            const cfg = gui && gui.getSettings ? gui.getSettings() : {};

            // Route Optimizer działa WYŁĄCZNIE dla zwykłego EXP.
            // Nie analizuje Herosów ani E2 i nie może wpływać na ich nawigację.
            if (cfg.heroOnlyMode || cfg.e2Enabled) return [];

            const active = cfg.activeSetup;
            const arr = cfg.setups && active ? cfg.setups[active] : null;
            if (Array.isArray(arr) && arr.length) {
                return arr.map(m => parseInt(m.id || m)).filter(Boolean);
            }
        } catch (e) {}
        return [];
    }

    function nearestTargetDistance(fromMapId, targets) {
        let best = { mapId: null, distance: Infinity, index: -1 };
        targets.forEach((t, index) => {
            const d = getMapDistance(fromMapId, t);
            if (d < best.distance) best = { mapId: t, distance: d, index };
        });
        return best;
    }

    // Koszt przejścia po KOLEJNOŚCI setupu od indeksu "fromIndex" do końca.
    // Dzięki temu teleport na późniejszą mapę może wygrać nawet wtedy,
    // gdy nie jest najbliżej pierwszej mapy setupu.
    function buildRouteSuffixCosts(targets) {
        const suffix = new Array(targets.length).fill(Infinity);
        if (!targets.length) return suffix;

        suffix[targets.length - 1] = 0;
        for (let i = targets.length - 2; i >= 0; i--) {
            const edge = getMapDistance(targets[i], targets[i + 1]);
            suffix[i] = Number.isFinite(edge) && Number.isFinite(suffix[i + 1])
                ? edge + suffix[i + 1]
                : Infinity;
        }
        return suffix;
    }

    function getRouteStartIndex(currentMapId, targets) {
        const exact = targets.indexOf(parseInt(currentMapId));
        if (exact >= 0) return exact;

        // Poza setupem zaczynamy od początku trasy.
        return 0;
    }

    function evaluateEntry(fromMapId, targets, suffixCosts, minIndex = 0) {
        let best = null;

        for (let i = Math.max(0, minIndex); i < targets.length; i++) {
            const approach = getMapDistance(fromMapId, targets[i]);
            if (!Number.isFinite(approach) || !Number.isFinite(suffixCosts[i])) continue;

            const total = approach + suffixCosts[i];
            const skippedMaps = Math.max(0, i - minIndex);

            if (!best || total < best.total || (total === best.total && i > best.index)) {
                best = {
                    mapId: targets[i],
                    index: i,
                    approachDistance: approach,
                    remainingRouteDistance: suffixCosts[i],
                    total,
                    skippedMaps
                };
            }
        }

        return best;
    }

    function analyze() {
        const currentMapId = parseInt(Engine && Engine.map && Engine.map.d && Engine.map.d.id);
        const targets = getCurrentTargetMaps();
        const teleports = detectInventoryTeleports();

        const suffixCosts = buildRouteSuffixCosts(targets);
        const routeStartIndex = getRouteStartIndex(currentMapId, targets);

        // Pieszo: kontynuujemy od aktualnej pozycji w trasie.
        const direct = targets.length
            ? evaluateEntry(currentMapId, targets, suffixCosts, routeStartIndex)
            : null;

        const rows = teleports.map(tp => {
            if (!tp.destMapId || !targets.length) {
                return {
                    ...tp,
                    distanceAfterTeleport: null,
                    totalCost: null,
                    savings: null,
                    skippedMaps: 0,
                    verdict: tp.destMapId ? 'Brak aktywnego celu' : 'Wymaga mapowania dialogu'
                };
            }

            // Teleport kosztuje 0 map. Szukamy NAJLEPSZEGO punktu wejścia w dalszą część trasy,
            // a nie tylko najbliższej mapy setupu.
            const after = evaluateEntry(tp.destMapId, targets, suffixCosts, routeStartIndex);

            if (!after) {
                return {
                    ...tp,
                    distanceAfterTeleport: null,
                    totalCost: Infinity,
                    savings: null,
                    skippedMaps: 0,
                    verdict: 'Brak trasy od celu teleportu'
                };
            }

            const total = after.total; // teleport sam w sobie ma koszt 0
            const savings = direct && Number.isFinite(direct.total)
                ? direct.total - total
                : null;

            let verdict;
            if (savings === null) {
                verdict = 'Brak porównania z trasą pieszą';
            } else if (savings > 0) {
                verdict = `Szybciej o ${savings} map`;
                if (after.skippedMaps > 0) verdict += ` • omija ${after.skippedMaps} map trasy`;
            } else if (savings === 0) {
                verdict = after.skippedMaps > 0
                    ? `Remis kosztu • omija ${after.skippedMaps} map trasy`
                    : 'Remis z pieszo';
            } else {
                verdict = `Pieszo szybciej o ${Math.abs(savings)} map`;
            }

            return {
                ...tp,
                nearestTargetMapId: after.mapId,
                targetIndex: after.index,
                distanceAfterTeleport: after.approachDistance,
                remainingRouteDistance: after.remainingRouteDistance,
                totalCost: total,
                savings,
                skippedMaps: after.skippedMaps,
                verdict
            };
        });

        rows.sort((a, b) => {
            const av = a.savings === null ? -999999 : a.savings;
            const bv = b.savings === null ? -999999 : b.savings;
            if (bv !== av) return bv - av;
            return (b.skippedMaps || 0) - (a.skippedMaps || 0);
        });

        return {
            currentMapId,
            currentMapName: Engine && Engine.map && Engine.map.d ? Engine.map.d.name : '',
            targets,
            routeStartIndex,
            direct,
            teleports: rows,
            cities: CITY_MAPS
        };
    }

    function refreshUI() {
        const box = document.getElementById('route-optimizer-results');
        const summary = document.getElementById('route-optimizer-summary');
        if (!box || !summary) return;

        let data;
        try { data = analyze(); } catch (e) {
            summary.textContent = 'Błąd analizy: ' + (e && e.message ? e.message : e);
            return;
        }

        const directText = data.targets.length
            ? (data.direct && Number.isFinite(data.direct.total)
                ? `${data.currentMapName || data.currentMapId} (${data.currentMapId}) → wejście ${data.direct.mapId} [${data.direct.index + 1}/${data.targets.length}] → koniec trasy: ${data.direct.total} map pieszo`
                : `Brak trasy pieszej do aktywnego celu`)
            : `Brak aktywnego setupu / celu`;

        summary.textContent = directText;

        if (!data.teleports.length) {
            box.innerHTML = '<div style="color:var(--text-muted);font-size:11px;padding:8px 0;">Nie wykryto teleportów w ekwipunku.</div>';
            return;
        }

        box.innerHTML = data.teleports.map(tp => {
            const dest = tp.destMapId ? `map ${tp.destMapId}` : 'map_id nieznane';
            const routePos = tp.targetIndex !== undefined && tp.targetIndex !== null
                ? ` • wejście: ${tp.targetIndex + 1}/${data.targets.length}`
                : '';
            const cost = tp.totalCost === null
                ? tp.verdict
                : `${tp.totalCost} map pieszo${routePos} • ${tp.verdict}`;
            const badge = tp.type === 'direct' ? 'DIRECT' : 'DIALOG/UNKNOWN';

            return `
                <div style="padding:8px 9px;border:1px solid rgba(255,255,255,.07);border-radius:6px;margin-bottom:6px;background:rgba(0,0,0,.14);">
                    <div style="display:flex;justify-content:space-between;gap:8px;align-items:center;">
                        <div style="font-size:11px;color:var(--text-main);font-weight:600;">${tp.name || '(bez nazwy)'}</div>
                        <span style="font-size:8px;color:var(--text-muted);border:1px solid rgba(255,255,255,.1);padding:1px 4px;border-radius:3px;">${badge}</span>
                    </div>
                    <div style="font-size:10px;color:var(--text-muted);margin-top:3px;">
                        ${dest} • ilość: ${tp.stack}
                    </div>
                    <div style="font-size:10px;color:${tp.savings > 0 ? 'var(--accent-green)' : 'var(--text-muted)'};margin-top:3px;">
                        ${cost}
                    </div>
                </div>`;
        }).join('');
    }

    window._uiCacheData.routeOptimizer = {
        analyze,
        refreshUI,
        detectInventoryTeleports,
        getMapDistance,
        cityMaps: CITY_MAPS
    };
})();

