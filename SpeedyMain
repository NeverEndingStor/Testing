function countItemInBag(itemName) {
        if (!Engine || !Engine.heroEquipment || typeof Engine.heroEquipment.getHItems !== 'function') return 0;
        const items = Engine.heroEquipment.getHItems();
        let count = 0;
        const lowerName = (itemName || '').toLowerCase().trim();
        const isKwieciste = lowerName.includes('kwieciste');

        for (const key in items) {
            const item = items[key];
            if (!isItemInInventory(item)) continue;

            const name = (item.name || (item.getName && item.getName()) || '').toLowerCase();
            const stat = (item.stat || (item.d && item.d.stat) || '').toLowerCase();

            const match = (lowerName && name.includes(lowerName)) ||
                          (isKwieciste && (name.includes('kwieciste') || stat.includes('teleport=353')));

            if (match) {
                let am = 1;
                if (typeof item.getAmount === 'function') {
                    let parsedAm = item.getAmount();
                    if (!isNaN(parsedAm) && parsedAm > 0) am = parsedAm;
                } else if (item._cachedStats && item._cachedStats.amount) {
                    am = item._cachedStats.amount;
                } else {
                    const matchAm = stat.match(/amount=(\d+)/);
                    if (matchAm) am = parseInt(matchAm[1], 10);
                }
                count += (parseInt(am) || 1);
            }
        }
        return count;
    }

