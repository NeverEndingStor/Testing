    function collectItemsToList(config) {
        if (!Engine || !Engine.heroEquipment || typeof Engine.heroEquipment.getHItems !== 'function') return [];
        const items = Engine.heroEquipment.getHItems();
        const blacklist = (config.auctionBlacklist || '')
            .split(',').map(s => s.trim().toLowerCase()).filter(Boolean);

        const result = [];

        for (const key in items) {
            const item = items[key];
            if (!isItemInInventory(item)) continue;

            const tier = getItemTier(item);
            if (!tier || tier === null) continue;

            const name = (item.name || (item.getName && item.getName()) || (item.d && item.d.name) || '').toLowerCase();
            if (blacklist.some(bl => name.includes(bl))) continue;

            if (tier === 'normal'  && !config.auctionFilterNormal) continue;
            if (tier === 'unique'  && !config.auctionFilterUnique) continue;
            if (tier === 'heroic'  && !config.auctionFilterHero)   continue;

            let minPrice = 0, buyOutPrice = 0;
            if (tier === 'normal') {
                minPrice    = parseInt(config.auctionMinNormal) || 0;
                buyOutPrice = parseInt(config.auctionMaxNormal) || 100000;
            } else if (tier === 'unique') {
                minPrice    = parseInt(config.auctionMinUnique) || 0;
                buyOutPrice = parseInt(config.auctionMaxUnique) || 3000000;
            } else if (tier === 'heroic') {
                minPrice    = parseInt(config.auctionMinHero) || 0;
                buyOutPrice = parseInt(config.auctionMaxHero) || 15000000;
            }

            result.push({
                id:       item.id || item.d.id,
                name:     item.name || (item.d && item.d.name) || '',
                tier,
                minPrice,
                buyOutPrice
            });
        }
        return result;
    }

