        try {
            if (typeof Engine !== 'undefined' && Engine.hero && Engine.hero.d)
                return parseInt(Engine.hero.d.lvl) || 0;
        } catch (e) {}
        return 0;
    }

    function getSetupForLevel(lvl) {
        let result = AUTOMAT_TABLE[0].setupName;
        for (let i = 0; i < AUTOMAT_TABLE.length; i++) {
            if (lvl >= AUTOMAT_TABLE[i].minLvl) {
                result = AUTOMAT_TABLE[i].setupName;
            } else {
                break;
            }
        }
        return result;
    }

