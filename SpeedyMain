    //
    //  Problem: mapa 589 ma fizyczną barierę dzielącą ją na dwie strony.
    //  Graf map traktuje 589 jako jedną mapę i mówi "idź do 630",
    //  ale BFS po pikselach nie może przekroczyć bariery — bot stoi.
    //
    //  Rozwiązanie dwutorowe:
    //
    //  1. globalTransitRoutes["589"] — wywoływane przez getNextHopMap()
    //     gdy bot jest POZA setupMaps i potrzebuje next-hop do celu.
    //     Zwraca właściwy kierunek przez barierę zamiast bezpośrednio 630.
    //
    //  2. _getGlobalTransitNextHop — wywoływane przez handleMapTransition()
    //     gdy bot jest W setupMaps na mapie 589.
    //
    //  Wspólna logika:
    //    Wschód + wraca z expa (lastMap ∈ EAST_MAPS) → 1541
    //    Wschód + cel po wschodzie                   → 2869
    //    Wschód + cel po zachodzie (np. port 630)    → 1541 (przejdź barierę)
    //    Zachód + bramka do celu osiągalna            → null (autoexp sam trafi)
    //    Zachód + bramka nieosiągalna                 → 1539 (objedź przez tranzyt)
    // ═══════════════════════════════════════════════════════════════

    function tuzmerResolve589(targetMapId) {
        const side = tuzmerGetSide();
        const lastMap = parseInt(window._uiCacheData._lastExitedMapId);

        // Na zachodniej stronie — oddaj sterowanie autoexpowi.
        // Bot tu wylądował albo przez objazdową trasę (lastMap=1539/1541)
        // albo wchodząc z zachodu normalnie. W obu przypadkach bariera jest
        // za nim i BFS pikselowy znajdzie bramki (do 630, do miast itp.).
        if (side === "west" || side === null) {
            return null;
        }

        // Na wschodniej stronie
        if (TUZMER_EAST_MAPS.has(lastMap)) return 1541; // wraca z expa → na zachód

        const targetIsEast = TUZMER_EAST_MAPS.has(parseInt(targetMapId));
        if (targetIsEast) return 2869;  // cel po wschodzie → wyjdź przez 2869

        return 1541; // cel po zachodzie (np. port 630) → przejdź barierę
    }

    // --- Hook 1: dla bota POZA setupMaps (getNextHopMap → globalTransitRoutes) ---
    if (!window._uiCacheData.globalTransitRoutes) window._uiCacheData.globalTransitRoutes = {};

    window._uiCacheData.globalTransitRoutes["589"] = function(helpers, targetMapId) {
        return tuzmerResolve589(targetMapId);
    };

    // Mapa 1541 jest "sluza" tranzytową między 589-wschód a 1539.
    // Gdy bot tu trafia jadąc NA ZACHÓD (lastMap=589), musi iść do 1539 — nie wracać na 589.
    // Gdy bot tu trafia jadąc NA WSCHÓD (lastMap=1539), musi iść do 589 (wyląduje po wschodniej).
    window._uiCacheData.globalTransitRoutes["1541"] = function(helpers, targetMapId) {
        const lastMap = parseInt(window._uiCacheData._lastExitedMapId);
        if (lastMap === 589) return 1539; // przyszedł ze wschodniej 589 → jedź do 1539
        return 589;                        // przyszedł z 1539 → wróć na 589 (wyląduje po wschodniej)
    };

    // Mapa 1539 jest "sluza" tranzytową między 589-zachodnią a 1541.
    // Gdy bot tu trafia jadąc NA WSCHÓD (lastMap=589-zachodnia), idzie do 1541.
    // Gdy bot tu trafia jadąc NA ZACHÓD (lastMap=1541), wraca na 589 (wyląduje po zachodniej).
    window._uiCacheData.globalTransitRoutes["1539"] = function(helpers, targetMapId) {
        const lastMap = parseInt(window._uiCacheData._lastExitedMapId);
        if (lastMap === 1541) return 589; // przyszedł z 1541 → wróć na 589 (zachodnia)
        return 1541;                       // przyszedł z zachodniej 589 → jedź do 1541
    };

    // --- Hook 2: dla bota W setupMaps (handleMapTransition → _getGlobalTransitNextHop) ---
    window._uiCacheData._getGlobalTransitNextHop = function(currentMapId) {
        if (parseInt(currentMapId) !== 589) return null;

        // Pobierz pierwszy cel setupu jako targetMapId
        const config = window._uiCacheData.gui ? window._uiCacheData.gui.getSettings() : {};
        const activeSetup = config.activeSetup;
        const setupMapIds = (activeSetup && config.setups && config.setups[activeSetup])
            ? config.setups[activeSetup].map(m => parseInt(m.id || m))
            : [];

        // Sprawdź czy któraś mapa setupu jest bezpośrednio osiągalna
        if (window._uiCacheData.exp) {
            const exp = window._uiCacheData.exp;
            const transitions = exp.getAllMapTransitions ? exp.getAllMapTransitions() : [];
            for (const t of transitions) {
                if (setupMapIds.includes(parseInt(t.affected)) && parseInt(t.affected) !== 589) {
                    if (exp.checkGatewayReachability(t.x, t.y, t.type)) {
                        return null; // cel osiągalny bezpośrednio
                    }
                }
            }
        }

        // Żadna mapa setupu nieosiągalna — użyj wspólnej logiki
        const firstTarget = setupMapIds.find(id => id !== 589) || null;
        return tuzmerResolve589(firstTarget);
    };
})();
