        if (keepAnchor && prev && prev.setupName === config?.activeSetup) {
            _expWaitSave({
                version: 1,
                setupName: prev.setupName,
                anchorMapId: Number(prev.anchorMapId || Engine?.map?.d?.id || 0),
                armed: false,
                visited: [],
                cycleLeftAnchor: false,
