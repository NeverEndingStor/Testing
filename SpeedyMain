        if (!cache.gui) return;

        const config = cache.gui.getSettings();
        if (!config.automatEnabled) return;

        const currentLvl = getHeroLevel();
        if (currentLvl <= 0) return;

        // Jeśli gracz ręcznie zmienił setup z zewnątrz (GUI dropdown itp.),
        // resetujemy lastCheckedLevel, aby automat mógł ponownie zadziałać
        // na tym samym poziomie (np. po cofnięciu setupu przez gracza).
        if (config.activeSetup !== lastKnownSetup) {
            lastKnownSetup = config.activeSetup;
            lastCheckedLevel = -1;
        }

        if (currentLvl === lastCheckedLevel) return;

        const targetSetup = getSetupForLevel(currentLvl);

        if (!config.setups || !config.setups[targetSetup]) {
            return;
        }

        if (config.activeSetup === targetSetup) {
            lastCheckedLevel = currentLvl;
            lastKnownSetup = targetSetup;
            return;
