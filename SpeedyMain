    // v25: Smart Aggro steruje bezpośrednio natywnym ustawieniem gry
    // "Agresywność potworów" (settings id=34).
    let _lastNativeAggroDesired = null;
    let _lastNativeAggroResult = null;

    function setGameAggro(enabled) {
        enabled = !!enabled;
        try {
            if (typeof _g !== 'function') {
                _lastNativeAggroResult = { ok:false, via:'_g-unavailable', enabled };
                return _lastNativeAggroResult;
            }
            _g(`settings&action=update&id=34&v=${enabled ? 1 : 0}`);
            _lastNativeAggroDesired = enabled;
            _lastNativeAggroResult = { ok:true, via:'settings:34', enabled };
            return _lastNativeAggroResult;
        } catch (e) {
            _lastNativeAggroResult = { ok:false, via:'settings:34', enabled, error:String(e && e.message || e) };
            return _lastNativeAggroResult;
        }
    }

    function syncGameMobAggro(enabled, force = false) {
        enabled = !!enabled;
        if (!force && _lastNativeAggroDesired === enabled && _lastNativeAggroResult && _lastNativeAggroResult.ok) {
            return _lastNativeAggroResult;
        }
        return setGameAggro(enabled);
    }

    function invalidateExpTargetCache() {
        _cachedBestTarget = null;
        _cachedBestPath = null;
        _lastBestTargetAt = 0;
        _expPathCache.clear();
    }

    function isExpBattleVisible() {
        try {
            return !!(Engine.battle && Engine.battle.getShow && Engine.battle.getShow());
        } catch (_) {
            return false;
        }
    }

    function isAggressiveExpMob(target) {
        if (!target) return false;

        // Jawne flagi klienta mają pierwszeństwo, jeśli są dostępne.
        for (const key of ['aggressive', 'aggr', 'aggro', 'isAggressive']) {
            if (target[key] !== undefined && target[key] !== null) {
                const v = target[key];
                if (typeof v === 'string') return v === '1' || v.toLowerCase() === 'true';
                return !!v;
            }
        }

        // W danych NPC używanych przez EXP typ 3 oznacza wariant agresywny.
        return parseInt(target.type, 10) === 3;
    }

    function getExpCardinalApproach(target, maxDist = 500) {
        if (!target || !Engine || !Engine.hero || !Engine.hero.d) return null;
        const hx = Engine.hero.d.x, hy = Engine.hero.d.y;

        if (Math.abs(hx - target.x) + Math.abs(hy - target.y) === 1) {
            return { x: hx, y: hy, path: [] };
        }

        const candidates = [
            { x: target.x,     y: target.y - 1 },
            { x: target.x + 1, y: target.y     },
            { x: target.x,     y: target.y + 1 },
            { x: target.x - 1, y: target.y     }
        ];

        let best = null;
        for (const c of candidates) {
            // WAŻNE: findPathBFS dla dokładnego celu potrafi zwrócić ostatnią kratkę
            // zanim sprawdzi jej kolizję. Smart aggro musi więc zweryfikować
            // pole podejścia samodzielnie, inaczej może wybrać skałę/ścianę.
            if (c.x < 0 || c.x >= Engine.map.d.x || c.y < 0 || c.y >= Engine.map.d.y) continue;
            try {
                if (Engine.map.col && typeof Engine.map.col.check === 'function' && Engine.map.col.check(c.x, c.y)) continue;
            } catch (_) {
                continue;
            }

            // Nie wybieraj też kratki zajętej przez innego żywego NPC.
            let occupied = false;
            try {
                const npcs = Engine.npcs && (typeof Engine.npcs.check === 'function' ? Engine.npcs.check() : Engine.npcs.d);
                if (npcs) {
                    for (const k in npcs) {
                        const n = npcs[k].d || npcs[k];
                        if (!n || n.id === target.id || n.dead || n.hp === 0 || n.st === 1 || n.st === 2) continue;
                        if (n.x === c.x && n.y === c.y) { occupied = true; break; }
                    }
                }
            } catch (_) {}
            if (occupied) continue;

            const p = findPathBFS(hx, hy, c.x, c.y, maxDist, false);
            if (p === null || p === undefined) continue;

            // Ostatnie zabezpieczenie: ścieżka ma faktycznie kończyć się na wybranej kratce.
            if (p.length > 0) {
                const end = p[p.length - 1];
                if (!end || end.x !== c.x || end.y !== c.y) continue;
            }
            if (!best || p.length < best.path.length) best = { x: c.x, y: c.y, path: p };
        }
        return best;
    }

    async function approachExpTargetCardinal(target) {
        const approach = getExpCardinalApproach(target);
        if (!approach) {
            unreachableMobs[target.id] = Date.now();
            if (window._uiCacheData.gui) {
                window._uiCacheData.gui.updateStatus(`Brak prostej kratki przy: ${target.nick || target.id}`, '#e67e22');
            }
            return false;
        }

        if (approach.path.length > 0) {
            if (window._uiCacheData.gui) {
                window._uiCacheData.gui.updateStatus(`Podejście: ${target.nick} → [${approach.x},${approach.y}]`, '#3498db');
            }
            const ok = await walkSmoothly(approach.path, target.id, () => false);
            if (!ok && !isExpBattleVisible()) return false;
        }

        if (isExpBattleVisible()) return true;
        const hx = Engine.hero.d.x, hy = Engine.hero.d.y;
        return Math.abs(hx - target.x) + Math.abs(hy - target.y) === 1;
    }

    async function waitForExpAggro(target, waitMs = 600) {
        const deadline = Date.now() + waitMs;
        while (Date.now() < deadline) {
            if (isExpBattleVisible()) return true;
            if (!isMobAliveAndFree(target.id)) return true;
            await delay(50);
