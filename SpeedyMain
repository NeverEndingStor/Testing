                const alt=findBestReachableTransitionToward(targetMapId);
                if(alt){targetMapId=alt.mapId;gatewayCoords=alt.coords;pathToGw=alt.path;transitionData=alt.transitionData;
                    if(window._uiCacheData.gui)window._uiCacheData.gui.updateStatus(`Alternatywna osiągalna trasa → ${alt.mapId}`,'#f39c12');}
