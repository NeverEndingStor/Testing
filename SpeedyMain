    async function smartAttackExpTarget(target, config, currentMapId) {
        if (!target) return false;
        _expWaitMarkAttack(target, currentMapId, config);

        const reached = await approachExpTargetCardinal(target);
        if (!reached) return false;
        if (isExpBattleVisible()) {
            lastAttackedTarget = { id: target.id, grp: target.grp || null, mapId: currentMapId };
            return true;
