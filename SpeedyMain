        const rand    = respRandFloat !== undefined ? respRandFloat : 0.10;
        const base    = parseFloat(respBaseSeconds);
        const minResp = Math.round(base - (base * rand));
        const maxResp = Math.round(base + (base * rand));
        data[e2Key] = { killedAt: now, minResp: now + minResp, maxResp: now + maxResp, respBase: base };
        setWorldData(data);
        const srcLabel = source ? `[${source}]` : '';
        const randPct = Math.round(rand * 100);
        _pushFeed(`⏳ ${e2Key} ${srcLabel} | resp: ${base}s ±${randPct}% | min: ${_fmtTime(minResp)} max: ${_fmtTime(maxResp)}`, '#9b59b6');
    }

