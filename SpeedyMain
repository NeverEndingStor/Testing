    proto.populateClanBlessingSelect = function () {
        const sel = document.getElementById('set-clanBlessingKey');
        if (!sel) return;

        const blessings = window._uiCacheData.clanBlessings;

        // Jeśli gra dostarczyła dane o błogosławieństwach, użyj ich nazw
        if (blessings && Array.isArray(blessings)) {
            const current = this.settings.clanBlessingKey;
