(function () {
    if (!window._uiCacheData) window._uiCacheData = {};
    if (window._uiCacheData.options) return;

    const delay = ms => new Promise(res => setTimeout(res, ms));

    // ══════════════════════════════════════════════════════════════
    //  ANTY DUSZEK (Anti-AFK)
    // ══════════════════════════════════════════════════════════════
    let _antiAfkTimer  = null;
    let _stasisWatcher = null;
    let _stasisMoveLock = false;

    function _canMove() {
        try {
            if (typeof Engine === 'undefined' || !Engine.hero || !Engine.hero.d) return false;
            if (Engine.dead) return false;
            if (Engine.battle && Engine.battle.getShow && Engine.battle.getShow()) return false;
            if (Engine.loots && Engine.loots.window && Engine.loots.window.length > 0) return false;
            if (Engine.crafting && Engine.crafting.window && Engine.crafting.window.opened) return false;
            if (Engine.shop && Engine.shop.window && Engine.shop.window.isShow && Engine.shop.window.isShow()) return false;
            if (Engine.dialog && Engine.dialog.isShow && Engine.dialog.isShow()) return false;
            if (Engine.auction && Engine.auction.window && Engine.auction.window.isShow && Engine.auction.window.isShow()) return false;
            if (Engine.clan && Engine.clan.window && Engine.clan.window.isShow && Engine.clan.window.isShow()) return false;
            if (Engine.lock && Engine.lock.list && Engine.lock.list.length > 0) return false;
            return true;
        } catch(e) { return false; }
    }

    function _isStasisActiveOrIncoming() {
        try {
            if (Engine.hero && Engine.hero.d) {
                if (Engine.hero.d.stasis === 1) return true;
                if (Engine.hero.d.stasis_incoming_seconds > 0) return true;
            }
            const stasisEl = document.querySelector('.stasis-overlay');
            if (stasisEl && stasisEl.style.display !== 'none' && stasisEl.offsetParent !== null) return true;
            const incomingEl = document.querySelector('.stasis-incoming-overlay');
            if (incomingEl && incomingEl.style.display !== 'none' && incomingEl.offsetParent !== null) return true;
            return false;
        } catch(e) { return false; }
    }

    async function _doStasisEscapeMove() {
        if (_stasisMoveLock) return;
        _stasisMoveLock = true;
        try {
            if (!_canMove()) return;

            const KEYS = [
                { keyCode: 87, key: 'w', code: 'KeyW' },
                { keyCode: 83, key: 's', code: 'KeyS' },
                { keyCode: 65, key: 'a', code: 'KeyA' },
                { keyCode: 68, key: 'd', code: 'KeyD' },
            ];
            const OPPOSITE = { 0: 1, 1: 0, 2: 3, 3: 2 };

            const canvas = document.getElementById('GAME_CANVAS') || document.body;
            const press   = (k) => canvas.dispatchEvent(new KeyboardEvent('keydown', { bubbles: true, cancelable: true, keyCode: k.keyCode, which: k.keyCode, key: k.key, code: k.code }));
            const release = (k) => canvas.dispatchEvent(new KeyboardEvent('keyup',   { bubbles: true, cancelable: true, keyCode: k.keyCode, which: k.keyCode, key: k.key, code: k.code }));
            const wait    = ms => new Promise(r => setTimeout(r, ms));

            const fwdIdx = Math.floor(Math.random() * 4);
            const bwdIdx = OPPOSITE[fwdIdx];
            const fwd = KEYS[fwdIdx];
            const bwd = KEYS[bwdIdx];

            if (window._uiCacheData.gui) window._uiCacheData.gui.updateStatus('👻 Duszek! Ruszam się...', '#e74c3c');

            for (let i = 0; i < 2; i++) {
                if (!_canMove()) break;
                press(fwd); await wait(140); release(fwd); await wait(80);
            }
            await wait(200);
            for (let i = 0; i < 2; i++) {
                if (!_canMove()) break;
                press(bwd); await wait(140); release(bwd); await wait(80);
            }
            release(fwd); release(bwd);
        } catch(e) {
        } finally {
            setTimeout(() => { _stasisMoveLock = false; }, 4000);
        }
    }

    function startAntyDuszek() {
        stopAntyDuszek();
        _stasisWatcher = setInterval(() => {
            try {
                if (typeof Engine === 'undefined' || !Engine.hero || !Engine.hero.d) return;
                if (_stasisMoveLock) return;
                if (_isStasisActiveOrIncoming()) _doStasisEscapeMove();
            } catch(e) {}
        }, 2000);
    }

    function stopAntyDuszek() {
        if (_antiAfkTimer !== null)  { clearInterval(_antiAfkTimer);  _antiAfkTimer  = null; }
        if (_stasisWatcher !== null) { clearInterval(_stasisWatcher); _stasisWatcher = null; }
        _stasisMoveLock = false;
    }

    let _lastAntyDuszekState = null;

    function syncAntyDuszek(config) {
        const enabled = !!config.antyDuszek && !!config.isRunning;
        if (enabled !== _lastAntyDuszekState) {
            _lastAntyDuszekState = enabled;
            if (enabled) startAntyDuszek();
            else stopAntyDuszek();
        }
    }

    // ══════════════════════════════════════════════════════════════
    //  AUTO F5
    // ══════════════════════════════════════════════════════════════
    let _autoF5Timer = null;

    function startAutoF5(intervalMinutes) {
        stopAutoF5();
        const ms = Math.max(1, intervalMinutes) * 60 * 1000;
        _autoF5Timer = setTimeout(() => { location.reload(); }, ms);
    }

    function stopAutoF5() {
        if (_autoF5Timer !== null) {
            clearTimeout(_autoF5Timer);
            _autoF5Timer = null;
        }
    }

    let _lastAutoF5State = null;
    let _lastAutoF5Interval = null;

    function syncAutoF5(config) {
        const enabled  = !!config.autoF5;
        const interval = parseFloat(config.autoF5Interval) || 15;

        if (enabled !== _lastAutoF5State || interval !== _lastAutoF5Interval) {
            _lastAutoF5State    = enabled;
            _lastAutoF5Interval = interval;
            if (enabled) startAutoF5(interval);
            else stopAutoF5();
        }
    }

    // ══════════════════════════════════════════════════════════════
    //  HARMONOGRAM I POCZEKALNIA (Nowy system relogu na podstronę)
    // ══════════════════════════════════════════════════════════════
    function isWithinSchedule(fromStr, toStr) {
        const timeRe = /^\d{1,2}:\d{2}$/;
        if (!fromStr || !toStr || !timeRe.test(fromStr) || !timeRe.test(toStr)) return false;

        const now  = new Date();
        const nowM = now.getHours() * 60 + now.getMinutes();
        const [fH, fM] = fromStr.split(':').map(Number);
        const [tH, tM] = toStr.split(':').map(Number);
        const fromM = fH * 60 + fM;
        const toM   = tH * 60 + tM;

        if (isNaN(fromM) || isNaN(toM)) return false;
        if (fromM === toM) return false;

        if (fromM < toM) return nowM >= fromM && nowM < toM;
        else return nowM >= fromM || nowM < toM;
    }

    // Oblicza dokładny czas wznowienia pracy bota
    function getNextWakeUpTime(fromStr) {
        const [h, m] = fromStr.split(':').map(Number);
        let d = new Date();
        d.setHours(h, m, 0, 0);
        // Jeśli godzina z fromStr już dziś minęła, ustaw na jutro
        if (d.getTime() <= Date.now()) {
            d.setDate(d.getDate() + 1);
        }
        return d.getTime();
    }

    // Funkcja przekierowująca do poczekalni
    function redirectToWaitingRoom(reason, wakeUpTime, schedFrom, schedTo) {
        if (window._isRedirectingToPoczekalnia) return;
        window._isRedirectingToPoczekalnia = true;

        if (window._uiCacheData && window._uiCacheData.gui) {
            window._uiCacheData.gui.updateStatus('🚪 Przenoszenie do poczekalni...', '#3498db');
        }

        const payload = {
            reason:    reason    || 'unknown',
            wakeUpTime: wakeUpTime || (Date.now() + 3600000),
            returnUrl: window.location.href,
            schedFrom: schedFrom || '',
            schedTo:   schedTo   || ''
        };

        window.postMessage({ _speedy: true, cmd: 'GOTO_POCZEKALNIA', payload: payload }, '*');
    }

    let _lastScheduleActive = null;

    function _scheduleForceStart(gui) {
        if (!gui || !gui.settings || gui.settings.isRunning) return;
        gui.settings.isRunning = true;
        try {
            if (gui.btnStartToggle) {
                gui.btnStartToggle.className = 'main-toggle on';
                const txt = gui.btnStartToggle.querySelector('.toggle-text');
                const ico = gui.btnStartToggle.querySelector('.toggle-icon');
                if (txt) txt.innerText = 'Pracuje';
                if (ico) ico.innerText = '\u23BD';
            }
        } catch(e) {}
        gui.updateStatus('\u25B6 Harmonogram: uruchamiam bota...', '#27ae60');
        gui.saveSettings();
    }

    // ── STRAŻNIK – niezależny timer co 10s ────────
    setInterval(function() {
        try {
            const gui = window._uiCacheData && window._uiCacheData.gui;
            if (!gui || !gui.settings) return;
            const s = gui.settings;
            if (!s.scheduleEnabled) return;

            const timeRe = /^\d{1,2}:\d{2}$/;
            if (!s.scheduleFrom || !s.scheduleTo || !timeRe.test(s.scheduleFrom) || !timeRe.test(s.scheduleTo)) {
                gui.updateStatus('⚠️ Harmonogram: ustaw godziny OD i DO!', '#e67e22');
                return;
            }

            const active = isWithinSchedule(s.scheduleFrom, s.scheduleTo);

            if (!active) {
                // Jesli postać jest martwa, pozwól użyć zwoju / poczekać na resp, by nie przerywać odrodzenia
                if (typeof Engine !== 'undefined' && Engine.dead) {
                    gui.updateStatus('\u23F8 Poza harmonogramem (czekam na respawn...)', '#95a5a6');
                    return;
                }

                _lastScheduleActive = false;

                if (s.isRunning) {
                    // Bot był włączony - wysyłamy go spać do poczekalni!
                    const wakeUpTime = getNextWakeUpTime(s.scheduleFrom);
                    redirectToWaitingRoom('schedule', wakeUpTime, s.scheduleFrom, s.scheduleTo);
                } else {
                    // Bot jest ręcznie wyłączony, więc tylko informujemy
                    gui.updateStatus('\u23F8 Poza harmonogramem', '#95a5a6');
                }
            } else {
                if (_lastScheduleActive !== true) {
                    _lastScheduleActive = true;
                    _scheduleForceStart(gui);
                }
            }
        } catch(e) {
        }
    }, 10000);

    function checkSchedule(config) {
        if (!config.scheduleEnabled) {
            _lastScheduleActive = null;
            return false;
        }

        const timeRe = /^\d{1,2}:\d{2}$/;
        if (!config.scheduleFrom || !config.scheduleTo || !timeRe.test(config.scheduleFrom) || !timeRe.test(config.scheduleTo)) {
            const gui = window._uiCacheData && window._uiCacheData.gui;
            if (gui) gui.updateStatus('⚠️ Harmonogram: ustaw godziny OD i DO!', '#e67e22');
            return false;
        }

        const active = isWithinSchedule(config.scheduleFrom, config.scheduleTo);
        const gui = window._uiCacheData && window._uiCacheData.gui;

        if (!active) {
            if (typeof Engine !== 'undefined' && Engine.dead) {
                if (gui) gui.updateStatus('\u23F8 Poza harmonogramem (czekam na respawn...)', '#95a5a6');
                return true;
            }
            _lastScheduleActive = false;

            if (gui) {
                if (config.isRunning) {
                    const wakeUpTime = getNextWakeUpTime(config.scheduleFrom);
                    redirectToWaitingRoom('schedule', wakeUpTime, config.scheduleFrom, config.scheduleTo);
                } else {
                    gui.updateStatus('\u23F8 Poza harmonogramem', '#95a5a6');
                }
            }
            return true;
        }

        if (_lastScheduleActive !== true) {
            _lastScheduleActive = true;
            if (gui && !config.isRunning) _scheduleForceStart(gui);
        }
        return false;
    }

    // ══════════════════════════════════════════════════════════════
    //  BŁOGOSŁAWIEŃSTWO KLANU (Clan Blessing)
    // ══════════════════════════════════════════════════════════════
    let _clanBlessingCooldown = false;

    async function handleClanBlessing(config) {
        if (config.autoClanBlessing !== true) return false;
        if (!config.clanBlessingKey || config.clanBlessingKey === '') return false;
        if (_clanBlessingCooldown) return false;
        if (typeof Engine === 'undefined' || !Engine.hero || !Engine.hero.d) return false;

        if (!Engine.hero.d.clan || Engine.hero.d.clan === 0) return false;
        if (Engine.hero.d.is_blessed) return false;

        if (!Engine.map || !Engine.map.d) return false;
        const currentMapId = parseInt(Engine.map.d.id);
        const activeSetupName = config.activeSetup;
        const setupMaps = (activeSetupName && config.setups && config.setups[activeSetupName])
            ? config.setups[activeSetupName].map(m => parseInt(m.id || m))
            : [];
        if (setupMaps.length === 0 || !setupMaps.includes(currentMapId)) return false;

        const blessingSlot = parseInt(config.clanBlessingKey);
        if (isNaN(blessingSlot)) return false;

        _clanBlessingCooldown = true;

        try {
            if (window._uiCacheData.gui) {
                window._uiCacheData.gui.updateStatus(`🏰 Zakładanie błogo z klanu...`, '#8e44ad');
            }

            window._g(`clan&a=skills_use&name=blessing&opt=${blessingSlot}&ans=1`);

            setTimeout(() => {
                if (Engine.clan) Engine.clan.close();
                const alertBtn = document.querySelector('.mAlert .button, .mAlert .alert-accept-hotkey, .mAlert .close-button');
                if (alertBtn) alertBtn.click();
            }, 300);

            await delay(1500);
        } catch (e) {
        } finally {
            setTimeout(() => { _clanBlessingCooldown = false; }, 30 * 60 * 1000);
        }

        return true;
    }

    // ══════════════════════════════════════════════════════════════
    //  WPŁATA ZŁOTA DO KLANU (Clan Gold)
    // ══════════════════════════════════════════════════════════════
    let _clanGoldCooldown = false;

    async function handleClanGold(config) {
        if (!config.clanGoldEnabled) return false;
        if (_clanGoldCooldown) return false;
        if (typeof Engine === 'undefined' || !Engine.hero || !Engine.hero.d) return false;

        const amount  = parseInt(config.clanGoldAmount) || 0;
        const keepMin = parseInt(config.clanGoldKeep)   || 0;

        if (amount <= 0) return false;
        if (!Engine.hero.d.clan || Engine.hero.d.clan === 0) return false;

        const currentGold = Engine.hero.d.gold || 0;

        if (currentGold - amount < keepMin) {
            return false;
        }

        _clanGoldCooldown = true;

        try {
            if (window._uiCacheData.gui) {
                window._uiCacheData.gui.updateStatus(`💰 Wpłata ${amount} zł do klanu...`, '#f39c12');
            }

            const packet = `clan&a=save&f=gold&v=${amount}`;

            window._g(packet, () => {
                if (Engine.clan) Engine.clan.close();
                setTimeout(() => {
                    const alertBtn = document.querySelector('.mAlert .button, .mAlert .alert-accept-hotkey, .mAlert .close-button');
                    if (alertBtn) alertBtn.click();
                }, 200);
            });

            await delay(1000);
        } catch (e) {
        } finally {
            setTimeout(() => { _clanGoldCooldown = false; }, 10 * 60 * 1000);
        }

        return true;
    }

    // ══════════════════════════════════════════════════════════════
    //  SKRACAJ PO ŚMIERCI (Shorten on Death)
    // ══════════════════════════════════════════════════════════════
    let _shortenCooldown   = false;
    let _lastDeadState     = false;

    async function handleShortenOnDeath(config) {
        if (typeof Engine === 'undefined' || !Engine.hero) return false;

        const isDead = !!Engine.dead;

        if (!isDead) {
            _lastDeadState = false;
            _shortenCooldown = false;
            return false;
        }

        _lastDeadState = true;

        if (!config.shortenOnDeath) return false;

        if (_shortenCooldown) {
            if (window._uiCacheData.gui) {
                window._uiCacheData.gui.updateStatus('💀 Oczekiwanie na powrót / CD zwoju...', '#e74c3c');
            }
            return true;
        }

        const items = (typeof Engine.heroEquipment?.getHItems === 'function' ? Engine.heroEquipment.getHItems() : Engine.items?.check?.()) || {};
        let reviveItem = null;

        for (const key in items) {
            const item = items[key];
            if (!item) continue;

            const st = item.st ?? item.d?.st;
            if (st > 0 && st < 20) continue;

            const statStr = (item.stat || item.d?.stat || '').toLowerCase();
            const hasRevive = (typeof item.issetReviveStat === 'function' && item.issetReviveStat()) ||
                              (item.d && typeof item.d.issetReviveStat === 'function' && item.d.issetReviveStat()) ||
                              (item._cachedStats && item._cachedStats.revive) ||
                              statStr.includes('revive=');

            if (hasRevive) {
                reviveItem = item;
                break;
            }
        }

        if (!reviveItem) {
            if (window._uiCacheData.gui) {
                window._uiCacheData.gui.updateStatus('💀 Brak zwoju wskrzeszenia w torbie!', '#95a5a6');
            }
            return false;
        }

        const itemId   = reviveItem.id || reviveItem.d?.id;
        const itemName = reviveItem.name || reviveItem.getName?.() || reviveItem.d?.name || 'zwój';

        if (window._uiCacheData.gui) {
            window._uiCacheData.gui.updateStatus(`💀 Używam: ${itemName}...`, '#e74c3c');
        }

        _shortenCooldown = true;

        try {
            let used = false;
            if (typeof Engine.heroEquipment?.sendUseRequest === 'function') {
                Engine.heroEquipment.sendUseRequest(reviveItem);
                used = true;
            } else if (typeof reviveItem.createUseItem === 'function') {
                reviveItem.createUseItem();
                used = true;
            } else if (typeof reviveItem.d?.createUseItem === 'function') {
                reviveItem.d.createUseItem();
                used = true;
            } else if (itemId) {
                window._g('moveitem&st=1&id=' + itemId);
                used = true;
            }

            setTimeout(() => {
                const btn = document.querySelector('.mAlert .button, .mAlert .alert-accept-hotkey, .mAlert .close-button');
                if (btn) btn.click();
            }, 800);

            setTimeout(() => { _shortenCooldown = false; }, 6000);

        } catch (e) {
            setTimeout(() => { _shortenCooldown = false; }, 5000);
        }

        return true;
    }

    function isAutoBlessingAllowed(config) {
        return config.autoBlessingEnabled === true && !!config.autoBlessing && config.autoBlessing.trim() !== '';
    }

    // Dodajemy `redirectToWaitingRoom` do eksportu, żeby inne moduły (np. w przyszłości injected.js) mogły to też wywołać
    window._uiCacheData.options = {
        syncAutoF5,
        syncAntyDuszek,
        checkSchedule,
        handleClanBlessing,
        handleClanGold,
        handleShortenOnDeath,
        isWithinSchedule,
        isAutoBlessingAllowed,
        redirectToWaitingRoom,
    };

})();

